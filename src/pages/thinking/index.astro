---
import Arrow from '../../components/Arrow.astro';
import HomeLayout from '../../layouts/HomeLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StrategicMatrix from '../../components/StrategicMatrix.astro';
import Ledger from '../../components/Ledger.astro';
import FindFormation from '../../components/home/FindFormation.astro';
import { strategyIllusion } from '../../data/strategicMatrices';
const mapPath = '/thinking/strategic-decision-maps/strategy-illusion/';
const essayPath = 'https://thespottedape.com/posts/substack/2026-02-14-the-laboratory-fallacy.html';
---
<HomeLayout title="Strategic Thinking — Decision Maps & Essays | The Spotted Ape" description="Choices, assumptions and consequences. Explore a strategic decision map, an exercise in commitment and essays on human judgement.">
<PageIntro scale="short" description="Choices, assumptions and consequences.">
<Fragment slot="heading">Thinking.</Fragment>
</PageIntro>
<section class="thinking-feature section-y section-rule">
<div class="wrap">
<div class="split-layout">
<div class="thinking-copy">
<h2>{strategyIllusion.title}.</h2>
<p>{strategyIllusion.question}</p>
<p id={`${strategyIllusion.id}-note`}>{strategyIllusion.insight}</p>
<a class="text-link" href={mapPath}>Explore the map &amp; café story <Arrow />
</a>
</div>
<div class="thinking-preview" data-reveal>
<StrategicMatrix matrix={strategyIllusion} />
</div>
</div>
</div>
</section>
<FindFormation />
<section class="section-y">
<div class="wrap">
<h2 class="h2 essays-title">Essays.</h2>
<Ledger items={[{ name: 'The Laboratory Fallacy.', text: 'When a persuasive model meets the conditions of real work.', aside: 'Essay on thespottedape.com', href: essayPath, external: true }]} label="Essays" />
</div>
</section>
</HomeLayout>
<style>
.thinking-copy h2 {
  font-size: var(--heading-2);
  line-height: 1;
  max-width: 12ch;
}
@media (max-width: 767px) {
  .thinking-copy h2 {
    font-size: var(--compact-lg);
  }
}
.essays-title {
  margin-bottom: var(--space-sm);
}
</style>
