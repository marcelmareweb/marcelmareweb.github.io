---
import Arrow from '../../components/Arrow.astro';
import HomeLayout from '../../layouts/HomeLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StrategicMatrix from '../../components/StrategicMatrix.astro';
import Ledger from '../../components/Ledger.astro';
import FindFormation from '../../components/FindFormation.astro';
import { getCollection } from 'astro:content';
import { strategyIllusion } from '../../data/strategicMatrices';
const mapPath = '/thinking/strategic-decision-maps/strategy-illusion/';
const essayDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const essays = (await getCollection('insights'))
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
  .map(({ data }) => ({
    name: /[.?!…]$/.test(data.title) ? data.title : `${data.title}.`,
    text: data.excerpt,
    aside: `${essayDate.format(new Date(data.pubDate))} · ${data.readingTime}`,
    href: data.substackUrl,
    external: true,
  }));
---
<HomeLayout title="Tools & Essays — Notes from the Work | The Spotted Ape" description="Maps, exercises and essays from The Spotted Ape's practice, shared freely. Take what's useful, and pass it on.">
<PageIntro scale="default" description="Maps, exercises and essays from our practice, shared freely. Take what’s useful, and pass it on.">
<Fragment slot="heading">Notes from<br />the work.</Fragment>
</PageIntro>
<section class="thinking-feature section-y section-rule">
<div class="wrap">
<div class="split-layout">
<div class="thinking-copy">
<h2>{strategyIllusion.title}.</h2>
<p>{strategyIllusion.question}</p>
<p id={`${strategyIllusion.id}-note`}>{strategyIllusion.insight}</p>
<a class="text-link" href={mapPath}>Explore the map &amp; café story <Arrow />
</a>
</div>
<div class="thinking-preview" data-reveal>
<StrategicMatrix matrix={strategyIllusion} />
</div>
</div>
</div>
</section>
<FindFormation />
<section class="section-y">
<div class="wrap">
<h2 class="h2 essays-title">Essays.</h2>
<Ledger items={essays} label="Essays" />
</div>
</section>
</HomeLayout>
<style>
.thinking-copy h2 {
  font-size: var(--heading-2);
  line-height: 1;
  max-width: 12ch;
}
@media (max-width: 767px) {
  .thinking-copy h2 {
    font-size: var(--compact-lg);
  }
}
.essays-title {
  margin-bottom: var(--space-sm);
}
</style>
