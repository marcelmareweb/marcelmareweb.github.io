---
import HomeLayout from '../../layouts/HomeLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StrategicMatrix from '../../components/StrategicMatrix.astro';
import { strategyIllusion } from '../../data/strategicMatrices';
const mapPath = '/thinking/strategic-decision-maps/strategy-illusion/';
const essayPath = 'https://thespottedape.com/posts/substack/2026-02-14-the-laboratory-fallacy.html';
---
<HomeLayout title="Strategic Thinking — Decision Maps & Essays | The Spotted Ape" description="Choices, assumptions and consequences. Explore strategic decision maps and essays on human judgement.">
<PageIntro compact eyebrow="Thinking / Maps & essays" scale="short" description="Choices, assumptions and consequences.">
<Fragment slot="heading">Thinking.</Fragment>
</PageIntro>
<section class="thinking-feature section-y theme-grey">
<div class="wrap">
<div class="section-top meta">
<p>01 / Strategic decision map</p>
<p>An instrument for the conversation</p>
</div>
<div class="split-layout">
<div class="thinking-copy">
<h2>{strategyIllusion.title}.</h2>
<p>{strategyIllusion.question}</p>
<p id={`${strategyIllusion.id}-note`}>{strategyIllusion.insight}</p>
<a class="text-link" href={mapPath}>Explore the map &amp; café story <span aria-hidden="true">↗</span>
</a>
</div>
<div class="thinking-preview" data-reveal>
<StrategicMatrix matrix={strategyIllusion} compact />
</div>
</div>
</div>
</section>
<section class="section-y">
<div class="wrap">
<div class="section-top meta">
<p>02 / Essays</p>
<p>Thinking in the conditions of real work</p>
</div>
<a class="thinking-essay" href={essayPath}>
<span class="meta">Essay / External</span>
<div>
<h2>The Laboratory Fallacy.</h2>
<p>When a persuasive model meets the conditions of real work.</p>
</div>
<span aria-hidden="true">↗</span>
</a>
</div>
</section>
</HomeLayout>
<style>
.thinking-copy h2 {
  font-size: var(--heading-2);
  line-height: 1;
  max-width: 12ch;
}
.thinking-feature .thinking-preview {
  background: #fff;
}
.thinking-essay {
  display: grid;
  grid-template-columns: 1fr 2fr 60px;
  gap: 40px;
  border-block: 1px solid var(--line);
  padding-block: 48px;
  text-decoration: none;
}
.thinking-essay h2 {
  font-size: var(--heading-3);
}
.thinking-essay p {
  font-size: var(--body-large);
  line-height: 1.35;
  margin-top: 24px;
  max-width: 35ch;
}
.thinking-essay > span:last-child {
  font-size: 56px;
  line-height: 1;
}
@media (max-width: 767px) {
  .thinking-copy h2 {
    font-size: 48px;
  }
  .thinking-essay {
    grid-template-columns: 1fr 32px;
    gap: 24px;
  }
  .thinking-essay > .meta {
    grid-column: 1/-1;
  }
  .thinking-essay h2 {
    font-size: 36px;
  }
  .thinking-essay > span:last-child {
    font-size: 32px;
  }
}
</style>
