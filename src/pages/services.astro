---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import DecisionRecord from '../components/DecisionRecord.astro';
import PageIntro from '../components/PageIntro.astro';
import { services } from '../data/practice';
import { contactHref } from '../lib/contact';
---
<BaseLayout title="How we help | The Spotted Ape" description="Strategic Decision Design, Behavioural Design and Human–AI Decision Design. Start with the question your organisation needs to resolve.">
  <PageIntro description="One decision, three questions: where to go, what enables people to act, and where human judgement stays accountable.">
    <Fragment slot="heading">Start with<br />the decision.</Fragment>
  </PageIntro>
  <section class="section-y section-rule sprint" id="sprint" aria-labelledby="sprint-title">
    <div class="wrap split-layout">
      <div>
        <p class="meta">Pilot offer · Strategic Choices Sprint</p>
        <h2 class="h2" id="sprint-title">One decision.<br />Properly made.</h2>
        <p class="sprint-lead">For a leadership team facing a choice that another planning meeting won’t settle. You leave with the choice, the reasons for it, and what happens next.</p>
        <div class="actions"><a class="button" href={contactHref({ interest: 'strategic-decision', source: '/services/' })}>Discuss a Sprint <Arrow /></a><a class="text-link" href="/decision-record/">See a sample decision record <Arrow /></a></div>
      </div>
      <div>
        <DecisionRecord label="What the Sprint includes" fields={[
          { label: 'Start', value: 'A 60-minute conversation with the person who owns the decision.' },
          { label: 'Listen', value: 'Up to six interviews with the people the decision affects.' },
          { label: 'Read', value: 'Up to five documents that bear on the choice.' },
          { label: 'Decide', value: 'One facilitated decision workshop with the leadership team.' },
          { label: 'Keep', value: 'A concise decision record and the agreed follow-through.' },
          { label: 'Review', value: 'One follow-up conversation to check the decision is holding.' },
        ]} />
        <p class="sprint-note">Pilot scope. Format and fees are agreed with each client.</p>
      </div>
    </div>
  </section>
  <span id="situations" aria-hidden="true"></span>
  {services.map((service, index) => (
    <section class:list={['service-section section-y', { 'theme-dark': index === 1 }]} id={service.id}>
      <div class="wrap">
        <div class="service-heading"><div><h2>{service.problem.split(/(?<=\.) /).map((part, i) => <>{i > 0 && <br />}{part}</>)}</h2><p class="service-name">{service.title}</p></div><img src={'/images/practice/' + ['decision', 'behaviour', 'human-ai'][index] + '.svg'} width="240" height="240" alt="" aria-hidden="true" loading="lazy" /></div>
        <div class="split-layout service-content">
          <div><p class="service-question">{service.question}</p><p class="service-description">{service.description}</p><a class:list={['button', { 'button--yellow': index === 1 }]} href={contactHref({ interest: service.interest, source: '/services/' })}>{index === 0 ? 'Discuss a strategic decision' : index === 1 ? 'Discuss a behavioural question' : 'Discuss decision authority'} <Arrow /></a></div>
          <dl class="record" aria-label={`${service.title.replace(/\.$/, '')}: the work`}>
            <div class="record-row"><dt>What you leave with</dt><dd><strong>{service.output}</strong></dd></div>
            <div class="record-row"><dt>Evidence</dt><dd><a class="text-link" href={service.evidence.href}>{service.evidence.label} <Arrow /></a><span class="evidence-note">{service.evidence.note}</span></dd></div>
          </dl>
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
<style>
  .sprint-lead { max-width: 44ch; margin-top: 24px; font-size: var(--body-large); line-height: 1.35; letter-spacing: var(--tracking-copy-large); }
  .sprint .meta { margin-bottom: 16px; }
  .sprint .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; margin-top: 36px; }
  .sprint .actions .button { margin-top: 0; }
  .sprint-note { margin-top: 16px; font: var(--font-label); color: var(--text-muted); }
  .service-section { scroll-margin-top: calc(var(--header-height) + 24px); }
  .service-heading { display: flex; justify-content: space-between; align-items: center; gap: 40px; }
  .service-heading h2 { max-width: 18ch; font-size: var(--heading-2); line-height: 1.02; }
  .service-name { margin-top: 16px; font-size: var(--body-large); font-weight: var(--weight-display); line-height: var(--leading-snug); letter-spacing: var(--tracking-copy-large); color: var(--text-muted); }
  .service-heading img { width: 160px; height: 160px; flex-shrink: 0; object-fit: contain; }
  .service-content { margin-top: 48px; }
  .service-question { max-width: 24ch; font-size: var(--heading-4); line-height: 1.16; letter-spacing: var(--tracking-heading); font-weight: 600; }
  .service-description { font-size: var(--body); line-height: var(--leading-body); max-width: 47ch; margin-top: 28px; }
  .button { margin-top: 36px; }
  .record .text-link { min-height: 44px; }
  .evidence-note { display: block; margin-top: 4px; font: var(--font-label); color: var(--text-muted); }
  @media (max-width: 767px) {
    .service-heading { align-items: start; gap: 20px; }
    .service-heading h2 { font-size: var(--compact-md); max-width: 12ch; }
    .service-heading img { width: 72px; height: 72px; }
    .service-question { font-size: 30px; }
    .service-description { font-size: var(--body); }
    .button { gap: 20px; padding-inline: 22px; }
  }
  @media (max-width: 375px) { .service-heading { gap: 12px; } .service-heading img { width: 52px; height: 52px; } }
</style>
