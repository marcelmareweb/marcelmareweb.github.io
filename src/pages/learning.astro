---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import PageIntro from '../components/PageIntro.astro';
import { getCollection } from 'astro:content';
import { contactHref } from '../lib/contact';

const creative = (await getCollection('cases')).flatMap(({ data }) => (data.format === 'five-part' && data.slug === 'creative-x-ai-workshop' ? [data] : []))[0];

const steps = [
  { title: 'Start with something real.', text: 'A choice, a case or a practice that matters to the people in the room.' },
  { title: 'Try it.', text: 'Build the model, bake the bread, put the tool to work. Understanding comes from doing.' },
  { title: 'Look at what happened.', text: 'Compare results, test assumptions and name what changed your mind.' },
  { title: 'Do it again without us.', text: 'The next time is real, and we won’t be in the room.' },
];
---
<BaseLayout title="Workshops & Learning | The Spotted Ape" description="Less watching, more doing: live workshops and self-paced courses where people work through real problems, test ideas and practise what they need to do differently.">
  <PageIntro description="Workshops and courses where people work through real problems, test ideas and practise what they need to do differently.">
    <Fragment slot="heading">Less watching.<br />More doing.</Fragment>
  </PageIntro>

  <section class="section-y section-rule" id="formats" aria-labelledby="formats-title">
    <div class="wrap">
      <h2 class="sr-only" id="formats-title">Formats</h2>
      <ul class="formats card-grid card-grid--swipe" role="list">
        <li>
          <Card layout="media" href="/workshops" title="Live workshops." text="Facilitated sessions built around a consequential question and practical exercises." kind="For teams" cue="Explore." index={0}>
            <img slot="media" class="format-photo" src="/images/research/bakery-workshop.jpg" width="1058" height="793" decoding="async" alt="" />
          </Card>
        </li>
        <li>
          <Card layout="media" href="/workshops/strategic-design-leadership/" title="The executive masterclass." text="Strategic Design Leadership in the Age of AI: five standalone days, one strategic decision each." kind="For executives" cue="Explore." index={1}>
            <div slot="media" class="type-media" aria-hidden="true"><p>Five days. Five strategic decisions.</p></div>
          </Card>
        </li>
        <li>
          <Card layout="media" href="/courses" title="Digital courses." text="Self-paced cases and simulations, with real figures and no real losses." kind="Self-paced" cue="Explore." index={2}>
            <div slot="media" class="type-media" aria-hidden="true"><p>Make the expensive mistake somewhere cheap.</p></div>
          </Card>
        </li>
      </ul>
      <div class="in-development" id="series">
        <p class="meta">In development</p>
        <p>A strategy learning series is being developed with Raykis as a possible partner channel. The commercial arrangement is not yet agreed. Marcel Maré designs the curriculum, facilitates the live sessions and teaches. In the planned self-paced courses a digital avatar presents; the substance is the case, the choices, the feedback and the reflection.</p>
      </div>
    </div>
  </section>

  <section class="section-y section-rule" id="examples" aria-labelledby="examples-title">
    <div class="wrap">
      <h2 class="h2" id="examples-title">Three ways<br />it has worked.</h2>
      <ul class="examples card-grid card-grid--swipe" role="list">
        <li>
          <Card layout="media" href="/work/#solar" title="Should We Invest in Solar?" text="Compare three proposals, test the assumptions in a spreadsheet and defend a qualified recommendation." kind="Educational simulation" cue="Read." index={0}>
            <img slot="media" class="format-photo" src="/images/courses/solar-cape-manufacturing.jpg" width="1400" height="788" loading="lazy" decoding="async" alt="" />
          </Card>
        </li>
        {creative && (
          <li>
            <Card layout="media" href={`/cases/${creative.slug}`} title={creative.title} text="Emerging creatives used AI on their own terms: identity first, then structured experiments, then work they could show." kind="Workshop" cue="Read." index={1}>
              {creative.image ? <img slot="media" class:list={['format-photo', !creative.image.portrait && 'format-photo--contain']} src={(creative.image.portrait ?? creative.image).src} width={(creative.image.portrait ?? creative.image).width} height={(creative.image.portrait ?? creative.image).height} loading="lazy" decoding="async" alt="" /> : <div slot="media" class="type-media type-media--ink" aria-hidden="true"><p>{creative.question}</p></div>}
            </Card>
          </li>
        )}
        <li>
          <Card layout="media" href="/work/#research" title="Baking as research." text="Workshops in a community bakery made clean cooking something to do, smell and share." kind="Participatory research" cue="Read." index={2}>
            <img slot="media" class="format-photo format-photo--right" src="/images/research/pilot-baking-scones.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="" />
          </Card>
        </li>
      </ul>
    </div>
  </section>

  <section class="section-y section-rule" id="approach" aria-labelledby="approach-title">
    <div class="wrap split-layout">
      <h2 class="h2" id="approach-title">Practise here.<br />Then do it<br />for real.</h2>
      <ol class="steps" role="list">
        {steps.map((step, index) => (
          <li><span class="step-num">{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-y section-rule"><div class="wrap split-layout"><h2 class="h2">What should<br />your team practise?</h2><div><p class="lead">Tell us what people need to do differently. The format follows from it.</p><div class="actions"><a class="button" href={contactHref({ interest: 'workshop', audience: 'team', source: '/learning/' })}>Discuss team learning <Arrow /></a></div></div></div></section>
</BaseLayout>
<style>
  .steps { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .steps li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--grid-gap); padding-block: 20px; }
  .step-num { font: var(--font-label); font-variant-numeric: tabular-nums; color: var(--muted); padding-top: 6px; }
  .steps h3 { font-size: var(--heading-4); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
  .steps p { margin-top: 8px; max-width: 44ch; font-size: var(--body); line-height: var(--leading-copy); color: var(--muted); }

  .in-development { display: grid; grid-template-columns: minmax(7rem, 2fr) minmax(0, 10fr); gap: 8px var(--grid-gap); margin-top: var(--space-md); padding-top: 16px; border-top: 1px solid var(--ink); }
  .in-development p:last-child { max-width: 65ch; font-size: var(--body); line-height: var(--leading-copy); }

  .examples { margin-top: var(--space-sm); }
  .format-photo { display: block; width: 100%; height: 100%; object-fit: cover; }
  .format-photo--right { object-position: 78% center; }
  .format-photo--contain { object-fit: contain; background: var(--ink); }
  .type-media { display: flex; align-items: flex-end; height: 100%; padding: 24px; background: var(--surface); }
  .type-media--ink { background: var(--ink); color: var(--paper); }
  .type-media p { margin: 0; font-size: clamp(26px, 2.2vw, 40px); font-weight: 600; line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); text-wrap: balance; }

  .actions .button { margin-top: 0; }

  @media (max-width: 767px) {
    .in-development { grid-template-columns: 1fr; }
  }
</style>
