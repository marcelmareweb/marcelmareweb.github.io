---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LearningOptions from '../components/LearningOptions.astro';
import { contactHref } from '../lib/contact';
---
<BaseLayout title="Workshops & Learning | The Spotted Ape" description="Compare custom decision workshops, five executive working days and a self-paced solar investment case. Find a format for your question or start learning now.">
  <PageIntro description="Work through a difficult decision together. Or build the judgement to make the next one.">
    <Fragment slot="heading">Learn by<br />deciding.</Fragment>
  </PageIntro>
  <section class="learning-formats wrap" id="formats" aria-labelledby="formats-title"><h2 class="sr-only" id="formats-title">Workshop and learning formats</h2><LearningOptions /></section>
  <section class="section-y section-rule"><div class="wrap split-layout"><h2 class="h2">Bring the<br />decision.</h2><div><p class="lead">Start with the question your team needs to examine. The format follows from it.</p><div class="actions"><a class="button" href={contactHref({ interest: 'workshop', audience: 'team', source: '/learning/' })}>Discuss team learning <Arrow /></a></div><p class="learning-detail">Considering the executive programme for yourself? <a href={contactHref({ interest: 'masterclass', audience: 'individual', source: '/learning/' })}>Ask about attendance <span class="nowrap">options <Arrow /></span></a>.</p></div></div></section>
</BaseLayout>
<style>
  .learning-formats { padding-bottom: var(--space-lg); }
  .learning-detail { margin-top: 24px; font-size: var(--body); line-height: var(--leading-copy); max-width: 47ch; }
  .button { margin-top: 28px; }
  .actions .button { margin-top: 0; }
</style>
