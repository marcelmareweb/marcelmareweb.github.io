---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LearningOptions from '../components/LearningOptions.astro';
import { contactHref } from '../lib/contact';
---
<BaseLayout title="Workshops & Learning | The Spotted Ape" description="Compare custom decision workshops, five executive working days and a self-paced solar investment case. Find a format for your question or start learning now.">
  <PageIntro description="Work on a live decision. Or develop the judgement to make the next one.">
    <Fragment slot="heading">Learn by<br />deciding.</Fragment>
  </PageIntro>
  <section class="learning-formats wrap" id="formats" aria-labelledby="formats-title"><h2 class="sr-only" id="formats-title">Workshop and learning formats</h2><LearningOptions /></section>
  <section class="section-y section-rule"><div class="wrap split-layout"><div><p class="meta">Working with a team</p><h2 class="h2">Bring the<br />decision.</h2></div><div><p class="lead">Discuss a custom working session, an executive day or a facilitated learning case around the question your team needs to examine.</p><div class="actions"><a class="button" href={contactHref({ interest: 'workshop', audience: 'team', source: '/learning/' })}>Discuss team learning <Arrow /></a><a class="text-link" href="/services/">Explore how we help <Arrow /></a></div><p class="learning-detail">Considering the executive programme for yourself? <a href={contactHref({ interest: 'masterclass', audience: 'individual', source: '/learning/' })}>Ask about attendance <span class="nowrap">options <Arrow /></span></a>.</p></div></div></section>
</BaseLayout>
<style>
  .learning-formats { padding-bottom: var(--space-lg); }
  .h2 { margin-top: 24px; }
  .learning-detail { margin-top: 24px; font-size: var(--body); line-height: 1.5; max-width: 47ch; }
  .button { margin-top: 28px; }
  .actions .button { margin-top: 0; }
</style>
