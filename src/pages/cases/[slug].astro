---
import Arrow from '../../components/Arrow.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { contactHref } from '../../lib/contact';

interface Props {
  caseStudy: CollectionEntry<'cases'>;
}

export async function getStaticPaths() {
  const cases = await getCollection('cases');

  return cases.map((caseStudy) => ({
    params: { slug: caseStudy.data.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { data } = caseStudy;
const canonicalURL = new URL(`/cases/${data.slug}`, Astro.site ?? 'https://marcelmareweb.github.io');
---
<BaseLayout title={`${data.title} | The Spotted Ape`} description={data.clientContext} canonicalURL={canonicalURL} schemaType="Article">
<PageIntro scale="sentence" description={data.clientContext}>
<Fragment slot="heading">{data.title}</Fragment>
<nav class="page-nav print-action" aria-label="Case actions">
<button class="text-link" type="button" data-print-brief>Print / Save as PDF <Arrow /></button>
</nav>
</PageIntro>
<article class="case-brief wrap">
<dl class="record" aria-label="The case as a decision record">
<div class="record-row"><dt>Decision focus</dt><dd><strong>The report’s argument.</strong></dd></div>
<div class="record-row"><dt>The pattern</dt><dd>{data.pattern}</dd></div>
<div class="record-row"><dt>The intervention</dt><dd>{data.intervention}</dd></div>
<div class="record-row"><dt>The shift</dt><dd>{data.shift}</dd></div>
<div class="record-row"><dt>Reported outcome</dt><dd><strong class="case-result">{data.result}</strong></dd></div>
</dl>
<blockquote class="case-quote"><p>“{data.quote}”</p></blockquote>
<p class="case-caption">An account of this engagement. The reported result does not establish a typical or guaranteed outcome. The Spotted Ape (Pty) Ltd, Cape Town, South Africa.</p>
</article>
<section class="case-invitation section-y section-rule"><div class="wrap split-layout"><h2 class="h2">A decision<br />of your own?</h2><div><p class="lead">Explore strategic decision support, or bring the question you need to resolve.</p><div class="actions"><a class="button" href={contactHref({ interest: 'strategic-decision', source: '/cases/' + data.slug })}>Discuss a similar decision <Arrow /></a><a class="text-link" href="/services/#strategic-decision-design">Strategic Decision Design <Arrow /></a></div></div></div></section>
</BaseLayout>
<script>
document.querySelector('[data-print-brief]')?.addEventListener('click', () => window.print());
</script>
<style>
@media print { .case-invitation { display: none !important; } .case-brief { break-inside: auto; } .case-brief .record-row { break-inside: avoid; } }
.case-brief {
  padding-bottom: var(--space-lg);
}
.case-brief .record {
  max-width: 1100px;
}
.case-result {
  font-size: var(--heading-4);
  line-height: var(--leading-heading);
  letter-spacing: var(--tracking-heading);
}
.case-quote {
  max-width: 22ch;
  margin-top: var(--space-md);
  font-size: var(--heading-3);
  font-weight: 600;
  line-height: 1.04;
  letter-spacing: var(--tracking-heading);
  text-wrap: balance;
}
.case-caption {
  max-width: 62ch;
  margin-top: 32px;
  font: var(--font-label);
  color: var(--muted);
}
@media (max-width: 767px) {
  .case-result {
    font-size: var(--compact-sm);
  }
  .case-quote {
    font-size: 36px;
  }
}
</style>
