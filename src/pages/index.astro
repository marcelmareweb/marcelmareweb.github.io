---
import HomeLayout from '../layouts/HomeLayout.astro';
import Arrow from '../components/Arrow.astro';
import Ledger from '../components/Ledger.astro';
import FindFormation from '../components/home/FindFormation.astro';
import WorkStrip from '../components/home/WorkStrip.astro';
import { services, learningOptions, publicResources } from '../data/practice';
import { strategyIllusion } from '../data/strategicMatrices';

// The example decision comes from the fictional organisation used in Find Formation.
const alternatives = [
  { label: 'Enter another market', tradeOff: 'Choosing growth elsewhere. Setting aside deeper work with current customers.' },
  { label: 'Deepen customer relationships', tradeOff: 'Choosing depth with current customers. Setting aside a new market for now.' },
  { label: 'Continue as we are', tradeOff: 'Choosing stability. Setting aside both new commitments until the next review.' },
];
const chosen = 1;

const offerings = [
  ...services.map(service => ({ name: service.title, text: service.question, aside: service.output, href: `/services/#${service.id}` })),
  { name: 'Decision workshops.', text: 'Bring competing perspectives into the same conversation.', aside: learningOptions[0].output, href: learningOptions[0].href },
  { name: 'Executive masterclass.', text: 'Five strategic questions, from what success means to how decisions are governed.', aside: learningOptions[1].output, href: learningOptions[1].href },
  { name: 'Self-paced learning.', text: 'Compare three proposals, question the assumptions and defend a recommendation.', aside: learningOptions[2].output, href: learningOptions[2].href },
];

const thinking = [
  { name: 'The Laboratory Fallacy.', text: 'When a persuasive model meets the conditions of real work.', aside: 'Essay', href: publicResources.essay, external: true },
  { name: `${strategyIllusion.title}.`, text: strategyIllusion.question, aside: 'Strategic decision map', href: '/thinking/strategic-decision-maps/strategy-illusion/' },
];
---
<HomeLayout title="The Spotted Ape — Strategic Decisions & Behavioural Design" description="We help leaders make consequential choices when familiar assumptions no longer hold. Independent strategic decision and behavioural design practice, Cape Town.">
<section class="home-intro" id="idea">
<div class="wrap">
<h1>
<span>More <span class="hero-break">possibilities.</span></span>
<span>Harder choices.</span>
</h1>
<div class="hero-body">
<div class="hero-copy">
<p class="hero-explanation">We help leaders make consequential choices when familiar assumptions no longer hold.</p>
<a class="text-link" href="/services/">How we help <Arrow /></a>
</div>
<div class="hero-record" id="instrument">
<dl class="record record--panel" id="decision-record" aria-label="An example decision record">
<div class="record-row"><dt>Question</dt><dd><strong>What needs to be decided?</strong></dd></div>
<div class="record-row"><dt>Alternatives</dt><dd>
<div class="choice-group" role="group" aria-label="Choose one alternative" data-record-choices>
{alternatives.map((alt, index) => <button class="choice" type="button" aria-pressed={index === chosen ? 'true' : 'false'} data-trade-off={alt.tradeOff}>{alt.label}</button>)}
</div>
</dd></div>
<div class="record-row"><dt>Trade-offs</dt><dd aria-live="polite" data-record-trade-off>{alternatives[chosen].tradeOff}</dd></div>
<div class="record-row"><dt>Assumptions</dt><dd>What would have to be true? What evidence could change our view?</dd></div>
<div class="record-row"><dt>Owner and review</dt><dd>Who decides, and who acts? When will we revisit the choice and its consequences?</dd></div>
</dl>
<p class="record-note">An example from the fictional organisation in Find Formation. Nothing you choose is saved or sent.</p>
</div>
</div>
</div>
</section>

<section class="section-y home-offerings" id="practice" aria-labelledby="offerings-title">
<span id="work" aria-hidden="true"></span><span id="learning" aria-hidden="true"></span>
<div class="wrap">
<h2 class="section-title" id="offerings-title">Decide.<br />Make it happen.</h2>
<div class="home-ledger">
<Ledger items={offerings} numbered size="large" heads={['Area', 'The question', 'What you leave with']} label="Areas of practice and ways to learn" />
</div>
</div>
</section>

<WorkStrip />

<FindFormation />

<section class="section-y" id="thinking" aria-labelledby="thinking-title">
<div class="wrap">
<div class="thinking-head">
<h2 class="section-title" id="thinking-title">Make the reasoning visible.</h2>
<a class="text-link" href="/thinking/">All thinking <Arrow /></a>
</div>
<div class="home-ledger">
<Ledger items={thinking} label="Thinking and instruments" />
</div>
</div>
</section>

<section class="home-invitation section-y section-rule" id="engagement" aria-labelledby="invitation-title">
<span id="book" aria-hidden="true"></span>
<div class="wrap">
<h2 class="invitation-title" id="invitation-title">What needs deciding?</h2>
<div class="invitation-bottom">
<p class="lead">Bring the alternatives, the assumptions and the difficult questions.</p>
<a class="button button--talk" href="/contact/?source=%2F">Let’s talk</a>
</div>
</div>
</section>
</HomeLayout>
<script>
  // Decision record: one alternative is chosen at a time; the trade-off follows it.
  document.querySelectorAll<HTMLElement>('[data-record-choices]').forEach((group) => {
    const tradeOff = group.closest('dl')?.querySelector<HTMLElement>('[data-record-trade-off]');
    const choices = [...group.querySelectorAll<HTMLButtonElement>('.choice')];
    choices.forEach((choice) =>
      choice.addEventListener('click', () => {
        choices.forEach((other) => other.setAttribute('aria-pressed', String(other === choice)));
        if (tradeOff) tradeOff.textContent = choice.dataset.tradeOff ?? '';
      }),
    );
  });
</script>
<style>
.home-intro {
  padding-block: var(--space-md) var(--space-lg);
}
.home-intro h1 {
  font-size: min(12.6vw, 15.5rem);
  line-height: 0.86;
  letter-spacing: var(--tracking-display);
  text-indent: -0.04em;
}
.home-intro h1 > span {
  display: block;
}
.hero-body {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--grid-gap);
  align-items: start;
  margin-top: var(--space-md);
}
.hero-copy {
  grid-column: 1 / 5;
  display: grid;
  gap: 32px;
  justify-items: start;
}
.hero-explanation {
  font-size: var(--heading-4);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.045em;
  text-wrap: balance;
}
.hero-record {
  grid-column: 6 / -1;
}
.hero-record .record-row > dt {
  padding-top: 2px;
}
.record-note {
  margin-top: 12px;
  font: 500 var(--text-small)/1.4 var(--narrow);
  color: var(--muted);
}
.text-link :global(.arrow) {
  font-size: 18px;
}
.home-ledger {
  margin-top: var(--space-sm);
}
.thinking-head {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 32px;
}
.thinking-head .section-title {
  max-width: 11ch;
}
.invitation-title {
  font-size: var(--display-xl);
  line-height: 0.86;
  max-width: 7ch;
}
.invitation-bottom {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin-top: var(--space-md);
}
.invitation-bottom .button {
  min-width: 200px;
}

@media (max-width: 1023px) {
  .hero-copy,
  .hero-record {
    grid-column: 1 / -1;
  }
  .hero-explanation {
    font-size: 34px;
    max-width: 24ch;
  }
  .hero-record {
    margin-top: 16px;
  }
  .invitation-title {
    font-size: clamp(80px, 15vw, 150px);
  }
}
@media (max-width: 767px) {
  .home-intro {
    padding-block: 32px 64px;
  }
  .home-intro h1 {
    font-size: 14.4vw;
    line-height: var(--leading-display);
  }
  .hero-break {
    display: block;
  }
  .hero-body {
    margin-top: 32px;
  }
  .hero-copy {
    gap: 20px;
  }
  .hero-explanation {
    font-size: var(--body-large);
  }
  .hero-record {
    margin-top: 8px;
  }
  .thinking-head {
    flex-direction: column;
    align-items: start;
    gap: 20px;
  }
  .invitation-title {
    font-size: clamp(64px, 18vw, 100px);
  }
  .invitation-bottom {
    flex-direction: column;
    align-items: start;
    gap: 32px;
  }
}
</style>
