---
import HomeLayout from '../layouts/HomeLayout.astro';
import Arrow from '../components/Arrow.astro';
import FindFormation from '../components/home/FindFormation.astro';
import WorkStrip from '../components/home/WorkStrip.astro';
import ServiceIndex from '../components/home/ServiceIndex.astro';
import { publicResources } from '../data/practice';
---
<HomeLayout title="The Spotted Ape — Strategic Decisions & Behavioural Design" description="We help leaders make consequential choices when familiar assumptions no longer hold. Independent strategic decision and behavioural design practice, Cape Town.">
<section class="home-intro" id="idea">
<div class="wrap">
<h1>
<span>More <span class="hero-break">possibilities.</span></span>
<span class="hero-choice">Harder choices.</span>
</h1>
<div class="hero-bottom">
<p class="hero-explanation">We help leaders make consequential choices when familiar assumptions no longer hold.</p>
<div class="actions">
<a class="button" href="/services/">Explore how we can help</a>
<a class="text-link" href="#choice">Find your formation. <Arrow direction="down" /></a>
</div>
</div>
</div>
<figure class="hero-band" aria-labelledby="hero-band-caption">
<picture>
<source media="(max-width: 640px)" srcset="/images/judgement-factory/mobile.webp" width="1345" height="1169" />
<img src="/images/judgement-factory/desktop.webp" width="1983" height="793" decoding="async"
  alt="A hand-drawn miniature banana-bread factory: whole yellow bananas climb to a peeler, a pulley drives a mixer and an oven bakes the loaf. Tiny monkey workers supervise. At the end, an inspector holds the loaf before releasing it." />
</picture>
<figcaption class="wrap" id="hero-band-caption">
<span class="band-title">The machine works. The monkey decides.</span>
<span class="band-note">Machines handle repetition. The inspector owns the final release.</span>
</figcaption>
</figure>
</section>

<WorkStrip />

<ServiceIndex />

<FindFormation />

<section class="section-y" id="thinking" aria-labelledby="thinking-title">
<span id="instrument" aria-hidden="true"></span>
<div class="wrap">
<div class="thinking-row">
<div>
<h2 class="section-title" id="thinking-title" data-reveal>Make the reasoning visible.</h2>
<a class="text-link" href="/thinking/">Explore all thinking. <Arrow /></a>
</div>
<details class="decision-record" id="decision-record">
<summary>Open an example decision record</summary>
<dl>
<dt>Question</dt>
<dd>What needs to be decided?</dd>
<dt>Alternatives</dt>
<dd>Which options deserve comparison, including continuing as we are?</dd>
<dt>Assumptions</dt>
<dd>What would have to be true? What evidence could change our view?</dd>
<dt>Trade-offs</dt>
<dd>What are we choosing or setting aside?</dd>
<dt>Owner</dt>
<dd>Who decides, and who acts?</dd>
<dt>Review</dt>
<dd>When will we revisit the choice and its consequences?</dd>
</dl>
</details>
</div>
<a class="essay-row" href={publicResources.essay}>
<h3>The Laboratory Fallacy.</h3>
<p>When a persuasive model meets the conditions of real work.</p>
<span class="essay-kind">Essay</span>
<Arrow class="essay-arrow" />
</a>
</div>
</section>

<section class="home-invitation section-y" id="engagement" aria-labelledby="invitation-title">
<span id="book" aria-hidden="true"></span>
<div class="wrap">
<h2 class="invitation-title" id="invitation-title">What needs deciding?</h2>
<div class="invitation-bottom">
<p class="lead">Bring the alternatives, the assumptions and the difficult questions.</p>
<a class="button button--talk button--yellow" href="/contact/?source=%2F">Let’s talk</a>
</div>
</div>
</section>
</HomeLayout>
<style>
.home-intro {
  padding-block: var(--space-md) 0;
}
.home-intro h1 {
  font-size: min(12.6vw, 15.5rem);
  line-height: 0.86;
  letter-spacing: -0.05em;
  text-indent: -0.04em;
}
.home-intro h1 > span {
  display: block;
}
.hero-choice:after {
  content: '';
  display: block;
  width: 23%;
  height: 0.06em;
  max-height: 14px;
  background: var(--signal);
  margin-top: 0.12em;
  transform-origin: left;
  animation: hero-mark 1.1s var(--out) 0.25s both;
}
@keyframes hero-mark {
  from { transform: scaleX(0); }
}
.hero-bottom {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--grid-gap);
  align-items: end;
  margin-top: var(--space-md);
}
.hero-explanation {
  grid-column: 1 / 7;
  font-size: var(--heading-4);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.045em;
  max-width: 24ch;
  text-wrap: balance;
}
.hero-bottom .actions {
  grid-column: 8 / -1;
  justify-content: end;
  margin: 0;
}
.text-link :global(.arrow) {
  font-size: 18px;
}
.hero-band {
  margin-top: var(--space-lg);
}
.hero-band picture {
  display: block;
  width: min(100%, 2200px);
  margin-inline: auto;
  padding-inline: clamp(8px, 2vw, 40px);
}
.hero-band img {
  display: block;
  width: 100%;
}
.hero-band figcaption {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24px;
  padding-block: 32px var(--space-sm);
  border-bottom: 1px solid var(--line);
}
.band-title {
  font-size: var(--body-large);
  font-weight: 600;
  letter-spacing: -0.03em;
}
.band-note {
  font-size: 16px;
  color: var(--muted);
}

.thinking-row {
  display: grid;
  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  gap: var(--space-sm);
  align-items: end;
}
.thinking-row .section-title {
  max-width: 11ch;
}
.thinking-row .text-link {
  margin-top: 40px;
}
.essay-row {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--grid-gap);
  align-items: baseline;
  margin-top: var(--space-lg);
  padding-block: 40px;
  border-block: 1px solid var(--ink);
  text-decoration: none;
}
.essay-row h3 {
  grid-column: 1 / 7;
  font-size: var(--heading-3);
}
.essay-row p {
  grid-column: 7 / 11;
  font-size: var(--body);
  color: var(--muted);
}
.essay-kind {
  grid-column: 11 / 12;
  font: 400 12px/1.5 var(--mono);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.essay-row :global(.essay-arrow) {
  grid-column: 12 / 13;
  justify-self: end;
  font-size: 32px;
  transition: transform 0.6s var(--out);
}
@media (hover: hover) and (pointer: fine) {
  .essay-row:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 5px;
    text-underline-offset: 8px;
  }
  .essay-row:hover :global(.essay-arrow) {
    transform: translate(4px, -4px);
  }
}

.home-invitation {
  border-top: 1px solid var(--line);
}
.invitation-title {
  font-size: var(--display-xl);
  line-height: 0.86;
  max-width: 7ch;
}
.invitation-bottom {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin-top: var(--space-md);
}
.invitation-bottom .button {
  min-width: 200px;
}

@media (max-width: 1023px) {
  .hero-explanation {
    grid-column: 1 / -1;
    font-size: 34px;
  }
  .hero-bottom .actions {
    grid-column: 1 / -1;
    justify-content: start;
    margin-top: 8px;
  }
  .thinking-row {
    grid-template-columns: 1fr;
    align-items: start;
  }
  .essay-row h3 {
    grid-column: 1 / 11;
  }
  .essay-row p {
    grid-column: 1 / 11;
  }
  .essay-kind {
    grid-column: 1 / 11;
    grid-row: 3;
  }
  .essay-row :global(.essay-arrow) {
    grid-row: 1;
  }
  .invitation-title {
    font-size: clamp(80px, 15vw, 150px);
  }
}
@media (max-width: 767px) {
  .home-intro {
    padding-top: 40px;
  }
  .home-intro h1 {
    font-size: 14.4vw;
    line-height: 0.9;
  }
  .hero-break {
    display: block;
  }
  .hero-explanation {
    font-size: 26px;
  }
  .hero-band {
    margin-top: 64px;
  }
  .hero-band picture {
    padding-inline: 8px;
  }
  .hero-band figcaption {
    flex-direction: column;
    gap: 8px;
    padding-bottom: 48px;
  }
  .band-title {
    font-size: 22px;
  }
  .essay-row {
    grid-template-columns: minmax(0, 1fr) 24px;
    margin-top: 72px;
    padding-block: 28px;
  }
  .essay-row h3,
  .essay-row p,
  .essay-kind {
    grid-column: 1;
  }
  .essay-row h3 {
    font-size: 34px;
  }
  .essay-row :global(.essay-arrow) {
    grid-column: 2;
    font-size: 22px;
  }
  .invitation-title {
    font-size: clamp(64px, 18vw, 100px);
  }
  .invitation-bottom {
    flex-direction: column;
    align-items: start;
    gap: 32px;
  }
}
</style>
