---
import HomeLayout from '../layouts/HomeLayout.astro';
import Arrow from '../components/Arrow.astro';
import WorkStrip from '../components/home/WorkStrip.astro';
import { services } from '../data/practice';
---
<HomeLayout title="The Spotted Ape — Strategic Decisions & Behavioural Design" description="We help leaders make consequential choices when familiar assumptions no longer hold. Independent strategic decision and behavioural design practice, Cape Town.">
<Fragment slot="head">
<style is:inline>
  html.bgate-pending { background: #0d0b0a; }
  html.bgate-pending body > :not(.bgate) { visibility: hidden; }
</style>
<script is:inline>
  try { if (!sessionStorage.getItem('beacon-gate-seen')) document.documentElement.classList.add('bgate-pending'); } catch (e) {}
</script>
</Fragment>
<section class="home-intro" id="idea">
<span id="instrument" aria-hidden="true"></span><span id="decision-record" aria-hidden="true"></span>
<div class="wrap">
<h1>
<span>More <span class="hero-break">possibilities.</span></span>
<span>Harder choices.</span>
</h1>
<div class="hero-body">
<p class="hero-explanation">We help leaders make consequential choices when familiar assumptions no longer hold.</p>
</div>
</div>
</section>

<section class="section-y home-practice" id="practice" aria-labelledby="practice-title">
<span id="work" aria-hidden="true"></span><span id="learning" aria-hidden="true"></span>
<div class="wrap split-layout">
<h2 class="section-title" id="practice-title">Decide.<br />Make it happen.</h2>
<div class="practice-copy">
<p class="lead">See differently. Choose deliberately. Turn the choice into action.</p>
<ul class="capabilities" role="list" aria-label="Capabilities">
{services.map(service => <li><a href={`/services/#${service.id}`}>{service.title}</a></li>)}
</ul>
<div class="actions"><a class="text-link" href="/services/">How we help <Arrow /></a><a class="text-link" href="/learning/">Workshops &amp; learning <Arrow /></a><a class="text-link" href="/about/#name">Why the name? <Arrow /></a></div>
</div>
</div>
</section>

<WorkStrip />

<section class="home-invitation section-y section-rule" id="engagement" aria-labelledby="invitation-title">
<span id="book" aria-hidden="true"></span><span id="choice" aria-hidden="true"></span>
<div class="wrap">
<h2 class="invitation-title" id="invitation-title">What needs deciding?</h2>
<div class="invitation-bottom">
<p class="lead">Bring the alternatives, the assumptions and the difficult questions.</p>
<a class="button button--talk" href="/contact/?source=%2F">Let’s talk</a>
</div>
</div>
</section>
<Fragment slot="body-end">
<script is:inline src="/beacon-gate.js"></script>
<script is:inline>
  // If the gate script fails to load, still reveal the page.
  try { BeaconGate.mount({ brand: 'The Spotted Ape', logo: '/logo.png' }); }
  finally { document.documentElement.classList.remove('bgate-pending'); }
</script>
</Fragment>
</HomeLayout>
<style>
.home-intro {
  padding-block: var(--space-md) var(--space-lg);
}
.home-intro h1 {
  font-size: min(12.6vw, 15.5rem);
  line-height: 0.86;
  letter-spacing: var(--tracking-display);
  text-indent: -0.04em;
}
.home-intro h1 > span {
  display: block;
}
.hero-body {
  margin-top: var(--space-xs);
}
.hero-explanation {
  max-width: 30ch;
  font-size: var(--heading-4);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: var(--tracking-heading);
  text-wrap: balance;
}
.text-link :global(.arrow) {
  font-size: 18px;
}
.capabilities {
  display: grid;
  justify-items: start;
  gap: 0;
  margin: 32px 0 40px;
  padding: 0;
  list-style: none;
}
.capabilities a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-size: var(--body-large);
  font-weight: var(--weight-display);
  line-height: var(--leading-snug);
  letter-spacing: var(--tracking-copy-large);
  text-decoration: none;
}
@media (hover: hover) and (pointer: fine) {
  .capabilities a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
}
.invitation-title {
  font-size: var(--display-xl);
  line-height: 0.86;
  max-width: 7ch;
}
.invitation-bottom {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin-top: var(--space-md);
}
.invitation-bottom .button {
  min-width: 200px;
}

@media (max-width: 1023px) {
  .hero-explanation {
    font-size: 34px;
    max-width: 24ch;
  }
  .invitation-title {
    font-size: clamp(80px, 15vw, 150px);
  }
}
@media (max-width: 767px) {
  .home-intro {
    padding-block: 48px 64px;
  }
  .home-intro h1 {
    font-size: 13.2vw;
    line-height: var(--leading-display);
  }
  .hero-break {
    display: block;
  }
  .hero-body {
    margin-top: 32px;
  }
  .hero-explanation {
    font-size: var(--body-large);
  }
  .invitation-title {
    font-size: clamp(64px, 18vw, 100px);
  }
  .invitation-bottom {
    flex-direction: column;
    align-items: start;
    gap: 32px;
  }
}
</style>
