---
import HomeLayout from '../layouts/HomeLayout.astro';
import FindFormation from '../components/home/FindFormation.astro';
import PracticeSection from '../components/PracticeSection.astro';
import StrategicMatrix from '../components/StrategicMatrix.astro';
import { strategyIllusion } from '../data/strategicMatrices';
---
<HomeLayout title="The Spotted Ape — Strategic Decisions & Behavioural Design" description="We help leaders make consequential choices when familiar assumptions no longer hold. Independent strategic decision and behavioural design practice, Cape Town.">
<section class="home-intro" id="idea">
<div class="wrap">
<div class="section-top meta">
<p class="meta-dot">Strategic decision &amp; behavioural design</p>
<p>Cape Town / Independent practice</p>
</div>
<h1>
<span>More possibilities.</span>
<span class="hero-choice">Harder choices.</span>
</h1>
<div class="hero-bottom">
<div>
<p class="hero-explanation">We help leaders make consequential choices when familiar assumptions no longer hold.</p>
<div class="actions">
<a class="button button--talk" href="mailto:hello@thespottedape.com">Let’s talk
</a>
<a class="text-link" href="#practice">Explore the practice <span aria-hidden="true">↓</span>
</a>
</div>
</div>
<aside class="hero-notation">
<p>Find your<br />formation.</p>
<span>Make a choice.<br />Own its consequences.</span>
</aside>
</div>
</div>
</section>
<FindFormation />
<PracticeSection />
<section class="section-y theme-grey" id="evidence">
<span id="case" aria-hidden="true">
</span>
<div class="wrap">
<div class="section-top meta">
<p>02 / The evidence</p>
<p>Research. Methods. Instruments.</p>
</div>
<h2 class="section-title" data-reveal>Begin with what<br />people actually do.</h2>
<article class="research-spread split-layout" id="project">
<figure class="evidence-visual" data-reveal>
<figcaption class="meta">Research / South Africa<br />Editorial diagram</figcaption>
<p class="visual-words">Available<br />technology.</p>
<div class="visual-connection" aria-hidden="true">
</div>
<p class="visual-tail">Everyday<br />behaviour.</p>
<p class="meta">The conditions between them matter.</p>
</figure>
<div class="project-copy">
<p class="meta">Behavioural design / Research</p>
<h3>Cookstove adoption in South Africa.</h3>
<dl class="project-dl">
<div>
<dt>Question</dt>
<dd>What influences the adoption of improved cookstoves among households in Dunoon?</dd>
</div>
<div>
<dt>Approach</dt>
<dd>Co-created interventions addressed cooking motivations, assessed through observations and questionnaires.</dd>
</div>
<div>
<dt>Finding</dt>
<dd>The pilot reported increased LPG and biomass stove ownership, but no significant reduction in paraffin stove ownership.</dd>
</div>
<div>
<dt>Implication</dt>
<dd>Understanding motivations and everyday cooking practices matters alongside the technology itself.</dd>
</div>
</dl>
<p class="source-note">Research pilot. Maré et al., Sustainability (2023). <a href="https://doi.org/10.3390/su15065328">doi:10.3390/su15065328</a>.</p>
<a class="text-link" href="https://thespottedape.com/research/index.html">Research &amp; references <span aria-hidden="true">↗</span>
</a>
</div>
</article>
<div class="evidence-foot" id="method">
<p class="display-copy">Observe before<br />prescribing.</p>
<a class="text-link" href="/cases/policy-analyst-strategic-review">A decision in practice <span aria-hidden="true">↗</span>
</a>
</div>
</div>
</section>
<section class="section-y" id="thinking">
<div class="wrap">
<div class="section-top meta">
<p>03 / Thinking &amp; instruments</p>
<a href="/thinking/">Explore all thinking ↗</a>
</div>
<div class="split-layout">
<div class="thinking-copy">
<p class="meta">Strategic decision map</p>
<h3>{strategyIllusion.title}.</h3>
<p>{strategyIllusion.question}</p>
<p id={`${strategyIllusion.id}-note`}>{strategyIllusion.insight}</p>
<a class="text-link" href="/thinking/strategic-decision-maps/strategy-illusion/">Explore the map <span aria-hidden="true">↗</span>
</a>
</div>
<div class="thinking-preview" data-reveal>
<StrategicMatrix matrix={strategyIllusion} compact />
</div>
</div>
<div class="instrument-row" id="instrument">
<div>
<p class="meta">An instrument for the conversation</p>
<h3>Make the reasoning visible.</h3>
</div>
<details class="decision-record" id="decision-record">
<summary>Open an example decision record</summary>
<dl>
<dt>Question</dt>
<dd>What needs to be decided?</dd>
<dt>Alternatives</dt>
<dd>Which options deserve comparison, including continuing as we are?</dd>
<dt>Assumptions</dt>
<dd>What would have to be true? What evidence could change our view?</dd>
<dt>Trade-offs</dt>
<dd>What are we choosing or setting aside?</dd>
<dt>Owner</dt>
<dd>Who decides, and who acts?</dd>
<dt>Review</dt>
<dd>When will we revisit the choice and its consequences?</dd>
</dl>
</details>
</div>
<a class="essay-row" href="https://thespottedape.com/posts/substack/2026-02-14-the-laboratory-fallacy.html">
<span class="meta">Essay</span>
<div>
<h3>The Laboratory Fallacy.</h3>
<p>When a persuasive model meets the conditions of real work.</p>
</div>
<span aria-hidden="true">↗</span>
</a>
</div>
</section>
<section class="home-invitation theme-yellow section-y" id="engagement">
<span id="book" aria-hidden="true">
</span>
<div class="wrap">
<p class="meta">A consequential choice?</p>
<h2 class="section-title">What needs<br />deciding?</h2>
<div class="invitation-bottom">
<p class="lead">Bring the alternatives, the assumptions<br />and the difficult questions.</p>
<a class="button button--talk" href="mailto:hello@thespottedape.com">Let’s talk
</a>
</div>
</div>
</section>
</HomeLayout>
<style>
.home-intro {
  padding-block: var(--space-md) var(--space-lg);
}
.home-intro .section-top {
  margin-bottom: var(--space-md);
}
.home-intro h1 {
  font-size: var(--display-xl);
  line-height: 0.9;
  letter-spacing: -0.055em;
  text-indent: -0.035em;
}
.home-intro h1 > span {
  display: block;
}
.hero-choice:after {
  content: '';
  display: block;
  width: 23%;
  height: 10px;
  background: var(--signal);
  margin-top: 22px;
}
.hero-bottom {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  gap: 10%;
  margin-top: var(--space-sm);
  align-items: end;
}
.hero-explanation {
  font-size: var(--heading-4);
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.05em;
  max-width: 28ch;
}
.hero-notation {
  border-left: 1px solid var(--ink);
  padding-left: 24px;
}
.hero-notation p {
  font-size: var(--heading-3);
  line-height: 0.95;
  letter-spacing: -0.05em;
  font-weight: 600;
}
.hero-notation span {
  display: block;
  margin-top: 32px;
  font-size: 16px;
}
.research-spread {
  margin-top: var(--space-lg);
}
.instrument-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
  border-top: 1px solid var(--line);
  padding-top: 40px;
}
.instrument-row h3 {
  font-size: var(--heading-4);
  margin-top: 24px;
  max-width: 15ch;
}
.essay-row {
  display: grid;
  grid-template-columns: 1fr 2fr 60px;
  gap: 24px;
  align-items: start;
  padding-block: 40px;
  margin-top: 40px;
  border-block: 1px solid var(--line);
  text-decoration: none;
}
.essay-row h3 {
  font-size: var(--heading-4);
}
.essay-row p {
  font-size: 18px;
  margin-top: 20px;
  max-width: 38ch;
}
.essay-row > span:last-child {
  font-size: 48px;
  line-height: 1;
}
.home-invitation .meta {
  margin-bottom: 40px;
}
.invitation-bottom {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin-top: var(--space-sm);
}
@media (max-width: 1023px) {
  .home-intro h1 {
    font-size: clamp(64px, 11.5vw, 140px);
  }
  .hero-explanation {
    font-size: 32px;
  }
  .hero-notation p {
    font-size: 40px;
  }
  .hero-bottom {
    gap: 40px;
  }
}
@media (max-width: 767px) {
  .home-intro {
    padding-block: 48px 64px;
  }
  .home-intro .section-top {
    margin-bottom: 56px;
  }
  .home-intro h1 {
    font-size: clamp(40px, 9.5vw, 76px);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }
  .hero-choice:after {
    height: 6px;
    width: 35%;
    margin-top: 16px;
  }
  .hero-bottom {
    grid-template-columns: 1fr;
    margin-top: 32px;
    gap: 40px;
  }
  .hero-explanation {
    font-size: 26px;
    max-width: 26ch;
  }
  .hero-notation {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .hero-notation p {
    font-size: 32px;
  }
  .hero-notation span {
    margin: 0;
    align-self: end;
    font-size: 14px;
    max-width: 16ch;
  }
  .research-spread {
    margin-top: 48px;
  }
  .instrument-row {
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 64px;
  }
  .instrument-row h3 {
    font-size: 32px;
  }
  .essay-row {
    grid-template-columns: 1fr 32px;
  }
  .essay-row > .meta {
    grid-column: 1/-1;
  }
  .essay-row h3 {
    font-size: 30px;
  }
  .essay-row > span:last-child {
    font-size: 32px;
  }
  .invitation-bottom {
    flex-direction: column;
    align-items: start;
    gap: 32px;
  }
  .home-invitation .section-title {
    font-size: clamp(64px, 16vw, 100px);
  }
}
</style>
