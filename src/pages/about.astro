---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ledger from '../components/Ledger.astro';
import FormationGraphic from '../components/FormationGraphic.astro';
import PageIntro from '../components/PageIntro.astro';

const foundingPrinciples = [
  {
    number: '01',
    title: 'Visibility creates orientation',
    body: 'Make competing priorities, assumptions and responsibilities visible.',
  },
  {
    number: '02',
    title: 'Wise hands at the wheel',
    subtitle: '',
    body: 'Experience helps distinguish a difficult decision from a request for more information.',
  },
  {
    number: '03',
    title: 'Good guidance eventually becomes unnecessary',
    body: 'Leave teams able to examine and own their decisions.',
  },
  {
    number: '04',
    title: 'Work together',
    body: 'Bring conflicting perspectives into the same conversation.',
  },
];
---
<BaseLayout title="About The Spotted Ape — Strategic Decisions & Behavioural Design" description="The independent practice of Marcel Maré. Behavioural science, strategic design and human judgement for organisations in transition.">
<PageIntro scale="long" description="When conditions turn chaotic, speed is not your friend.">
<Fragment slot="heading">Everyone is moving.<br />Are we moving<br />together?</Fragment>
</PageIntro>
<section class="about-field theme-dark section-y" id="section-01">
<div class="wrap">
<div class="split-layout">
<div class="about-statement">
<h2>Movement needs<br />direction.</h2>
<p class="lead">Under pressure, capable teams can pursue conflicting priorities without recognising the disagreement.</p>
<p class="p-body">The Spotted Ape helps organisations make consequential decisions, understand human behaviour and navigate the changing relationship between people and AI.</p>
</div>
<div class="formation-frame">
<FormationGraphic variant="about" />
</div>
</div>
</div>
</section>
<section class="section-y" id="section-02">
<div class="wrap">
<h2 class="section-title" data-reveal>How we work.</h2>
<div class="principle-list"><Ledger items={foundingPrinciples.map(item => ({ name: `${item.title}.`, text: item.body }))} label="How we work" /></div>
</div>
</section>
<section class="section-y section-rule" id="section-05">
<div class="wrap">
<div class="split-layout">
<div class="practitioner-name">
<h2>Marcel<br />Maré.</h2>
<p class="lead">Behavioural designer.<br />Researcher. Strategic consultant.</p>
<a class="text-link" href="https://marcelmare.com">Professional biography <Arrow />
</a>
</div>
<div class="practitioner-copy">
<p class="display-copy">What enables people to move from knowing what is possible to actually doing something worthwhile?</p>
<div class="prose">
<p>The Spotted Ape is the independent strategic practice of Marcel Maré, a behavioural designer, researcher and strategic consultant working across design, human behaviour and emerging technology.</p>
<p>His work has ranged from understanding why households adopt new energy technologies to helping organisations navigate strategic choices and technological change.</p>
</div>
<a class="button button--talk" href="/contact/?source=%2Fabout">Let’s talk
</a>
</div>
</div>
</div>
</section>
</BaseLayout>
<style>
.about-statement h2 {
  font-size: var(--heading-2);
  line-height: 1;
  max-width: 15ch;
}
.about-statement .lead {
  margin-top: 40px;
}
.about-statement .p-body {
  margin-top: 32px;
}
.formation-frame {
  min-width: 0;
  align-self: center;
}
.principle-list {
  margin-top: var(--space-lg);
}
.practitioner-name h2 {
  font-size: var(--display-l);
  line-height: 0.9;
  margin-block: 0 40px;
}
.practitioner-name .text-link {
  margin-top: 32px;
}
.practitioner-copy .display-copy {
  padding-bottom: 40px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 40px;
}
.practitioner-copy .button {
  margin-top: 40px;
}
@media (max-width: 1023px) {
  .about-statement h2 {
    font-size: 56px;
  }
  .practitioner-name h2 {
    font-size: 100px;
  }
}
@media (max-width: 767px) {
  .about-statement h2 {
    font-size: 44px;
  }
  .principle-list {
    margin-top: 48px;
  }
  .practitioner-name h2 {
    font-size: 88px;
  }
  .about-field .split-layout {
    gap: 56px;
  }
}
</style>
