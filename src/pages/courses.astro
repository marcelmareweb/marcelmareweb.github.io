---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseSyllabus from '../components/CourseSyllabus.astro';
import BookingSection from '../components/BookingSection.astro';
import PageIntro from '../components/PageIntro.astro';
import { contactHref } from '../lib/contact';
import { publicResources } from '../data/practice';

const pageTitle = 'Applied Strategy & Digital Acumen Courses | The Spotted Ape';
const pageDescription =
  'Applied learning in human judgement, responsible AI, behavioural and strategic design, and practical decision-making. Explore the Cape Manufacturing solar investment case and custom executive cohorts.';

const courseSpecs = [
  {
    label: 'FLAGSHIP CASE SIMULATION',
    value: 'Should We Invest in Solar? (Cape Manufacturing)',
    detail: 'Compare three proposals and defend a recommendation.',
  },
  {
    label: 'DURATION',
    value: '65–80 minute interactive case',
    detail: 'Self-paced learning with a working spreadsheet model.',
  },
  {
    label: 'TECHNICAL ENVIRONMENT',
    value: 'Microsoft Excel & Google Sheets',
    detail: 'Spreadsheet essentials are included.',
  },
];

const tensionContrasts = [
  {
    number: '01',
    conventionalLabel: 'COMMON PITFALL',
    conventionalTitle: 'Untraceable inputs',
    conventionalCopy: 'Retyped inputs obscure the assumptions behind a result.',
    spottedApeLabel: 'IN THIS CASE',
    spottedApeTitle: 'Traceable formulas',
    spottedApeCopy: 'Link calculations to Case Data!A3:F17 and inspect broken references.',
  },
  {
    number: '02',
    conventionalLabel: 'COMMON PITFALL',
    conventionalTitle: 'One metric decides',
    conventionalCopy: 'Payback and long-term value can favour different proposals.',
    spottedApeLabel: 'IN THIS CASE',
    spottedApeTitle: 'Competing criteria',
    spottedApeCopy:
      'A has the shortest payback (2.92 years); C has the highest base-case NPV (R2.871m).',
  },
  {
    number: '03',
    conventionalLabel: 'COMMON PITFALL',
    conventionalTitle: 'Claims without evidence',
    conventionalCopy: 'Annual averages hide when electricity is actually used.',
    spottedApeLabel: 'IN THIS CASE',
    spottedApeTitle: 'Operational evidence',
    spottedApeCopy:
      'Check half-hourly load profiles and seek independent evidence for environmental claims.',
  },
];

const toolkitResources = [
  {
    code: 'ARTIFACT 01 // .XLSX',
    title: 'Student Workbook (V8)',
    description: 'Five linked sheets, including a 20-year NPV model.',
    href: 'https://marcelmare.com/dla-course-2/downloads/SU_DLA_Solar_Student_Workbook_V8.xlsx',
    cta: 'Download Student Workbook ↓',
  },
  {
    code: 'ARTIFACT 02 // .PDF',
    title: 'Cape Manufacturing Case Brief',
    description: 'Supplier proposals, tariff assumptions and the Financial Director’s briefing.',
    href: 'https://marcelmare.com/dla-course-2/downloads/Cape_Manufacturing_Case_Brief.pdf',
    cta: 'Open Case Brief PDF ↗',
  },
  {
    code: 'ARTIFACT 03 // .PDF',
    title: 'Excel & Google Sheets Quick Reference',
    description: 'Cell addresses, cross-sheet formulas, reference locking and currency formatting.',
    href: 'https://marcelmare.com/dla-course-2/downloads/Spreadsheet_Quick_Reference_Excel_Google_Sheets.pdf',
    cta: 'Open Quick Reference PDF ↗',
  },
  {
    code: 'ARTIFACT 04 // .PDF',
    title: 'Formula Troubleshooting Diagnostic',
    description: 'Check shifted references, percentages and reversed ratios.',
    href: 'https://marcelmare.com/dla-course-2/downloads/Formula_Troubleshooting_Card.pdf',
    cta: 'Open Diagnostic Card PDF ↗',
  },
  {
    code: 'ARTIFACT 05 // .XLSX',
    title: 'Completed Reference Workbook (V8)',
    description: 'Compare your formulas and sensitivity analysis with the reference solution.',
    href: 'https://marcelmare.com/dla-course-2/downloads/SU_DLA_Solar_Completed_Reference_Workbook_V8.xlsx',
    cta: 'Download Reference Model ↓',
  },
  {
    code: 'ARTIFACT 06 // RATIONALE',
    title: '5-Minute Reviewer Rationale',
    description: 'Learning design, assessment checkpoints and competence criteria.',
    href: 'https://marcelmare.com/dla-course-2/reviewer-rationale.html',
    cta: 'Read Reviewer Rationale ↗',
  },
];

const audienceProfiles = [
  {
    tag: 'COHORT PROFILE 01',
    title: 'Analysts and emerging managers',
    description: 'Build, question and explain spreadsheet analyses.',
  },
  {
    tag: 'COHORT PROFILE 02',
    title: 'Finance, strategy and operations teams',
    description: 'Examine capital allocation, operational risks and investment criteria.',
  },
  {
    tag: 'COHORT PROFILE 03',
    title: 'Universities and executive education',
    description: 'Teach analytical judgement through observable work.',
  },
];

const outcomesList = [
  {
    number: '01',
    tier: 'FOUNDATIONAL & PRACTICAL COMPETENCE',
    title: 'Auditable Financial & Operational Modelling',
    description:
      'Build linked models that translate operational inputs into comparable financial metrics.',
  },
  {
    number: '02',
    tier: 'ANALYTICAL INTERROGATION',
    title: 'Sensitivity & Crossover Stress-Testing',
    description: 'Find the self-consumption threshold where investment rankings change.',
  },
  {
    number: '03',
    tier: 'PROFESSIONAL SCEPTICISM',
    title: 'Evidence-Based Verification of Claims',
    description: 'Specify the operational and lifecycle evidence needed to test supplier claims.',
  },
  {
    number: '04',
    tier: 'EXECUTIVE COMMUNICATION & TRANSFER',
    title: '100-Word Decision Briefings & Pattern Transfer',
    description: 'Write a qualified recommendation in 100 words or fewer.',
  },
];
---
<BaseLayout title={pageTitle} description={pageDescription}>
<PageIntro compact eyebrow="Courses / Solar learning case" scale="long" description="Three solar proposals. One decision to defend." id="premise">
<Fragment slot="heading">Should we invest<br />in solar?</Fragment>
<Fragment slot="aside">Flagship case simulation<br />65–80 minutes<br />Excel &amp; Google Sheets</Fragment>
<div class="actions"><a class="button" href={publicResources.course} target="_blank" rel="noreferrer">Open the learning case <span aria-hidden="true">↗</span></a><a class="text-link" href={contactHref({ interest: 'course', source: '/courses' })}>Discuss a team session ↗</a></div>
<p class="source-note">The fictional Cape Manufacturing case. Opens the learning case in a new tab.</p>
<nav class="page-nav" aria-label="Course page sections">
<a href="#syllabus">Explore the curriculum ↓</a>
<a href="#outcomes">Workbook &amp; resources ↓</a>
<a href="/learning/">All workshops &amp; learning ↗</a>
</nav>
</PageIntro>
<section class="course-feature theme-yellow section-y">
<div class="wrap">
<p class="meta">Cape Manufacturing / Western Cape</p>
<div class="course-feature-grid">
<h2>The evidence.<br />Your judgement.</h2>
<div>
<p class="lead">The spreadsheet provides the evidence.<br />The decisions require your judgement.</p>
<a class="button" href="#syllabus">Inspect the case <span aria-hidden="true">↓</span>
</a>
</div>
</div>
<div class="course-specs">{courseSpecs.map(spec=>
<div>
<p class="meta">{spec.label}</p>
<p>{spec.value}</p>
<span>{spec.detail}</span>
</div>)}</div>
</div>
</section>
<section class="section-y theme-grey">
<div class="wrap">
<div class="section-top meta">
<p>01 / People &amp; outcomes</p>
<p>Learning through observable work</p>
</div>
<div class="split-layout">
<div>
<h2 class="h2 audience-title">For people who must defend their decisions.</h2>
<div class="audiences">{audienceProfiles.map(aud=>
<article>
<h3>{aud.title}.</h3>
<p>{aud.description}</p>
</article>)}</div>
</div>
<div class="learning-outcomes">{outcomesList.map(item=>
<article>
<span class="meta">{item.number} / Learning outcome</span>
<h3>{item.title}.</h3>
<p>{item.description}</p>
</article>)}</div>
</div>
<div class="evidence-foot">
<p class="lead">A live organisational decision?<br />Bring your alternatives and trade-offs.</p>
<a class="text-link" href="/workshops">Explore decision workshops <span aria-hidden="true">↗</span>
</a>
</div>
</div>
</section>
<section class="section-y" id="tension">
<div class="wrap">
<div class="section-top meta">
<p>02 / What the case tests</p>
<p>From operator to adviser</p>
</div>
<h2 class="section-title" data-reveal>Technical output.<br />Human judgement.</h2>
<div class="tension-list">{tensionContrasts.map(item=>
<article class="tension-row">
<span class="meta">{item.number}</span>
<div>
<p class="meta">{item.conventionalLabel}</p>
<h3>{item.conventionalTitle}.</h3>
<p>{item.conventionalCopy}</p>
</div>
<div>
<p class="meta">{item.spottedApeLabel}</p>
<h3>{item.spottedApeTitle}.</h3>
<p>{item.spottedApeCopy}</p>
</div>
</article>)}</div>
</div>
</section>
<CourseSyllabus />
<section class="section-y" id="outcomes">
<div class="wrap">
<div class="section-top meta">
<p>04 / Course toolkit</p>
<p>Work with the actual artifacts</p>
</div>
<h2 class="section-title" data-reveal>Open the model.<br />Question it.</h2>
<div class="toolkit-layout">
<aside class="course-video">
<div class="video-frame">
<iframe src="https://www.youtube.com/embed/nHSyLciFe1k" title="Introduction to Should We Invest in Solar?" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin">
</iframe>
</div>
<h3>Should We Invest in Solar?</h3>
<p>A one-minute introduction to the investment decision.</p>
<a class="text-link" href="https://thespottedape.com/Courses/solar-investment/learn/" target="_blank" rel="noreferrer">Open the learning case <span aria-hidden="true">↗</span>
</a>
<p class="source-note">
<a href="https://marcelmare.com/dla-course-2/" target="_blank" rel="noreferrer">Alternative course host: marcelmare.com ↗</a>
</p>
</aside>
<div class="resource-list">{toolkitResources.map((res,index)=>
<a class="resource-row" href={res.href} target="_blank" rel="noreferrer">
<span class="meta">0{index+1}<br />{res.code.split('//')[1]}</span>
<div>
<h3>{res.title}.</h3>
<p>{res.description}</p>
<span class="resource-action">{res.cta}</span>
</div>
<span class="resource-arrow" aria-hidden="true">↗</span>
</a>)}</div>
</div>
</div>
</section>

<BookingSection defaultEngagement="Strategy Course (DLA)" eyebrow="05 / Team learning enquiry" heading="Discuss a team session." />
</BaseLayout>
<style>
.course-feature > .wrap > .meta {
  margin-bottom: 48px;
}
.course-feature-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 40px;
  align-items: end;
}
.course-feature h2 {
  font-size: var(--display-l);
  max-width: 13ch;
}
.course-feature-grid .button {
  margin-top: 32px;
}
.course-specs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 40px;
  border-top: 1px solid #0d0b0a66;
  padding-top: 32px;
  margin-top: var(--space-lg);
}
.course-specs .meta {
  margin-bottom: 20px;
}
.course-specs p:not(.meta) {
  font-size: 24px;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: -0.035em;
  max-width: 24ch;
}
.course-specs span {
  display: block;
  font-size: 16px;
  line-height: 1.4;
  margin-top: 16px;
  max-width: 32ch;
}
.tension-list {
  margin-top: var(--space-lg);
}
.tension-row {
  display: grid;
  grid-template-columns: 80px 1fr 1fr;
  gap: 40px;
  padding-block: 40px;
  border-top: 1px solid var(--line);
}
.tension-row h3 {
  font-size: var(--heading-4);
  margin-top: 24px;
}
.tension-row div > p:last-child {
  font-size: 20px;
  color: #626262;
  line-height: 1.45;
  max-width: 38ch;
  margin-top: 24px;
}
.toolkit-layout {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}
.video-frame {
  aspect-ratio: 16/9;
  background: var(--ink);
  border-radius: 8px;
  overflow: hidden;
}
.video-frame iframe {
  width: 100%;
  height: 100%;
  border: 0;
}
.course-video h3 {
  font-size: 32px;
  margin-top: 32px;
}
.course-video > p:not(.source-note) {
  font-size: 18px;
  line-height: 1.5;
  color: #626262;
  margin-top: 20px;
}
.course-video .text-link {
  margin-top: 24px;
}
.resource-action {
  display: block;
  font-size: 13px;
  margin-top: 16px;
}
.audience-title {
  max-width: 15ch;
}
.audiences {
  margin-top: 48px;
}
.audiences article {
  border-top: 1px solid var(--line);
  padding-block: 24px;
}
.audiences h3 {
  font-size: 28px;
  max-width: 26ch;
}
.audiences p {
  font-size: 18px;
  line-height: 1.5;
  margin-top: 16px;
  max-width: 38ch;
  color: #626262;
}
.learning-outcomes article {
  border-top: 1px solid var(--line);
  padding-block: 32px;
}
.learning-outcomes h3 {
  font-size: 36px;
  max-width: 24ch;
  margin-top: 24px;
}
.learning-outcomes article > p {
  font-size: 20px;
  line-height: 1.4;
  color: #626262;
  max-width: 38ch;
  margin-top: 24px;
}
@media (max-width: 1023px) {
  .course-feature h2 {
    font-size: 100px;
  }
  .course-feature-grid {
    grid-template-columns: 1fr;
  }
  .course-specs {
    gap: 24px;
  }
  .toolkit-layout {
    grid-template-columns: 1fr;
  }
  .course-video {
    max-width: 800px;
  }
  .tension-row {
    grid-template-columns: 40px 1fr 1fr;
    gap: 24px;
  }
}
@media (max-width: 767px) {
  .course-feature h2 {
    font-size: 64px;
  }
  .course-feature-grid {
    gap: 32px;
  }
  .course-specs {
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 48px;
  }
  .course-specs p:not(.meta) {
    font-size: 24px;
  }
  .tension-list,
  .toolkit-layout {
    margin-top: 48px;
  }
  .tension-row {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .tension-row h3 {
    font-size: 32px;
  }
  .tension-row div > p:last-child {
    font-size: 18px;
  }
  .learning-outcomes h3 {
    font-size: 30px;
  }
  .learning-outcomes article > p {
    font-size: 18px;
  }
  .audience-title {
    font-size: 44px;
  }
}
</style>
