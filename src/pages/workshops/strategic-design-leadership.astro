---
import Arrow from '../../components/Arrow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import MasterclassFormation from '../../components/masterclass/MasterclassFormation.astro';
import { masterclassTitle } from '../../data/executive-masterclass';
import { contactHref } from '../../lib/contact';
const enquiry = contactHref({ interest: 'masterclass', source: '/workshops/strategic-design-leadership/' });
---
<BaseLayout title={`${masterclassTitle} | The Spotted Ape`} description="Five standalone executive working sessions on strategic choices, capabilities and governance. Explore the E–P–I–A–S five-day masterclass through an interactive formation.">
  <PageIntro scale="long" description="Five days. Five strategic decisions. One coherent direction.">
    <Fragment slot="heading">Strategic Design<br />Leadership in<br />the Age of AI.</Fragment>
    <div class="actions"><a class="button" href={enquiry}>Discuss the programme <Arrow /></a><a class="text-link" href="#programme">Explore the five days <Arrow direction="down" /></a></div>
    <div class="masterclass-introduction">
      <div><p>Organisations rarely suffer from a shortage of plans. They struggle to make the choices that matter: where to compete, how to win, what capabilities to develop and what to stop doing.</p><p>This executive masterclass combines strategic decision design, behavioural understanding and AI-assisted exploration to turn unresolved strategic questions into actionable choices.</p></div>
      <aside><p class="meta">The format</p><p>Five standalone working sessions form one integrated strategic progression.</p><p class="masterclass-audience">For executive leaders, strategy directors and business-unit owners.</p></aside>
    </div>

  </PageIntro>
  <MasterclassFormation />
  <section class="section-y"><div class="wrap split-layout"><div><h2 class="h2">A day.<br />Or a direction.</h2><p class="programme-authority">The independent practice of Marcel Maré combines behavioural design, research and strategic judgement. <a href="/about#section-05">Meet the <span class="nowrap">practitioner <Arrow /></span></a>.</p><a class="text-link" href="/work/">Examine work &amp; research <Arrow /></a></div><div class="programme-questions">
    <details><summary class="disclosure"><span>Can a working day stand alone?</span><Arrow direction="down" /></summary><p>Yes. Start with the strategic question your organisation needs to resolve, or connect all five days as a progression.</p></details>
    <details><summary class="disclosure"><span>How is AI used?</span><Arrow direction="down" /></summary><p>AI supports exploration of options and assumptions. Human leaders assess the evidence and remain responsible for strategic decisions.</p></details>
    <details><summary class="disclosure"><span>How are delivery and attendance arranged?</span><Arrow direction="down" /></summary><p>Discuss timing, delivery and attendance around your requirements. <a href={enquiry}>Discuss the programme <Arrow /></a>.</p><p>Considering the programme for yourself? <a href={contactHref({ interest: 'masterclass', audience: 'individual', source: '/workshops/strategic-design-leadership/' })}>Ask about attendance <span class="nowrap">options <Arrow /></span></a>.</p></details>
    <a class="text-link" href="/learning/">All workshops &amp; learning <Arrow /></a>
  </div></div></section>
  <section class="masterclass-invitation section-y section-rule" id="discuss-programme"><div class="wrap"><h2>Bring a consequential<br />strategic question.</h2><div class="invitation-copy"><p class="lead">Discuss a standalone working day or the complete five-day progression around your organisation’s decisions.</p><a class="button" href={enquiry}>Discuss the masterclass <Arrow /></a></div></div></section>
</BaseLayout>
<style>
  .programme-authority { font-size: var(--body); line-height: var(--leading-copy); max-width: 42ch; margin-top: 32px; }
  .programme-questions details { border-top: 1px solid var(--line); padding-block: 24px; }
  .programme-questions summary { min-height: var(--control-height-compact); font-size: var(--body-large); line-height: 1.3; font-weight: 600; }
  .programme-questions p { margin-top: 20px; font-size: var(--body); line-height: var(--leading-copy); }
  .programme-questions > .text-link { margin-top: 24px; }

  .masterclass-introduction {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 12%;
    margin-top: 48px;
  }
  .masterclass-introduction > div {
    max-width: 56ch;
    font-size: var(--body-large);
    line-height: 1.4;
    letter-spacing: var(--tracking-copy);
  }
  .masterclass-introduction aside {
    max-width: 34ch;
  }
  .masterclass-introduction aside > p:not(.meta) {
    margin-top: 20px;
    font-size: var(--body-large);
    line-height: 1.35;
  }
  .masterclass-introduction aside .masterclass-audience {
    font-size: var(--text-ui);
    color: var(--muted);
  }
  .masterclass-invitation h2 {
    max-width: 24ch;
    margin-top: 0;
    font-size: var(--heading-2);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
  }
  .invitation-copy {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 48px;
  }
  .invitation-copy .lead {
    max-width: 43ch;
  }
  .invitation-copy .button {
    flex-shrink: 0;
  }
  @media (max-width: 1023px) {
    .masterclass-introduction {
      gap: 48px;
    }
  }
  @media (max-width: 767px) {
    .masterclass-introduction {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 32px;
    }
    .masterclass-introduction > div {
      font-size: var(--body-large);
    }
    .masterclass-invitation h2 {
      font-size: 44px;
    }
    .invitation-copy {
      display: block;
      margin-top: 32px;
    }
    .invitation-copy .button {
      margin-top: 32px;
    }
  }
</style>
