---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import BookingSection from '../components/BookingSection.astro';
import RaykisWorkshopTeaser from '../components/RaykisWorkshopTeaser.astro';
import { contactHref } from '../lib/contact';

const facilitationPhases = [
  {
    number: '01',
    tag: 'PHASE ONE // VISIBILITY',
    title: 'Expose assumptions',
    problem: 'Departments may use the same words for different priorities.',
    action: 'Identify the assumptions, incentives and constraints shaping each alternative.',
  },
  {
    number: '02',
    tag: 'PHASE TWO // JUDGEMENT',
    title: 'Confront trade-offs',
    problem: 'More analysis can postpone the choice.',
    action: 'Examine what each alternative requires and what it rules out.',
  },
  {
    number: '03',
    tag: 'PHASE THREE // FORMATION',
    title: 'Assign responsibility',
    problem: 'Agreement leaves decisions unfinished when nobody owns the next step.',
    action: 'Assign decision authority, responsibilities and review points.',
  },
];

const idealContexts = [
  {
    number: '01',
    title: 'Competing priorities',
    description: 'Several initiatives need the same resources. Which deserves commitment?',
  },
  {
    number: '02',
    title: 'AI in consequential work',
    description:
      'AI is entering important workflows. Who may approve, challenge or stop its actions?',
  },
  {
    number: '03',
    title: 'Agreement without action',
    description: 'A direction is agreed, but departmental incentives keep pulling people apart.',
  },
];

const clientDeliverables = [
  {
    number: '01',
    title: 'The decision and its constraints',
    description: 'Which question must be resolved, and what will the team stop doing?',
  },
  {
    number: '02',
    title: 'AI review points',
    description: 'Where must a person review the evidence or authorise the next step?',
  },
  {
    number: '03',
    title: 'Ownership and review',
    description: 'Who owns the decision, and what evidence would justify revisiting it?',
  },
];
---
<BaseLayout title="Strategic Decision Workshops | The Spotted Ape" description="Facilitated examination of strategic alternatives, assumptions, trade-offs and responsibility. Independent strategic decision and behavioural design practice.">
<PageIntro scale="long" description="Examine a live strategic choice: its alternatives, assumptions, trade-offs and responsibilities." id="section-01">
<Fragment slot="heading">From competing<br />perspectives to<br />collective decisions.</Fragment>
<Fragment slot="aside">For teams facing a live strategic choice.<br />Scope discussed around the decision.</Fragment>
<div class="actions"><a class="button" href={contactHref({ interest: 'workshop', source: '/workshops' })}>Discuss a workshop <Arrow /></a><a class="text-link" href="/learning/">All workshops &amp; learning <Arrow /></a></div>
<nav class="page-nav" aria-label="Workshop page sections">
<a href="#section-02">How it works <Arrow direction="down" /></a>
<a href="#section-04">Situations &amp; questions <Arrow direction="down" /></a>
<a href="/workshops/strategic-design-leadership/">Five-day executive masterclass <Arrow /></a>
<a href="#book">Workshop enquiry form <Arrow direction="down" /></a>
</nav>
</PageIntro>
<section class="workshop-banner theme-dark">
<div class="wrap">
<p>One decision.<br />
<span>Several perspectives.</span>
</p>
<p class="lead">Bring the disagreement into the room.<br />Leave with responsibility for the next step.</p>
</div>
</section>
<section class="section-y" id="section-02">
<div class="wrap">
<h2 class="section-title" data-reveal>Make the<br />reasoning visible.</h2>
<div class="phase-list">{facilitationPhases.map(phase=>
<article class="phase">
<span class="phase-number">{phase.number}</span>
<div>
<h3>{phase.title}.</h3>
<p class="phase-problem">{phase.problem}</p>
</div>
<div class="phase-action">
<p class="meta">In the room</p>
<p>{phase.action}</p>
</div>
</article>)}</div>
</div>
</section>
<section class="section-y theme-dark" id="section-04">
<div class="wrap">
<h2 class="section-title" data-reveal>What needs<br />resolving?</h2>
<div class="contexts split-layout">
<div>
<p class="meta context-label">When to convene</p>{idealContexts.map(item=>
<article class="context">
<span class="meta">{item.number}</span>
<h3>{item.title}.</h3>
<p>{item.description}</p>
</article>)}</div>
<div>
<p class="meta context-label">Questions to resolve</p>{clientDeliverables.map(item=>
<article class="context">
<span class="meta">{item.number}</span>
<h3>{item.title}.</h3>
<p>{item.description}</p>
</article>)}</div>
</div>
</div>
</section>
<section class="section-y">
<div class="wrap split-layout">
<div>
<h2 class="h2 workshop-spec-title">Designed around<br />the decision.</h2>
</div>
<dl class="spec-list">
<div>
<dt>Scope</dt>
<dd>Discussed around your live decision.</dd>
</div>
<div>
<dt>Core disciplines</dt>
<dd>Behavioural science, strategic design and human judgement.</dd>
</div>
<div>
<dt>Working relationship</dt>
<dd>Independent strategic decision and behavioural design.</dd>
</div>
</dl>
</div>
</section>
<section class="section-y theme-grey"><div class="wrap split-layout"><div><h2 class="h2">Examine the<br />work behind it.</h2></div><div><p class="lead">Explore a policy-analysis case account and the research that informs the behavioural practice.</p><div class="actions"><a class="text-link" href="/work/">Work &amp; research <Arrow /></a><a class="text-link" href="/about#section-05">Meet the practitioner <Arrow /></a></div></div></div></section>
<RaykisWorkshopTeaser />
<BookingSection defaultEngagement="Strategic Decision Workshop" />
</BaseLayout>
<style>
.workshop-banner {
  padding-block: 64px;
}
.workshop-banner .wrap {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
}
.workshop-banner .wrap > p:first-child {
  font-size: var(--heading-2);
  font-weight: 600;
  line-height: 0.95;
  letter-spacing: -0.05em;
}
.workshop-banner .wrap > p:first-child span {
  color: var(--signal);
}
.phase-list {
  margin-top: var(--space-lg);
}
.phase {
  display: grid;
  grid-template-columns: 100px 1.35fr 1fr;
  gap: 40px;
  border-top: 1px solid var(--line);
  padding-block: 48px;
}
.phase:last-child {
  border-bottom: 1px solid var(--line);
}
.phase-number {
  font-size: var(--heading-3);
  line-height: 1;
  color: var(--grey-500);
  letter-spacing: -0.05em;
}
.phase h3 {
  font-size: var(--heading-3);
}
.phase-problem {
  font-size: var(--body-large);
  line-height: 1.35;
  color: var(--muted);
  max-width: 34ch;
  margin-top: 24px;
}
.phase-action .meta {
  margin-bottom: 24px;
}
.phase-action > p:last-child {
  font-size: var(--body-large);
  line-height: 1.3;
  max-width: 30ch;
}
.contexts {
  margin-top: var(--space-lg);
}
.context-label {
  color: var(--signal);
  margin-bottom: 24px;
}
.context {
  border-top: 1px solid var(--line-inverse);
  padding-block: 32px;
}
.context > .meta {
  color: var(--grey-400);
}
.context h3 {
  font-size: var(--heading-4);
  margin-top: 24px;
  max-width: 19ch;
}
.context > p {
  font-size: var(--body-large);
  color: var(--muted-inverse);
  line-height: 1.4;
  max-width: 38ch;
  margin-top: 24px;
}
@media (max-width: 1023px) {
  .workshop-banner .wrap {
    display: block;
  }
  .workshop-banner .lead {
    margin-top: 32px;
  }
  .phase {
    grid-template-columns: 60px 1fr;
    gap: 24px;
  }
  .phase-action {
    grid-column: 2;
  }
  .phase h3 {
    font-size: 44px;
  }
}
@media (max-width: 767px) {
  .workshop-banner {
    padding-block: 48px;
  }
  .workshop-banner .wrap > p:first-child {
    font-size: 44px;
  }
  .phase-list {
    margin-top: 48px;
  }
  .phase {
    grid-template-columns: 32px 1fr;
    gap: 16px;
    padding-block: 32px;
  }
  .phase-number {
    font-size: var(--body-large);
  }
  .phase h3 {
    font-size: 32px;
  }
  .phase-problem,
  .phase-action > p:last-child {
    font-size: var(--body);
  }
  .phase-action .meta {
    margin-bottom: 16px;
  }
  .contexts {
    margin-top: 48px;
  }
  .context h3 {
    font-size: 32px;
  }
  .context > p {
    font-size: var(--body);
  }
}
</style>
