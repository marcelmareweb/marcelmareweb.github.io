---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import BookingSection from '../components/BookingSection.astro';
import MasterclassTeaser from '../components/MasterclassTeaser.astro';
import Ledger from '../components/Ledger.astro';
import DecisionRecord from '../components/DecisionRecord.astro';
import { getCollection } from 'astro:content';
import { contactHref } from '../lib/contact';

const facilitationPhases = [
  {
    number: '01',
    tag: 'PHASE ONE // VISIBILITY',
    title: 'Expose assumptions',
    problem: 'Departments may use the same words for different priorities.',
    action: 'Identify the assumptions, incentives and constraints shaping each alternative.',
  },
  {
    number: '02',
    tag: 'PHASE TWO // JUDGEMENT',
    title: 'Confront trade-offs',
    problem: 'More analysis can postpone the choice.',
    action: 'Examine what each alternative requires and what it rules out.',
  },
  {
    number: '03',
    tag: 'PHASE THREE // FORMATION',
    title: 'Assign responsibility',
    problem: 'Agreement leaves decisions unfinished when nobody owns the next step.',
    action: 'Assign decision authority, responsibilities and review points.',
  },
];

const idealContexts = [
  {
    number: '01',
    title: 'Competing priorities',
    description: 'Several initiatives need the same resources. Which deserves commitment?',
  },
  {
    number: '02',
    title: 'AI in consequential work',
    description:
      'AI is entering important workflows. Who may approve, challenge or stop its actions?',
  },
  {
    number: '03',
    title: 'Agreement without action',
    description: 'A direction is agreed, but departmental incentives keep pulling people apart.',
  },
];

const clientDeliverables = [
  {
    number: '01',
    title: 'The decision and its constraints',
    description: 'Which question must be resolved, and what will the team stop doing?',
  },
  {
    number: '02',
    title: 'AI review points',
    description: 'Where must a person review the evidence or authorise the next step?',
  },
  {
    number: '03',
    title: 'Ownership and review',
    description: 'Who owns the decision, and what evidence would justify revisiting it?',
  },
];
const phases = facilitationPhases.map(phase => ({ name: `${phase.title}.`, text: phase.problem, aside: phase.action }));
const contexts = idealContexts.map(item => ({ name: `${item.title}.`, text: item.description }));
const deliverables = clientDeliverables.map(item => ({ name: `${item.title}.`, text: item.description }));
const policy = (await getCollection('cases')).flatMap(({ data }) => (data.format === 'account' && data.slug === 'policy-analyst-strategic-review' ? [data] : []))[0];
const evidence = [
  ...(policy ? [{ name: policy.title, text: `Reported outcome: ${policy.result}`, aside: 'Case account', href: `/cases/${policy.slug}`, preview: `“${policy.quote}”` }] : []),
  { name: 'Cookstove adoption.', text: 'The pilot reported increased LPG and biomass stove ownership, but no significant reduction in paraffin stove ownership.', aside: 'Behavioural research', href: '/work/#research', preview: 'What influences the adoption of improved cookstoves among households in Dunoon?' },
];
---
<BaseLayout title="Strategic Decision Workshops | The Spotted Ape" description="Facilitated examination of strategic alternatives, assumptions, trade-offs and responsibility. Independent strategic decision and behavioural design practice.">
<PageIntro scale="long" description="Examine a live strategic choice: its alternatives, assumptions, trade-offs and responsibilities." id="section-01">
<Fragment slot="heading">From competing<br />perspectives to<br />collective decisions.</Fragment>
<Fragment slot="aside">For teams facing a live strategic choice.<br />Scope discussed around the decision.</Fragment>
<div class="actions"><a class="button" href={contactHref({ interest: 'workshop', source: '/workshops' })}>Discuss a workshop <Arrow /></a><a class="text-link" href="/learning/">All workshops &amp; learning <Arrow /></a></div>
</PageIntro>
<section class="section-y" id="section-02" aria-labelledby="phases-title">
<div class="wrap">
<h2 class="section-title" id="phases-title">Make the<br />reasoning visible.</h2>
<div class="block">
<Ledger items={phases} numbered size="large" heads={['Phase', 'The problem', 'In the room']} label="How the workshop works" />
</div>
</div>
</section>
<section class="section-y theme-dark" id="section-04" aria-labelledby="contexts-title">
<div class="wrap">
<h2 class="section-title" id="contexts-title">What needs<br />resolving?</h2>
<div class="contexts block">
<div>
<h3 class="context-label">When to convene</h3>
<Ledger items={contexts} label="When to convene" />
</div>
<div>
<h3 class="context-label">Questions to resolve</h3>
<Ledger items={deliverables} label="Questions to resolve" />
</div>
</div>
</div>
</section>
<section class="section-y">
<div class="wrap split-layout">
<h2 class="h2">Designed around<br />the decision.</h2>
<DecisionRecord label="Workshop specification" fields={[
  { label: 'Scope', value: 'Discussed around your live decision.' },
  { label: 'Core disciplines', value: 'Behavioural science, strategic design and human judgement.' },
  { label: 'Working relationship', value: 'Independent strategic decision and behavioural design.' },
]} />
</div>
</section>
<section class="section-y section-rule" aria-labelledby="evidence-title">
<div class="wrap">
<h2 class="h2" id="evidence-title">The work<br />behind it.</h2>
<div class="block">
<Ledger items={evidence} heads={['Evidence', 'What it shows', 'Kind']} label="Case account and research" />
<p class="source-note">The case is an account of one engagement. Its reported result does not establish a typical or guaranteed outcome.</p>
</div>
</div>
</section>
<MasterclassTeaser />
<BookingSection defaultEngagement="Strategic Decision Workshop" />
</BaseLayout>
<style>
.block {
  margin-top: var(--space-sm);
}
.contexts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
}
.context-label {
  margin-bottom: 16px;
  font: var(--weight-display) var(--text-ui)/1.4 var(--ui);
  letter-spacing: 0;
  color: var(--signal);
}
.source-note {
  margin-top: 16px;
  font: var(--font-label);
  color: var(--muted);
}
@media (max-width: 1023px) {
  .contexts {
    grid-template-columns: 1fr;
  }
}
</style>
