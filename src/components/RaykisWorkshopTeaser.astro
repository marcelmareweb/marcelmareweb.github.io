---
import Arrow from './Arrow.astro';
// Kept as the existing workshop teaser entry point; programme content is independent of legacy maturity frameworks.
const stages = ['Explorer', 'Practitioner', 'Integrator', 'Architect', 'Steward'];
---
<section class="masterclass-teaser section-y" id="executive-masterclass" aria-labelledby="masterclass-teaser-title">
  <div class="wrap">
    <div class="teaser-layout">
      <div><h2 id="masterclass-teaser-title">Five days.<br />One coherent direction.</h2><p class="teaser-name">Strategic Design Leadership in the Age of AI</p></div>
      <div class="teaser-copy"><p>Five strategic decisions: what success means, why customers choose you, the capabilities you need, where to compete and how to govern the choices.</p><p>Choose a standalone executive working day or connect all five as one programme.</p><a class="button" href="/workshops/strategic-design-leadership/">Explore the five-day masterclass <Arrow /></a></div>
    </div>
    <ol class="teaser-progression" aria-label="Programme progression">{stages.map((stage,index) => <li><span>{String(index+1).padStart(2,'0')}</span>{stage}</li>)}</ol>
  </div>
</section>
<style>
  .masterclass-teaser {
    border-bottom: 1px solid var(--line);
  }
  .teaser-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: end;
    gap: 64px;
  }
  h2 {
    max-width: 18ch;
    font-size: var(--heading-2);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
  }
  .teaser-name {
    max-width: 35ch;
    margin-top: 32px;
    font-size: var(--body-large);
    line-height: 1.25;
    letter-spacing: -0.035em;
  }
  .teaser-copy {
    max-width: 44ch;
    font-size: var(--body);
    line-height: 1.45;
  }
  .teaser-copy .button {
    margin-top: 32px;
  }
  .teaser-progression {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    padding: 32px 0 0;
    margin: 48px 0 0;
    border-top: 1px solid var(--line);
  }
  .teaser-progression li {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: var(--body);
    letter-spacing: var(--tracking-copy);
  }
  .teaser-progression span {
    font: var(--font-label);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .teaser-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .teaser-copy {
      max-width: 60ch;
    }
    .teaser-progression {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    h2 {
      font-size: 44px;
    }
    .teaser-copy {
      font-size: var(--body);
    }
    .teaser-progression {
      grid-template-columns: 1fr 1fr;
      gap: 20px 16px;
    }
    .teaser-progression li {
      font-size: var(--text-ui);
      gap: 8px;
    }
    .teaser-progression li:last-child {
      grid-column: 1/-1;
    }
  }
</style>
