---
const workshopHighlights = [
  {
    number: '01',
    tag: 'THE FACILITATED ROOM',
    title: 'Expose competing assumptions',
    description:
      'Before any strategy is locked or any model is deployed, we surface the unspoken priorities, perceived risks, and crossed signals pulling your team apart.',
  },
  {
    number: '02',
    tag: 'CONSEQUENTIAL CHOICES',
    title: 'Confront the hard trade-offs',
    description:
      'Structured behavioural and strategic design methods that separate organisational noise from what actually matters—turning debate into shared conviction.',
  },
  {
    number: '03',
    tag: '5-STAGE AGENTIC MASTERY',
    title: 'Govern AI with human judgement',
    description:
      'A staged progression from Explorer (Stage 01) to Steward (Stage 05) that establishes explicit human-in-the-loop checkpoints and decision accountability.',
  },
];
---

<section id="masterclass" class="section-y scroll-mt-24 border-b border-[var(--border-subtle)] bg-[var(--bg-elevated)]" aria-labelledby="raykis-teaser-title">
  <div class="editorial-container">
    <div class="mb-14 flex flex-col gap-4 border-b border-[var(--border-subtle)] pb-8 sm:flex-row sm:items-end sm:justify-between">
      <p class="technical-label text-[11px] tracking-widest text-[var(--accent-signal)] sm:text-xs">
        03 / RAYKIS STRATEGIC DECISION WORKSHOPS
      </p>
      <span class="technical-label text-[11px] tracking-widest text-[var(--text-muted)]">FACILITATED INTERVENTIONS &amp; 5-STAGE MASTERY</span>
    </div>

    <div class="mb-14 grid gap-10 lg:grid-cols-[7fr_5fr] lg:items-end lg:gap-16">
      <div>
        <h2 id="raykis-teaser-title" class="h2 max-w-[17ch] text-[var(--text-primary)]">
          From competing perspectives to <em>collective decisions.</em>
        </h2>
      </div>
      <div>
        <p class="p-lead mb-4">
          AI extends capability. Humans remain responsible for judgement.
        </p>
        <p class="p-body max-w-[56ch]">
          When organisations stall, it is rarely for lack of intelligence or effort. Our Raykis Strategic Decision Workshops and 5-Stage Agentic Mastery progression bring leadership and specialist teams into a structured room to confront trade-offs and find formation.
        </p>
      </div>
    </div>

    <div class="grid gap-px border border-[var(--border-subtle)] bg-[var(--border-subtle)] lg:grid-cols-3">
      {workshopHighlights.map((item) => (
        <article class="flex flex-col justify-between bg-[var(--bg-primary)] p-7 transition-colors duration-200 hover:bg-[var(--bg-card)] sm:p-9">
          <div>
            <div class="mb-7 flex items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
              <span class="technical-label text-xs font-semibold text-[var(--accent-signal)]">{item.number} / PILLAR</span>
              <span class="technical-label text-[10px] tracking-widest text-[var(--text-muted)]">{item.tag}</span>
            </div>
            <h3 class="h3 mb-4 text-[var(--text-primary)]">{item.title}</h3>
            <p class="text-sm leading-7 text-[var(--text-muted)] sm:text-base">{item.description}</p>
          </div>
          <div class="mt-8 border-t border-[var(--border-subtle)] pt-4">
            <a
              class="technical-label inline-flex items-center gap-2 text-[11px] tracking-widest text-[var(--accent-signal)] no-underline transition-colors hover:text-[var(--accent-signal-hover)]"
              href="/workshops"
            >
              Inspect Architecture <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-6 border border-[var(--border-accent)] bg-[var(--bg-primary)] p-7 sm:flex-row sm:items-center sm:p-9">
      <div>
        <p class="technical-label mb-2 text-[11px] tracking-widest text-[var(--accent-signal)]">
          INTERACTIVE 5-STAGE CURRICULUM &amp; TEAM DIAGNOSTIC
        </p>
        <p class="font-editorial text-2xl text-[var(--text-primary)] sm:text-3xl">
          Explore the full Raykis workshop architecture and run the Quick Team Diagnostic.
        </p>
      </div>
      <a
        class="group inline-flex min-h-12 shrink-0 items-center bg-[var(--accent-signal)] px-7 text-sm font-semibold text-[var(--text-on-accent)] no-underline transition-colors hover:bg-[var(--accent-signal-hover)]"
        href="/workshops"
      >
        Explore Raykis Workshops <span class="ml-2.5 inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

