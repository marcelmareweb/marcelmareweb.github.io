---
import type { StrategicMatrix } from '../data/strategicMatrices';

interface Props {
  matrix: StrategicMatrix;
  compact?: boolean;
}

const { matrix, compact = false } = Astro.props;
const rows = [
  { level: 'high', positions: ['topLeft', 'topRight'] },
  { level: 'low', positions: ['bottomLeft', 'bottomRight'] },
] as const;
---

<figure class:list={['strategic-matrix', { compact }]}>
  <div class="matrix-chart">
    <div class="y-axis" aria-hidden="true">
      <span>{matrix.yAxis.high}</span>
      <span class="y-label">{matrix.yAxis.label}</span>
      <span>{matrix.yAxis.low}</span>
    </div>
    <div class="matrix-square">
      <table aria-describedby={`${matrix.id}-note`}>
        <caption class="matrix-sr-only">
          {matrix.title}. {matrix.xAxis.label} increases from left to right.
          {matrix.yAxis.label} increases from bottom to top.
        </caption>
        <colgroup><col class="row-header-column" /><col /><col /></colgroup>
        <thead class="matrix-sr-only">
          <tr>
            <td></td>
            <th scope="col" id={`${matrix.id}-x-low`}>{matrix.xAxis.low} {matrix.xAxis.label.toLowerCase()}</th>
            <th scope="col" id={`${matrix.id}-x-high`}>{matrix.xAxis.high} {matrix.xAxis.label.toLowerCase()}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ level, positions }) => (
            <tr>
              <th class="matrix-sr-only" scope="row" id={`${matrix.id}-y-${level}`}>
                {matrix.yAxis[level]} {matrix.yAxis.label.toLowerCase()}
              </th>
              {positions.map((position, column) => (
                <td
                  headers={`${matrix.id}-y-${level} ${matrix.id}-x-${column === 0 ? 'low' : 'high'}`}
                  class:list={['quadrant', { highlighted: matrix.highlight === position }]}
                >
                  <strong>{matrix.quadrants[position].title}</strong>
                  <p>{matrix.quadrants[position].description}</p>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="x-axis" aria-hidden="true">
      <div class="axis-range"><span>{matrix.xAxis.low}</span><span>{matrix.xAxis.high}</span></div>
      <p>{matrix.xAxis.label}</p>
    </div>
  </div>
</figure>

<style>
  .strategic-matrix { margin: 0; container-type: inline-size; }
  .matrix-chart {
    width: 70%;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.75rem 0.5rem;
  }
  .matrix-square { aspect-ratio: 1; }
  .compact .matrix-chart { width: 100%; }
  .compact .quadrant { padding: clamp(0.5rem, 1.2vw, 1.25rem); }
  .compact .quadrant strong { font-size: clamp(0.875rem, 1.4vw, 1.25rem); }
  .compact .quadrant p { font-size: clamp(0.75rem, 1vw, 0.875rem); }
  table {
    width: 100%;
    height: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  tr { height: 50%; }
  col { width: 50%; }
  .row-header-column { width: 0; }
  .quadrant {
    width: 50%;
    padding: clamp(0.625rem, min(2.5vw, 4cqi), 2rem);
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    text-align: center;
    vertical-align: middle;
  }
  .quadrant strong {
    display: block;
    font-family: var(--ui);
    font-size: clamp(1rem, min(2.6vw, 5.5cqi), 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.022em;
  }
  .quadrant p {
    margin: 0.625rem 0 0;
    font-size: clamp(0.75rem, 1.35vw, 1rem);
    line-height: 1.45;
  }
  .highlighted {
    background: var(--signal);
    color: var(--ink);
  }
  .x-axis, .y-axis {
    font-family: var(--ui);
    font-weight: 500;
    font-size: var(--text-small);
    line-height: 1.4;
    color: var(--muted);
  }
  .y-axis {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }
  .y-label { writing-mode: vertical-rl; transform: rotate(180deg); }
  .x-axis { grid-column: 2; }
  .axis-range { display: flex; justify-content: space-between; }
  .x-axis p { width: 100%; max-width: none; margin: 0.5rem 0 0; text-align: center; }
  figcaption { margin: 2rem 0 0; }
  .matrix-insight {
    font-family: var(--read);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: -0.022em;
    color: var(--ink);
  }
  .matrix-note { margin: 1rem 0 0; font-size: var(--text-small); line-height: 1.6; color: var(--muted); }
  /* A narrow column (a phone, or the Thinking preview beside its text) needs the full width for the quadrant labels. */
  @container (max-width: 600px) {
    .matrix-chart { width: 100%; }
  }
  @media (max-width: 375px) {
    .quadrant { padding: 0.375rem; }
    .quadrant strong { font-size: var(--text-small); }
    .quadrant p { margin-top: 0.375rem; line-height: 1.35; }
  }
  .matrix-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
