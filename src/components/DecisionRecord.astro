---
export interface RecordField {
  label: string;
  value: string;
}
interface Props {
  fields: RecordField[];
  label?: string;
  id?: string;
}
const { fields, label, id } = Astro.props;
---
<dl class="record" aria-label={label} id={id}>
  {fields.map(field => (
    <div class="record-row">
      <dt>{field.label}</dt>
      <dd>{field.value}</dd>
    </div>
  ))}
  <slot />
</dl>
