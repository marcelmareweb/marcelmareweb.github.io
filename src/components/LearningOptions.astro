---
import Arrow from './Arrow.astro';
import { learningOptions, publicResources } from '../data/practice';

// The self-paced case can be opened directly, one step sooner than its overview page.
const direct: Record<string, { label: string; href: string }> = {
  '/courses': { label: 'Open the learning case', href: publicResources.course },
};
---
<div class="learning-options">
  {learningOptions.map(option => (
    <article class="learning-option">
      <div class="option-copy">
        <h3><a href={option.href}>{option.title}</a></h3>
        <p class="option-description">{option.description}</p>
        <div class="actions">
          <a class="text-link" href={option.href}>{option.action} <Arrow /></a>
          {direct[option.href] && <a class="text-link" href={direct[option.href].href} target="_blank" rel="noreferrer">{direct[option.href].label} <Arrow /></a>}
        </div>
      </div>
      <dl class="record" aria-label={`${option.title.replace(/[.?]$/, '')}: details`}>
        <div class="record-row"><dt>Type</dt><dd>{option.type}</dd></div>
        <div class="record-row"><dt>For</dt><dd>{option.audience}</dd></div>
        <div class="record-row"><dt>Format</dt><dd>{option.format}</dd></div>
        <div class="record-row"><dt>What you leave with</dt><dd><strong>{option.output}</strong></dd></div>
        <div class="record-row"><dt>Status</dt><dd>{option.status}</dd></div>
      </dl>
    </article>
  ))}
</div>
<style>
  .learning-options { border-top: 1px solid var(--ink); }
  .learning-option { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-sm); padding-block: var(--space-sm); border-bottom: 1px solid var(--line); }
  h3 { max-width: 18ch; font-size: var(--heading-3); line-height: 1.04; text-wrap: balance; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .12em; }
  .option-description { max-width: 44ch; margin-top: 24px; font-size: var(--body-large); line-height: 1.35; }
  .actions { margin-top: 28px; }
  .record { border-top-color: var(--line); }
  @media (max-width: 1023px) {
    .learning-option { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 767px) {
    .learning-option { padding-block: 40px; }
    h3 { font-size: 34px; }
  }
</style>
