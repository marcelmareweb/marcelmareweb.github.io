---
import { learningOptions } from '../data/practice';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['learning-options', { 'learning-options--compact': compact }]}>
  {learningOptions.map(option => (
    <article class="learning-option">
      <div class="option-type"><p class="meta">{option.number} / {option.type}</p><p>{option.status}</p></div>
      <div class="option-content">
        <h3><a href={option.href}>{option.title}</a></h3>
        <p class="option-description">{option.description}</p>
        {!compact && <dl>
          <div><dt>For</dt><dd>{option.audience}</dd></div>
          <div><dt>Format</dt><dd>{option.format}</dd></div>
          <div><dt>Output</dt><dd>{option.output}</dd></div>
        </dl>}
        <a class="text-link" href={option.href}>{option.action} <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ))}
</div>
<style>
  .learning-options { border-top: 1px solid var(--line); }
  .learning-option { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 2fr); gap: var(--space-sm); padding-block: var(--space-sm); border-bottom: 1px solid var(--line); }
  .option-type .meta { color: #626262; }
  .option-type > p + p { max-width: 22ch; margin-top: 24px; font-size: 16px; line-height: 1.5; }
  h3 { max-width: 22ch; font-size: var(--heading-3); line-height: 1.06; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 7px; }
  .option-description { max-width: 52ch; margin-top: 28px; font-size: var(--body-large); line-height: 1.4; }
  dl { margin-block: 32px; }
  dl > div { display: grid; grid-template-columns: 75px 1fr; gap: 24px; margin-top: 16px; }
  dt { font: 11px/1.5 var(--mono); text-transform: uppercase; padding-top: 5px; color: #626262; }
  dd { font-size: var(--body); line-height: 1.5; max-width: 48ch; }
  .text-link { margin-top: 24px; }
  .learning-options--compact .learning-option { padding-block: 36px; }
  .learning-options--compact h3 { font-size: var(--heading-4); }
  .learning-options--compact .option-description { font-size: var(--body); max-width: 58ch; }
  @media (max-width: 767px) {
    .learning-option { grid-template-columns: 1fr; gap: 28px; padding-block: 36px; }
    .option-type > p + p { max-width: 34ch; margin-top: 12px; font-size: 14px; }
    h3, .learning-options--compact h3 { font-size: 36px; }
    .option-description { font-size: 22px; margin-top: 24px; }
    .learning-options--compact .option-description { font-size: 18px; }
    dl > div { grid-template-columns: 60px 1fr; gap: 16px; }
    dd { font-size: 18px; }
  }
</style>
