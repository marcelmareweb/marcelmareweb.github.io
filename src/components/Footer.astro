---
const year = new Date().getFullYear();
const links = [
  { label: 'How we help.', href: '/services/' },
  { label: 'Workshops & learning.', href: '/learning/' },
  { label: 'Work & research.', href: '/work/' },
  { label: 'Thinking.', href: '/thinking/' },
  { label: 'About.', href: '/about' },
  { label: 'Let’s talk.', href: '/contact/', talk: true },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <nav class="footer-nav" aria-label="Footer navigation">
        {links.map(link => <a href={link.href} class:list={{ 'is-talk': link.talk }}>{link.label}</a>)}
      </nav>
      <div class="footer-contact">
        <a href="mailto:hello@thespottedape.com">hello@thespottedape.com</a>
        <p>Cape Town, South Africa.<br />Independent strategic decision<br />and behavioural design practice.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <a class="brand" href="/" aria-label="The Spotted Ape home"><img src="/logo.png" width="30" height="30" alt="" /><span class="brand-word">THE SPOTTED APE</span></a>
      <p>© {year} The Spotted Ape (Pty) Ltd.</p>
      <nav aria-label="Legal"><a href="/privacy">Privacy.</a><a href="/terms">Terms.</a><a href="#top">Back to top.</a></nav>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--ink); color: var(--paper); padding-block: var(--space-lg) 28px; }
  .footer-top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); align-items: start; }
  .footer-nav { grid-column: 1 / 8; display: grid; justify-items: start; }
  .footer-nav a { font-size: var(--heading-3); font-weight: 600; line-height: 1.1; letter-spacing: -.05em; text-decoration: none; transition: color .6s var(--out); }
  .footer-nav a.is-talk { color: var(--signal); }
  .footer-contact { grid-column: 9 / -1; }
  .footer-contact > a { display: inline-block; font-size: var(--body-large); letter-spacing: -.025em; text-decoration: none; border-bottom: 1px solid #777; padding-bottom: 10px; overflow-wrap: anywhere; transition: border-color .6s var(--out); }
  .footer-contact p { margin-top: 28px; font-size: 16px; line-height: 1.5; color: #b3b3b3; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: var(--space-lg); padding-top: 24px; border-top: 1px solid #555; font-size: 13px; color: #b3b3b3; }
  .footer-bottom .brand { color: var(--paper); }
  .footer-bottom nav { display: flex; gap: 24px; }
  .footer-bottom nav a { display: inline-flex; align-items: center; min-height: 32px; text-decoration: none; }
  .site-footer a:focus-visible { outline-color: var(--signal); }
  @media (hover: hover) and (pointer: fine) {
    .footer-nav a:hover { color: var(--signal); }
    .footer-nav a.is-talk:hover { color: var(--paper); }
    .footer-contact > a:hover { border-color: var(--signal); }
    .footer-bottom nav a:hover { color: var(--paper); text-decoration: underline; text-decoration-color: var(--signal); }
  }
  @media (max-width: 1023px) {
    .footer-nav { grid-column: 1 / -1; }
    .footer-contact { grid-column: 1 / -1; margin-top: 56px; }
    .footer-bottom { flex-wrap: wrap; }
  }
  @media (max-width: 767px) {
    .site-footer { padding-top: 72px; }
    .footer-nav a { font-size: 34px; padding-block: 2px; }
    .footer-bottom { flex-direction: column; align-items: start; gap: 12px; margin-top: 64px; }
  }
</style>
