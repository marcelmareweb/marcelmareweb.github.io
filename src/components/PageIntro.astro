---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  description?: string;
  /** short: one-word headline. default: deliberate two-line break. long: three lines or long lines. sentence: an unbroken sentence. */
  scale?: 'default' | 'short' | 'long' | 'sentence';
  id?: string;
}
const { description, scale = 'default', id } = Astro.props;
---
<section class:list={['page-intro', 'page-intro--' + scale]} id={id}>
<div class="wrap">
<Breadcrumbs />
<h1>
<slot name="heading" />
</h1>{(description||Astro.slots.has('aside'))&&<div class="intro-bottom">
<p class="intro-description">{description}</p>
<div class="intro-aside">
<slot name="aside" />
</div>
</div>}<slot />
</div>
</section>
