---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  eyebrow: string;
  description?: string;
  scale?: 'default' | 'short' | 'long';
  id?: string;
  compact?: boolean;
}
const { eyebrow, description, scale = 'default', id, compact = false } = Astro.props;
---
<section class:list={['page-intro', 'page-intro--' + scale, { 'page-intro--compact': compact }]} id={id}>
<div class="wrap">
<Breadcrumbs />
<div class="section-top meta">
<p class="meta-dot">{eyebrow}</p>
<p>Independent practice / Cape Town</p>
</div>
<h1>
<slot name="heading" />
</h1>{(description||Astro.slots.has('aside'))&&<div class="intro-bottom">
<p class="intro-description">{description}</p>
<div class="intro-aside">
<slot name="aside" />
</div>
</div>}<slot />
</div>
</section>
