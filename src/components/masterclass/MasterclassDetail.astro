---
import Arrow from '../Arrow.astro';
import type { MasterclassDay } from '../../data/executive-masterclass';
import { masterclassDays } from '../../data/executive-masterclass';
import { contactHref } from '../../lib/contact';
interface Props {
  day: MasterclassDay;
}
const { day } = Astro.props;
const index = masterclassDays.findIndex((item) => item.id === day.id);
const previous = masterclassDays[index - 1];
const next = masterclassDays[index + 1];
const enquiry = contactHref({ interest: 'masterclass', day: day.id, source: '/workshops/strategic-design-leadership/' });
---
<article class="masterclass-detail" data-masterclass-detail={day.id} aria-labelledby={`session-question-${day.id}`}>
  <div class="detail-topline">
    <p class="meta">Day {day.number} / {day.stage}</p>
    <button class="return-button" type="button" data-masterclass-return data-masterclass-enhancement hidden>Back to the five-day formation <Arrow direction="up" /></button>
  </div>
  <header class="detail-heading">
    <h3 id={`session-question-${day.id}`} tabindex="-1">{day.question}</h3>
    <div class="session-focus"><p class="meta">The working session</p><p>{day.focus}.</p></div>
  </header>
  <div class="session-context">
    <div><p class="meta">The organisational problem</p><p>{day.problem}</p></div>
    <div class="session-tool"><p class="meta">Executive decision tool</p><h4>{day.tool}.</h4></div>
  </div>
  <div class="working-sessions">
    <section aria-label="Morning working session"><p class="meta">Morning / Examine</p><h4>{day.morningTitle}</h4><p>{day.morning}</p></section>
    <section aria-label="Afternoon working session"><p class="meta">Afternoon / Develop</p><h4>{day.afternoonTitle}</h4><p>{day.afternoon}</p></section>
  </div>
  <section class="executive-output" aria-labelledby={`output-${day.id}`}><p class="meta">The executive output</p><h4 id={`output-${day.id}`}>{day.outputName}.</h4><p>{day.output}</p></section>
  <div class="programme-thread">
    <div><p class="meta">Standalone day. Connected programme.</p><p>Work on a live decision in this session, or connect its output with the other four days.</p></div>
    <p class="thread-link">{previous ? `In the full programme, this day builds on the ${previous.outputName}.` : 'The Opportunity Landscape frames the options and assumptions explored across the full programme.'} {next ? `It creates a foundation for day ${next.number}: ${next.stage}.` : 'This final dossier brings the five days’ decisions into one accountable direction.'}</p>
  </div>
  <div class="detail-actions"><a class="button" href={enquiry}>Discuss day {day.number} <Arrow /></a><button class="return-button" type="button" data-masterclass-return data-masterclass-enhancement hidden>Return to the formation <Arrow direction="up" /></button></div>
  <nav class="session-navigation" aria-label="Move between workshop days" data-masterclass-enhancement hidden>
    {previous ? <button type="button" data-masterclass-go={previous.id}><span class="meta"><Arrow direction="left" /> Day {previous.number}</span><span>{previous.stage}</span></button> : <span class="first-day meta">The option space starts here.</span>}
    {next ? <button class="next-session" type="button" data-masterclass-go={next.id}><span class="meta">Day {next.number} <Arrow direction="right" /></span><span>{next.stage}</span></button> : <button class="next-session" type="button" data-masterclass-return><span class="meta">All five days <Arrow direction="up" /></span><span>Return to the formation</span></button>}
  </nav>
</article>
<style>
  .masterclass-detail {
    padding: var(--space-sm);
    background: var(--paper);
    color: var(--ink);
    border-top: 4px solid var(--signal);
  }
  .detail-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 48px;
  }
  .return-button {
    min-height: var(--control-height-compact);
    padding-block: 10px;
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-align: left;
  }
  .return-button:hover {
    text-decoration-thickness: 2px;
  }
  .detail-heading {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    align-items: end;
    gap: 48px;
  }
  .detail-heading h3 {
    max-width: 19ch;
    font-size: var(--heading-2);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .session-focus .meta {
    margin-bottom: 20px;
  }
  .session-focus > p:last-child {
    font-size: var(--body-large);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    font-weight: 600;
  }
  .session-context {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    border-top: 1px solid var(--grey-400);
    margin-top: 48px;
    padding-top: 32px;
  }
  .session-context .meta,
  .working-sessions .meta {
    margin-bottom: 24px;
  }
  .session-context > div > p:last-child {
    max-width: 45ch;
    font-size: var(--body-large);
    line-height: 1.35;
    letter-spacing: var(--tracking-copy);
  }
  .session-tool h4 {
    max-width: 24ch;
    font-size: var(--compact-sm);
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
  }
  .working-sessions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    border-top: 1px solid var(--grey-400);
    margin-top: 40px;
    padding-top: 32px;
  }
  .working-sessions h4 {
    max-width: 25ch;
    font-size: var(--compact-sm);
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
  }
  .working-sessions section > p:last-child {
    max-width: 47ch;
    margin-top: 20px;
    font-size: var(--body);
    line-height: var(--leading-copy);
  }
  .executive-output {
    margin-top: 40px;
    padding: 28px 32px 32px;
    background: var(--surface);
    border-top: 1px solid var(--ink);
  }
  .executive-output h4 {
    max-width: 28ch;
    margin-top: 24px;
    font-size: var(--heading-4);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }
  .executive-output > p:last-child {
    max-width: 64ch;
    margin-top: 24px;
    font-size: var(--body);
    line-height: 1.45;
  }
  .programme-thread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--grey-400);
  }
  .programme-thread p:not(.meta) {
    margin-top: 16px;
    font-size: var(--text-ui);
    line-height: var(--leading-copy);
    max-width: 55ch;
  }
  .programme-thread .thread-link {
    margin: 0;
    color: var(--muted);
  }
  .detail-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
  }
  .session-navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--grey-400);
  }
  .session-navigation button {
    display: grid;
    gap: 12px;
    min-height: 64px;
    text-align: left;
  }
  .session-navigation button > span:last-child {
    font-size: var(--body-large);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }
  .session-navigation .next-session {
    text-align: right;
    margin-left: auto;
  }
  @media (max-width: 1023px) {
    .detail-heading {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .detail-heading h3 {
      font-size: 60px;
      max-width: 20ch;
    }
    .session-focus {
      max-width: 48ch;
    }
    .session-context,
    .working-sessions,
    .programme-thread {
      gap: 32px;
    }
  }
  @media (max-width: 767px) {
    .masterclass-detail {
      padding: 28px 20px;
    }
    .detail-topline {
      display: block;
      margin-bottom: 32px;
    }
    .detail-topline .return-button {
      margin-top: 16px;
    }
    .detail-heading h3 {
      font-size: clamp(34px, 9.5vw, 50px);
      line-height: 1.03;
    }
    .session-focus > p:last-child {
      font-size: var(--body-large);
    }
    .session-context,
    .working-sessions,
    .programme-thread {
      grid-template-columns: 1fr;
      margin-top: 32px;
      padding-top: 24px;
    }
    .session-context > div > p:last-child {
      font-size: var(--body-large);
    }
    .session-tool h4,
    .working-sessions h4 {
      font-size: var(--compact-xs);
    }
    .working-sessions section > p:last-child,
    .executive-output > p:last-child {
      font-size: var(--body);
    }
    .executive-output {
      margin-top: 32px;
      padding: 24px 20px;
    }
    .executive-output h4 {
      font-size: var(--compact-sm);
    }
    .session-navigation {
      gap: 20px;
    }
    .session-navigation button > span:last-child {
      font-size: var(--body);
    }
    .first-day {
      max-width: 14ch;
    }
  }
</style>
