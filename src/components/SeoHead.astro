---
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string | URL;
  ogImage?: string | URL;
  schemaType?: string;
  /** Keep a working or error page out of search results; it then declares no canonical URL. */
  noindex?: boolean;
}

const {
  title = 'The Spotted Ape — Strategic Decisions & Behavioural Design',
  description = 'Independent strategic decision and behavioural design practice. We help leaders make consequential choices when familiar assumptions no longer hold. Cape Town, South Africa.',
  canonicalURL,
  ogImage = '/og-card.png',
  schemaType = 'ProfessionalService',
  noindex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://marcelmareweb.github.io');
const canonical = new URL(canonicalURL ?? Astro.url.pathname, siteURL);
const socialImage = ogImage ? new URL(ogImage, siteURL).href : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': new URL('#organization', siteURL).href,
  name: 'The Spotted Ape (Pty) Ltd',
  alternateName: 'The Spotted Ape',
  url: siteURL.href,
  description,
  email: 'hello@thespottedape.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cape Town',
    addressRegion: 'Western Cape',
    addressCountry: 'ZA',
  },
  areaServed: {
    '@type': 'Country',
    name: 'South Africa',
  },
};
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical.href} />}
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="The Spotted Ape" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical.href} />}
{socialImage && <meta property="og:image" content={socialImage} />}
{ogImage === '/og-card.png' && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="The Spotted Ape: More possibilities. Harder choices." /></>}

<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
