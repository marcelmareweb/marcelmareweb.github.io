---
import { getCollection } from 'astro:content';
import Arrow from '../Arrow.astro';
import Card from '../Card.astro';
import { strategyIllusion } from '../../data/strategicMatrices';

const cases = await getCollection('cases');
const policy = cases.find(item => item.data.slug === 'policy-analyst-strategic-review');
const map = strategyIllusion.quadrants;

// Each card's image is set from its own content or the item's own published imagery, never a decorative illustration.
type Item = { cue: string; kind: string; title: string; href: string; media: 'quote' | 'question' | 'matrix' | 'title' | 'image'; mediaText?: string; image?: string; external?: boolean };
const items = [
  policy && {
    //kind: 'Case account',
    title: policy.data.title,
    href: `/cases/${policy.data.slug}`,
    media: 'quote',
    cue: 'Read.',
    mediaText: policy.data.quote,
  },
  {
    //kind: 'Applied strategy',
    title: 'Should We Invest in Solar?',
    href: '/work/#solar',
    media: 'image',
    image: '/images/courses/solar-cape-manufacturing.jpg',
    cue: 'Read.',
  },
  {
    //kind: 'Behavioural research',
    title: 'Cookstove adoption.',
    href: '/work/#research',
    media: 'question',
    cue: 'Read.',
    mediaText: 'What influences the adoption of improved cookstoves in Africa?',
  },
  {
    //kind: 'Strategic decision mapping',
    title: `${strategyIllusion.title}.`,
    href: '/thinking/strategic-decision-maps/strategy-illusion/',
    media: 'matrix',
    cue: 'Design Strategy.',
  },
].filter(Boolean) as Item[];
---
<section class="work-strip section-y" id="evidence" aria-labelledby="work-strip-title" data-work-strip>
  <span id="case" aria-hidden="true"></span><span id="project" aria-hidden="true"></span><span id="method" aria-hidden="true"></span><span id="thinking" aria-hidden="true"></span>
  <div class="wrap strip-head">
    <div>
      <h2 class="section-title" id="work-strip-title">Observe before<br />prescribing.</h2>
      <p class="strip-sub">Make the reasoning visible.</p>
    </div>
    <div class="strip-tools">
      <div class="strip-links">
        <a class="text-link" href="/work/">All work &amp; research. <Arrow /></a>
        <a class="text-link" href="/thinking/">All thinking <Arrow /></a>
      </div>
      <div class="strip-controls" data-strip-controls hidden>
        <button class="strip-step" type="button" data-strip-step="-1" aria-label="Previous work"><Arrow direction="left" /></button>
        <button class="strip-step" type="button" data-strip-step="1" aria-label="Next work"><Arrow direction="right" /></button>
      </div>
    </div>
  </div>
  <ul class="strip-track" data-strip-track role="list">
    {items.map((item, index) => (
      <li class="strip-item">
        <Card layout="media" href={item.href} title={item.title} kind={item.kind} external={item.external} outlined={item.media === 'title'} cue={item.cue} index={index}>
          <div slot="media" class:list={['strip-media', `strip-media--${item.media}`]} aria-hidden={item.media === 'title' || item.media === 'matrix' || item.media === 'image' ? 'true' : undefined}>
            {item.media === 'quote' && <blockquote class="media-type"><p>“{item.mediaText}”</p></blockquote>}
            {item.media === 'question' && <p class="media-type">{item.mediaText}</p>}
            {item.media === 'matrix' && (
              <div class="mini-matrix">
                <img src="/matrix-black.svg" alt="" width="1254" height="1254" loading="lazy" decoding="async" />
                <span class="mm-tl">{map.topLeft.title}</span>
                <span class="mm-tr">{map.topRight.title}</span>
                <span class="mm-bl">{map.bottomLeft.title}</span>
                <span class="mm-br">{map.bottomRight.title}</span>
              </div>
            )}
            {item.media === 'title' && <p class="media-type media-type--title">{item.title}</p>}
            {item.media === 'image' && <img class="strip-photo" src={item.image} alt="" loading="lazy" decoding="async" />}
          </div>
        </Card>
      </li>
    ))}
  </ul>
</section>
<script>
  import '../../scripts/work-strip';
</script>
<style>
  .strip-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px 40px; }
  .strip-sub { margin-top: 20px; font-size: var(--heading-4); font-weight: var(--weight-display); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); color: var(--muted); }
  .strip-tools { display: flex; align-items: center; gap: 32px; flex-shrink: 0; }
  .strip-links { display: grid; justify-items: start; gap: 8px; }
  .text-link .arrow { font-size: var(--body); }
  .strip-controls:not([hidden]) { display: flex; gap: 8px; }
  .strip-step { display: grid; place-items: center; width: 56px; height: 56px; border: 1px solid var(--ink); border-radius: var(--radius-round); background: transparent; color: var(--ink); font-size: var(--body-large); transition: background-color var(--duration-hover) var(--out); }
  .strip-step[aria-disabled='true'] { opacity: .3; cursor: default; }
  @media (hover: hover) and (pointer: fine) {
    .strip-step:hover:not([aria-disabled='true']) { background: var(--surface); }
  }

  .strip-track {
    --strip-inset: max(var(--gutter), calc((100% - 1800px) / 2));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(300px, 31vw, 560px);
    gap: var(--grid-gap);
    margin: var(--space-sm) 0 0;
    padding: 0 var(--strip-inset) 24px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--strip-inset);
    scrollbar-width: thin;
    scrollbar-color: var(--ink) var(--line);
  }
  .strip-item { scroll-snap-align: start; padding-top: 8px; }
  @media (hover: hover) and (pointer: fine) {
    .strip-track { cursor: grab; }
    .strip-track:global(.is-dragging) { cursor: grabbing; scroll-snap-type: none; user-select: none; }
    .strip-track:global(.is-dragging) :global(.card-cue) { opacity: 0; }
  }
  .strip-media { height: 100%; display: flex; align-items: flex-end; aspect-ratio: 4 / 5; overflow: hidden; padding: 32px; background: var(--surface); color: var(--ink); }
  .strip-media--quote, .strip-media--matrix { background: var(--ink); color: var(--paper); }
  .strip-media--matrix { align-items: center; justify-content: center; }
  .strip-media--title { background: var(--paper); }
  .strip-media--image { padding: 0; }
  .strip-photo { display: block; width: 100%; height: 100%; object-fit: cover; }

  .media-type { margin: 0; font-size: clamp(32px, 2.6vw, 48px); font-weight: 600; line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); text-wrap: balance; }
  .media-type p { margin: 0; text-indent: -0.4em; }
  .media-type--title { font-size: clamp(56px, 5vw, 96px); line-height: var(--leading-display); letter-spacing: var(--tracking-display); }

  /* The quadrant titles sit over the illustrated matrix, top-left of each quadrant, sized to the image. */
  .mini-matrix { position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-tile); container-type: inline-size; }
  .mini-matrix img { display: block; width: 100%; height: 100%; }
  .mini-matrix span { position: absolute; max-width: 30cqi; font-size: max(var(--text-label), 4.8cqi); font-weight: 600; line-height: 1.08; letter-spacing: var(--tracking-heading); text-wrap: balance; }
  .mini-matrix .mm-tl { top: 4.6cqi; left: 5.2cqi; color: var(--ink); }
  .mini-matrix .mm-tr { top: 4.6cqi; left: 54.8cqi; color: var(--signal); }
  .mini-matrix .mm-bl { top: 55.4cqi; left: 5.2cqi; max-width: 42cqi; color: var(--signal); }
  .mini-matrix .mm-br { top: 55.4cqi; left: 53.8cqi; max-width: 46cqi; color: var(--ink); }

  @media (max-width: 767px) {
    .strip-head { flex-direction: column; align-items: start; gap: 24px; }
    .strip-controls { display: none !important; }
    .strip-track { grid-auto-columns: 80%; margin-top: 40px; }
    .strip-sub { margin-top: 12px; font-size: var(--compact-xs); }
    .strip-tools { flex-direction: column; align-items: start; }
    .strip-media { padding: 24px; }
    .media-type { font-size: var(--compact-xs); }
    .media-type--title { font-size: var(--compact-xl); }
  }
</style>
