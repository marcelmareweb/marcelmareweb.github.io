---
const choices = [
  {
    id: 'market',
    number: '01',
    title: ['Another', 'market'],
    name: 'Enter another market',
    needs: 'Customer evidence and a local delivery capability',
    constraint: 'Leadership attention',
    question: 'What evidence would justify entering this market?',
  },
  {
    id: 'customers',
    number: '02',
    title: ['Closer', 'relationships'],
    name: 'Deepen customer relationships',
    needs: 'Customer research and service capacity',
    constraint: 'Leadership attention',
    question: 'Which customers and unmet needs deserve attention?',
  },
  {
    id: 'reliability',
    number: '03',
    title: ['Reliable', 'operations'],
    name: 'Improve operational reliability',
    needs: 'Process observation and time for operational learning',
    constraint: 'Change capacity',
    question: 'Which recurring failures matter, and what sustains them?',
  },
  {
    id: 'ai',
    number: '04',
    title: ['AI in the', 'workflow'],
    name: 'Introduce AI into a workflow',
    needs: 'Workflow evidence, review rights and retained human practice',
    constraint: 'Change capacity',
    question: 'Where can a person meaningfully challenge or stop an action?',
  },
];
---

<section class="movement choice theme-dark" id="choice" data-formation>
  <div class="wrap">
    <div class="section-heading">
      <div>
        <h2>Find formation.</h2>
        <p>Choose what to back in the example below.<br />What does each decision require? What will you defer?</p>
      </div>
    </div>
    <div class="formation-toolbar" data-enhancement hidden>
      <div>
        <h3>Back up to two priorities.</h3>
        <p class="choice-hint" id="formation-hint">Hover over each priority to explore. Click or tap to back a decision. Select it again to clear it.</p>
      </div>
      <button class="reset" type="button" data-reset>Reset choices <span aria-hidden="true">↺</span></button>
      <p class="selection-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
    <div class="choice-grid">
      <div class="choice-board">
        <p class="board-tag">A field of commitments / fictional organisation</p>
        <div class="choice-field" role="group" aria-label="Strategic priorities" aria-describedby="formation-hint">
          <svg class="board-connections" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="board-link" data-link="market" d="M24 25 V43 H42 V50" />
            <path class="board-link" data-link="customers" d="M76 25 V43 H58 V50" />
            <path class="board-link" data-link="reliability" d="M24 75 V57 H42 V50" />
            <path class="board-link" data-link="ai" d="M76 75 V57 H58 V50" />
          </svg>
          <span class="dependency-label dependency-market" aria-hidden="true">Customer evidence</span>
          <span class="dependency-label dependency-customers" aria-hidden="true">Service capacity</span>
          <span class="dependency-label dependency-reliability" aria-hidden="true">Time to learn</span>
          <span class="dependency-label dependency-ai" aria-hidden="true">Review rights</span>
          {choices.map(choice => (
            <button
              class="board-choice"
              type="button"
              data-node={choice.id}
              data-name={choice.name}
              data-constraint={choice.constraint}
              aria-label={choice.name}
              aria-pressed="false"
              aria-controls={`formation-detail-${choice.id}`}
              aria-describedby={`formation-detail-${choice.id}`}
              disabled
            >
              <svg class="choice-outline" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <polygon points={choice.id === 'market' || choice.id === 'ai' ? '1,1 99,1 94,99 1,99' : '1,1 99,1 99,99 6,99'} />
              </svg>
              <span class="shape-title" aria-hidden="true">{choice.number} / Decision <span class="choice-mark">+</span></span>
              <span class="shape-name">{choice.title.map(line => <span>{line}</span>)}</span>
              <span class="status-word" aria-hidden="true">Open</span>
            </button>
          ))}
          <div class="constraint-ring">
            <span class="constraint-label" data-constraint-label>Capacity</span>
            <span class="constraint-note">Finite / shared</span>
          </div>
        </div>
        <div class="board-tail">
          <span>Yellow = backed · dashed = deferred</span>
          <span>Open questions remain.</span>
        </div>
      </div>
      <div class="choice-inspector" data-enhancement hidden role="region" aria-label="Choice details">
        <p class="board-tag">The implications / your choice notes</p>
        <div class="choice-details">
          <div class="empty-choice" data-empty>
            <p class="detail-state">Explore / nothing selected</p>
            <h4>A choice creates obligations.</h4>
            <p>Explore a shape to see what it needs. Back a priority to keep its information here.</p>
          </div>
          {choices.map(choice => (
            <article class="choice-detail" id={`formation-detail-${choice.id}`} data-detail={choice.id} hidden>
              <p class="detail-state"><span>{choice.number} / </span><span data-detail-state>Preview</span></p>
              <h4>{choice.name}</h4>
              <dl>
                <dt>Requires</dt><dd>{choice.needs}.</dd>
                <dt>Draws on</dt><dd>{choice.constraint}.</dd>
                <dt>Ask before committing</dt><dd>{choice.question}</dd>
              </dl>
            </article>
          ))}
        </div>
      </div>
      <div class="consequence" data-consequences hidden>
        <div>
          <h4>Your provisional formation</h4>
          <p data-trade-off></p>
        </div>
        <dl><dt data-alternatives-label>Still open</dt><dd data-alternatives></dd></dl>
      </div>
    </div>
    <details class="fallback" data-worked-example open>
      <summary>Read the worked example and its trade-offs</summary>
      <p><strong>Backing another market and closer customer relationships</strong> requires customer evidence and service capacity. Both compete for leadership attention. Reliability and AI workflow changes are deferred.</p>
      <p>Investigate demand and capacity before committing. There is no correct formation.</p>
      <dl class="fallback-choices">
        {choices.map(choice => (
          <div>
            <dt>{choice.name}</dt>
            <dd>{choice.needs}. This draws on {choice.constraint.toLowerCase()}. {choice.question}</dd>
          </div>
        ))}
      </dl>
    </details>
    <p class="scenario-note">Fictional exercise with an illustrative two-commitment limit. It is not an assessment. No information is saved or sent.</p>
  </div>
</section>

<script>
  import '../../scripts/formation.js';
</script>

<style>
  .choice .section-heading {
    display: block;
  }
  .choice .section-heading h2 {
    font-size: var(--display-l);
    max-width: none;
  }
  .choice .section-heading p:not(.meta) {
    max-width: 44ch;
    font-size: clamp(26px, 2.25vw, 36px);
    line-height: var(--leading-snug);
    margin-top: 32px;
    text-wrap: pretty;
  }
  .formation-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px 32px;
    margin-top: var(--space-sm);
  }
  .formation-toolbar h3 {
    font-size: var(--body-large);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
  }
  .choice-hint {
    margin-top: 8px;
    max-width: 68ch;
    font-size: var(--text-small);
    line-height: var(--leading-copy);
    color: var(--muted-inverse);
  }
  .reset {
    min-height: var(--control-height-compact);
    padding: 10px 18px;
    border: 1px solid var(--grey-500);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    white-space: nowrap;
  }
  .reset:hover,
  .reset:focus-visible {
    border-color: var(--signal);
  }
  .reset span {
    margin-left: 12px;
  }
  .selection-status {
    grid-column: 1 / -1;
    min-height: 3em;
    max-width: 90ch;
    margin: 0;
    color: var(--signal);
    font: var(--text-label)/var(--leading-copy) var(--mono);
  }
  .choice-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 32px;
    align-items: start;
    margin-top: 24px;
  }
  .choice-board,
  .choice-inspector {
    min-width: 0;
    border-top: 1px solid var(--grey-500);
    padding-top: 16px;
  }
  .choice-board {
    container-type: inline-size;
  }
  .board-tag {
    min-height: 2.8em;
    max-width: 50ch;
    color: var(--muted-inverse);
    font: var(--text-label)/1.4 var(--mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .choice-field {
    --node-height: 156px;
    --bridge-height: 156px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: var(--node-height) var(--bridge-height) var(--node-height);
    column-gap: 24px;
    margin-top: 24px;
    isolation: isolate;
  }
  .board-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .board-link {
    fill: none;
    stroke: var(--grey-500);
    stroke-width: 1.3px;
    stroke-dasharray: 4px 5px;
    vector-effect: non-scaling-stroke;
    transition: stroke 0.2s var(--out);
  }
  .board-link.is-preview {
    stroke: var(--signal);
  }
  .board-link.is-backed {
    stroke: var(--signal);
    stroke-dasharray: none;
    stroke-width: 2px;
  }
  .dependency-label {
    position: absolute;
    width: max-content;
    max-width: calc(50% - 16px);
    top: calc(var(--node-height) + 18px);
    padding-inline: 6px;
    background: var(--ink);
    font: var(--text-label)/1.4 var(--mono);
    color: var(--muted-inverse);
    text-align: center;
    text-transform: uppercase;
    pointer-events: none;
    transform: translateX(-50%);
  }
  .dependency-market,
  .dependency-reliability {
    left: 24%;
  }
  .dependency-customers,
  .dependency-ai {
    left: 76%;
  }
  .dependency-reliability,
  .dependency-ai {
    top: auto;
    bottom: calc(var(--node-height) + 18px);
  }
  .board-choice {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 12px minmax(0, 1fr) 12px;
    align-items: start;
    gap: 12px;
    min-width: 0;
    padding: 22px 28px;
    border: 0;
    background: transparent;
    color: white;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .board-choice[data-node='market'] {
    grid-area: 1 / 1;
    padding-left: 24px;
  }
  .board-choice[data-node='customers'] {
    grid-area: 1 / 2;
  }
  .board-choice[data-node='reliability'] {
    grid-area: 3 / 1;
  }
  .board-choice[data-node='ai'] {
    grid-area: 3 / 2;
    padding-left: 24px;
  }
  .choice-outline {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .choice-outline polygon {
    fill: var(--ink);
    stroke: var(--grey-400);
    stroke-width: 1.3px;
    vector-effect: non-scaling-stroke;
    transition:
      fill 0.2s var(--out),
      stroke 0.2s var(--out);
  }
  .board-choice:disabled {
    opacity: 1;
    cursor: default;
  }
  .board-choice.is-preview .choice-outline polygon {
    stroke: var(--signal);
    fill: var(--grey-900);
  }
  .board-choice.is-deferred .choice-outline polygon {
    stroke-dasharray: 5px 5px;
  }
  .board-choice.is-backed {
    color: var(--ink);
  }
  .board-choice.is-backed .choice-outline polygon {
    fill: var(--signal);
    stroke: var(--signal);
  }
  .board-choice:focus-visible {
    outline: 3px solid white;
    outline-offset: 5px;
  }
  .shape-title {
    padding-right: 18px;
    font: var(--text-label)/12px var(--mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .choice-mark {
    position: absolute;
    top: 19px;
    right: 24px;
    font: var(--body)/1 var(--ui);
  }
  .shape-name {
    align-self: center;
    font-size: clamp(21px, 4.2cqi, 30px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: var(--tracking-heading);
  }
  .shape-name > span {
    display: block;
  }
  .status-word {
    font: var(--text-label)/12px var(--mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted-inverse);
  }
  .board-choice.is-backed .status-word {
    color: inherit;
  }
  .constraint-ring {
    position: relative;
    z-index: 1;
    grid-area: 2 / 1 / 3 / -1;
    place-self: center;
    width: 52%;
    min-height: 40px;
    display: grid;
    place-items: center;
    border: 1.3px solid var(--signal);
    background: var(--ink);
    color: var(--signal);
  }
  .constraint-label {
    padding: 6px 8px;
    font: var(--text-label)/1.2 var(--mono);
    text-align: center;
    text-transform: uppercase;
  }
  .constraint-note {
    position: absolute;
    top: calc(100% + 10px);
    padding-inline: 8px;
    background: var(--ink);
    white-space: nowrap;
    font: var(--text-label)/1.2 var(--mono);
    text-transform: uppercase;
    color: var(--muted-inverse);
  }
  .constraint-ring.is-contested {
    border-style: dashed;
  }
  .board-tail {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-top: 24px;
    color: var(--muted-inverse);
    font: var(--text-label)/var(--leading-copy) var(--mono);
  }
  .choice-details {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  .empty-choice,
  .choice-detail {
    padding: 22px 24px;
    border: 1px solid var(--line-inverse);
  }
  .empty-choice {
    min-height: 280px;
  }
  .choice-detail.is-preview {
    order: 1;
    border-style: dashed;
    border-color: var(--grey-500);
  }
  .choice-detail.is-backed {
    box-shadow: var(--shadow-current);
  }
  .detail-state {
    margin-bottom: 14px;
    color: var(--signal);
    font: var(--text-label)/1.4 var(--mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .choice-details h4 {
    max-width: 26ch;
    margin-bottom: 20px;
    font-size: clamp(24px, 1.95vw, 30px);
    line-height: 1.08;
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }
  .empty-choice > p:last-child,
  .consequence p {
    max-width: 54ch;
    color: var(--muted-inverse);
    font-size: var(--text-ui);
    line-height: var(--leading-copy);
  }
  .choice-detail dl {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 14px 16px;
    margin: 0;
  }
  .choice-detail dt,
  .consequence dt {
    color: var(--muted-inverse);
    font: var(--text-label)/1.4 var(--mono);
    text-transform: uppercase;
  }
  .choice-detail dt {
    padding-top: 3px;
  }
  .choice-detail dd,
  .consequence dd {
    margin: 0;
    font-size: var(--text-ui);
    line-height: 1.45;
  }
  .consequence {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    column-gap: 48px;
    border-top: 1px solid var(--grey-500);
    padding-top: 24px;
  }
  .consequence h4 {
    margin-bottom: 12px;
    font-size: var(--body-large);
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }
  .consequence dl {
    margin: 0;
  }
  .consequence dd {
    max-width: 44ch;
    margin-top: 10px;
  }
  .fallback {
    border-block: 1px solid var(--line-inverse);
    padding-block: 20px;
    margin-top: 40px;
    max-width: 80ch;
  }
  .fallback summary {
    min-height: var(--control-height-compact);
    font-size: var(--body);
  }
  .fallback p,
  .fallback-choices dd {
    margin-top: 20px;
    color: var(--muted-inverse);
    font-size: var(--text-ui);
    line-height: 1.6;
  }
  .fallback-choices {
    display: grid;
    gap: 20px;
    margin-top: 24px;
  }
  .fallback-choices dt {
    font-size: var(--body);
  }
  .fallback-choices dd {
    margin: 8px 0 0;
  }
  .scenario-note {
    max-width: 75ch;
    margin-top: 24px;
    color: var(--grey-400);
    font-size: var(--text-label);
    line-height: var(--leading-copy);
  }
  @media (min-width: 1024px) {
    .choice-inspector {
      width: 50%;
    }
    .choice-detail dl {
      display: block;
    }
    .choice-detail dt {
      padding-top: 0;
    }
    .choice-detail dt:not(:first-child) {
      margin-top: 16px;
    }
    .choice-detail dd {
      margin-top: 5px;
    }
  }
  @media (max-width: 1199px) and (min-width: 1024px) {
    .choice-grid,
    .consequence {
      column-gap: 32px;
    }
    .board-choice {
      padding-inline: 22px;
    }
    .board-choice[data-node='market'],
    .board-choice[data-node='ai'] {
      padding-left: 20px;
    }
    .shape-name {
      font-size: var(--body-large);
    }
    .choice-detail dl {
      grid-template-columns: 70px minmax(0, 1fr);
      column-gap: 12px;
    }
    .empty-choice,
    .choice-detail {
      padding: 20px;
    }
  }
  @media (max-width: 1023px) {
    .choice .section-heading h2 {
      font-size: clamp(68px, 10vw, 110px);
    }
    .choice-grid {
      grid-template-columns: 1fr;
    }
    .choice-details {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr));
    }
    .choice-detail dl {
      display: block;
    }
    .choice-detail dt {
      padding: 0;
    }
    .choice-detail dt:not(:first-child) {
      margin-top: 16px;
    }
    .choice-detail dd {
      margin-top: 5px;
    }
    .empty-choice {
      min-height: 220px;
    }
    .consequence {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 767px) {
    .choice .section-heading h2 {
      font-size: clamp(56px, 14vw, 80px);
    }
    .choice .section-heading p:not(.meta) {
      margin-top: 24px;
      font-size: var(--body-large);
    }
    .formation-toolbar {
      align-items: start;
      gap: 16px;
      margin-top: 40px;
    }
    .formation-toolbar > div {
      display: contents;
    }
    .formation-toolbar h3 {
      grid-area: 1 / 1;
      max-width: 15ch;
      font-size: var(--body-large);
    }
    .choice-hint {
      grid-area: 2 / 1 / 3 / -1;
      max-width: 54ch;
      margin: 0;
    }
    .reset {
      grid-area: 1 / 2;
      padding: 10px 14px;
      font-size: var(--text-label);
    }
    .reset span {
      margin-left: 6px;
    }
    .selection-status {
      grid-row: 3;
      font-size: var(--text-label);
      min-height: 3em;
    }
    .choice-grid {
      gap: 28px;
      margin-top: 20px;
    }
    .board-tag {
      font-size: var(--text-label);
    }
    .choice-field {
      --node-height: 144px;
      --bridge-height: 144px;
      column-gap: 16px;
      margin-top: 20px;
    }
    .board-choice,
    .board-choice[data-node] {
      padding: 18px 18px 18px 20px;
      gap: 10px;
    }
    .board-choice[data-node='market'],
    .board-choice[data-node='ai'] {
      padding-left: 16px;
    }
    .shape-title,
    .status-word {
      font-size: var(--text-label);
    }
    .choice-mark {
      top: 16px;
      right: 18px;
    }
    .shape-name {
      font-size: clamp(18px, 5.8cqi, 26px);
    }
    .dependency-label {
      font-size: var(--text-label);
    }
    .constraint-ring {
      width: 60%;
      min-height: 38px;
    }
    .constraint-label {
      font-size: var(--text-label);
    }
    .constraint-note {
      font-size: var(--text-label);
    }
    .board-tail {
      gap: 8px 16px;
      font-size: var(--text-label);
      padding-top: 20px;
    }
    .choice-details {
      margin-top: 20px;
    }
    .empty-choice,
    .choice-detail {
      padding: 20px;
    }
    .choice-details h4 {
      font-size: var(--body-large);
    }
    .consequence {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 24px;
    }
  }
  @media (max-width: 375px) {
    .board-choice[data-node] {
      padding-inline: 14px;
    }
    .board-choice[data-node='customers'],
    .board-choice[data-node='reliability'] {
      padding-left: 18px;
    }
    .shape-title {
      font-size: var(--text-label);
    }
    .choice-mark {
      right: 16px;
    }
    .shape-name {
      font-size: var(--body);
    }
  }
</style>
