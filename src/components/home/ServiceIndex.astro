---
import Arrow from '../Arrow.astro';
import { services, learningOptions } from '../../data/practice';

// One line each, taken from the practice's existing service and learning copy.
const summaries: Record<string, string> = {
  'strategic-decision-design': 'Resolve competing priorities. Make the trade-offs explicit.',
  'behavioural-design': 'Begin with what people actually do.',
  'human-ai-decision-design': 'Define where people decide, review and remain accountable.',
};
const learningLines = [
  'Bring competing perspectives into the same conversation.',
  'Five strategic questions, from what success means to how decisions are governed.',
  'Compare three proposals, question the assumptions and defend a recommendation.',
];
const learningTitles = ['Decision workshops.', 'Executive masterclass.', 'Self-paced learning.'];

const rows = [
  ...services.map(service => ({ title: service.title, line: summaries[service.id], href: `/services/#${service.id}` })),
  ...learningOptions.map((option, index) => ({ title: learningTitles[index], line: learningLines[index], href: option.href })),
].map((row, index) => ({ ...row, number: String(index + 1).padStart(2, '0') }));
---
<section class="service-index section-y" id="practice" aria-labelledby="service-index-title">
  <span id="work" aria-hidden="true"></span><span id="learning" aria-hidden="true"></span>
  <div class="wrap">
    <div class="index-head">
      <h2 class="section-title" id="service-index-title" data-reveal>Decide.<br />Make it happen.</h2>
      <p class="index-note">Three areas of practice. Three ways to learn alongside them.</p>
    </div>
    <ol class="index-list" role="list">
      {rows.map(row => (
        <li>
          <a href={row.href}>
            <span class="index-number">{row.number}</span>
            <span class="index-title">{row.title}</span>
            <span class="index-line">{row.line}</span>
            <Arrow class="index-arrow" />
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .index-head { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--grid-gap); align-items: end; }
  .index-note { max-width: 28ch; justify-self: end; font-size: var(--body); line-height: 1.45; color: var(--muted); }
  .index-list { margin: var(--space-sm) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .index-list a {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: baseline;
    padding-block: 28px 32px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .index-list a:before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    z-index: -1;
    background: var(--signal);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform .6s var(--out);
  }
  .index-number { grid-column: 1 / 2; font: 400 12px/1.5 var(--mono); letter-spacing: .06em; }
  .index-title { grid-column: 2 / 8; font-size: var(--heading-3); font-weight: 600; line-height: 1.05; letter-spacing: -.05em; }
  .index-line { grid-column: 8 / 12; font-size: var(--body); line-height: 1.45; color: var(--muted); transition: color .6s var(--out); }
  .index-list :global(.index-arrow) { grid-column: 12 / 13; justify-self: end; align-self: center; font-size: 32px; transition: transform .6s var(--out); }
  .index-list a:focus-visible { outline-offset: -3px; }
  .index-list a:focus-visible:before { transform: scaleY(1); }
  .index-list a:focus-visible .index-line { color: var(--ink); }
  @media (hover: hover) and (pointer: fine) {
    .index-list a:hover:before { transform: scaleY(1); }
    .index-list a:hover .index-line { color: var(--ink); }
    .index-list a:hover :global(.index-arrow) { transform: rotate(45deg); }
  }
  @media (max-width: 1023px) {
    .index-title { grid-column: 2 / 12; }
    .index-line { grid-column: 2 / 12; }
    .index-list :global(.index-arrow) { grid-row: 1; }
  }
  @media (max-width: 767px) {
    .index-head { grid-template-columns: 1fr; gap: 24px; }
    .index-note { justify-self: start; }
    .index-list { margin-top: 40px; }
    .index-list a { grid-template-columns: 40px minmax(0, 1fr) 24px; gap: 8px 12px; padding-block: 22px 24px; }
    .index-list a:before { inset-inline: -20px; }
    .index-number { grid-column: 1; }
    .index-title { grid-column: 2; font-size: 30px; }
    .index-line { grid-column: 2; font-size: 16px; }
    .index-list :global(.index-arrow) { grid-column: 3; font-size: 22px; }
  }
</style>
