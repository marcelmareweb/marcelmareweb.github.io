---
import Arrow from './Arrow.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { enquiryInterests, courseModuleNames } from '../lib/contact';
import { masterclassDays, masterclassTitle } from '../data/executive-masterclass';
interface Props {
  defaultEngagement?: string;
  standalone?: boolean;
  heading?: string;
  lead?: string;
}
const {
  defaultEngagement = '',
  standalone = false,
  heading = 'What needs deciding?',
  lead = 'Bring the alternatives, the assumptions and the difficult questions.',
} = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
const ConfirmationHeading = standalone ? 'h2' : 'h3';
const defaultInterest = enquiryInterests.find(item => item.value === defaultEngagement)?.id ?? '';
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const inquiryEndpoint = import.meta.env.PUBLIC_INQUIRY_ENDPOINT ?? '';
---
<section id="book" class:list={['booking-section section-y theme-grey', { 'booking-section--standalone': standalone }]} aria-labelledby="booking-title">
  <div class="wrap">
    {standalone && <Breadcrumbs />}
    <div class="booking-layout">
      <div class="booking-copy">
        <Heading id="booking-title">{heading}</Heading>
        <p class="lead">{lead}</p>
        <a class="booking-email" href="mailto:hello@thespottedape.com"><span class="nowrap">hello@thespottedape.com <Arrow /></span></a>
        <p class="meta">Marcel Maré / Cape Town, South Africa</p>
      </div>
      <form class="inquiry-form" action="https://formsubmit.co/hello@thespottedape.com" method="POST" data-inquiry-form data-default-interest={defaultInterest} data-web3forms-key={web3FormsKey} data-endpoint={inquiryEndpoint}>
        <div class="sr-only" aria-hidden="true">
          <label for="inquiry-botcheck">Leave this blank</label>
          <input id="inquiry-botcheck" type="text" name="botcheck" tabindex="-1" autocomplete="off" />
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="_captcha" value="false" /><input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_subject" value="The Spotted Ape enquiry" />
        <input type="hidden" name="programme" data-programme-value data-programme-title={masterclassTitle} />
        <div class="enquiry-context form-wide" data-enquiry-context hidden>
          <p class="meta">About your enquiry</p>
          <p data-module-status role="status" aria-live="polite"></p>
          <div><a href="#inquiry-engagement" data-change-context>Change the subject</a><a href="/services/" data-context-return>Back to the offering</a></div>
        </div>
        <div><label for="inquiry-name">Name</label><input class="inquiry-field" id="inquiry-name" name="name" autocomplete="name" required /></div>
        <div><label for="inquiry-email">Email</label><input class="inquiry-field" id="inquiry-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="form-wide">
          <label for="inquiry-context">What would you like to explore?</label>
          <textarea class="inquiry-field" id="inquiry-context" name="context" rows="5" required></textarea>
        </div>
        <div class="form-wide">
          <label for="inquiry-engagement">Area of interest <span>(optional)</span></label>
          <select class="inquiry-field" id="inquiry-engagement" name="engagement">
            <option value="">I’m not sure yet</option>
            {enquiryInterests.map(item => <option value={item.value} selected={item.value === defaultEngagement}>{item.label}</option>)}
          </select>
        </div>
        <div class="form-wide" data-programme-day-field>
          <label for="inquiry-day">Working day <span>(optional)</span></label>
          <select class="inquiry-field" id="inquiry-day" name="programmeDay" data-programme-day>
            <option value="">The complete programme / Not sure yet</option>
            {masterclassDays.map(day => <option value={day.id}>Day {day.number} / {day.stage} — {day.question}</option>)}
          </select>
        </div>
        <div class="form-wide" data-course-module-field>
          <label for="inquiry-module">Course module <span>(optional)</span></label>
          <select class="inquiry-field" id="inquiry-module" name="courseModule" data-course-module-value>
            <option value="">The complete learning case / Not sure yet</option>
            {courseModuleNames.map((name, index) => <option value={String(index + 1).padStart(2, '0')}>Module {String(index + 1).padStart(2, '0')} — {name}</option>)}
          </select>
        </div>
        <div class="form-wide" data-attendance-field>
          <label for="inquiry-attendance">I’m enquiring for <span>(optional)</span></label>
          <select class="inquiry-field" id="inquiry-attendance" name="attendance" data-attendance>
            <option value="">Not specified</option><option value="individual">Myself / Ask about attendance options</option><option value="team">A team or organisation</option>
          </select>
        </div>
        <details class="form-wide form-more">
          <summary>Add your organisation and team size <span>(optional)</span></summary>
          <div class="form-more-fields">
            <div><label for="inquiry-role-organization">Role &amp; organisation <span>(optional)</span></label><input class="inquiry-field" id="inquiry-role-organization" name="roleOrganization" autocomplete="organization" /></div>
            <div>
              <label for="inquiry-team-size">Team size <span>(optional)</span></label>
              <select class="inquiry-field" id="inquiry-team-size" name="teamSize"><option value="">Not specified</option><option>1–10</option><option>11–50</option><option>50+</option></select>
            </div>
          </div>
        </details>
        <div class="form-wide">
          <button class="button" type="submit" data-submit-button>Send enquiry <Arrow /></button>
          <p class="form-note">We’ll use these details to respond by email and discuss the next step. <a href="/privacy">Privacy policy</a>.</p>
          <p class="inquiry-status" role="status" aria-live="polite" data-inquiry-status></p>
          <div class="inquiry-confirmation" data-inquiry-confirmation hidden><ConfirmationHeading>Thank you.</ConfirmationHeading><p>Your enquiry has been submitted. We’ll reply to the email address you provided.</p></div>
          <a class="text-link" href="mailto:hello@thespottedape.com" data-email-fallback hidden>Send your enquiry by email <Arrow /></a>
        </div>
      </form>
    </div>
  </div>
</section>
<script>
  import '../scripts/enquiry-form';
</script>
<style>
.booking-section--standalone { padding-block: var(--space-sm) var(--space-lg); }
.enquiry-context { padding: 20px 24px; border: 1px solid var(--line); border-top: 4px solid var(--signal); background: var(--paper); }
.enquiry-context > .meta { color: var(--muted); font-size: var(--text-label); }
.enquiry-context [data-module-status] { margin-top: 12px; font-size: var(--body); line-height: 1.4; font-weight: 500; }
.enquiry-context > div { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 8px; font-size: var(--text-small); }
.enquiry-context > div a { display: inline-flex; align-items: center; min-height: var(--control-height-compact); }

.booking-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
}
.booking-copy :is(h1, h2) {
  font-size: var(--heading-1);
  line-height: 0.95;
  max-width: 13ch;
}
.booking-email {
  font-size: clamp(18px, 2.2vw, 32px);
  letter-spacing: -0.022em;
  display: inline-block;
  min-height: 44px;
  margin-top: 48px;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 12px;
  overflow-wrap: anywhere;
}
.booking-copy > .meta {
  margin-top: 24px;
  color: var(--muted);
}
.booking-copy .lead {
  margin-top: 48px;
  max-width: 26ch;
}
.inquiry-form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.form-more {
  border-top: 1px solid var(--line);
}
.form-more summary {
  padding-block: 14px;
  font-weight: 600;
}
.form-more summary span {
  font-weight: 400;
  color: var(--text-muted);
}
.form-more-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  padding-top: 12px;
}
.inquiry-form label {
  display: block;
  font-size: var(--text-ui);
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 12px;
}
.inquiry-form label span {
  font-weight: 400;
  color: var(--muted);
}
.form-wide {
  grid-column: 1/-1;
}
.form-note {
  font-size: var(--text-small);
  color: var(--muted);
  line-height: var(--leading-copy);
  max-width: 52ch;
  margin-top: 24px;
}
.inquiry-status {
  font-size: var(--text-ui);
  margin-top: 24px;
  max-width: 50ch;
}
.inquiry-status:empty {
  display: none;
}
.inquiry-confirmation {
  border-top: 1px solid var(--muted-inverse);
  margin-top: 32px;
  padding-top: 24px;
}
.inquiry-confirmation :is(h2, h3) {
  font-size: var(--compact-md);
}
.inquiry-confirmation p {
  font-size: var(--body);
  line-height: var(--leading-copy);
  margin-top: 16px;
}
.module-context {
  font-size: var(--text-small);
  border-left: 1px solid var(--ink);
  padding-left: 16px;
}
.inquiry-form [data-email-fallback] {
  margin-top: 24px;
}
@media (max-width: 1023px) {
  .booking-layout {
    grid-template-columns: 1fr;
    gap: 64px;
  }
  .booking-copy :is(h1, h2) {
    font-size: 80px;
    max-width: 18ch;
  }
  .booking-copy .lead {
    max-width: 40ch;
  }
  .inquiry-form {
    max-width: 100%;
  }
}
@media (max-width: 767px) {
  .form-more-fields { grid-template-columns: 1fr; }
  .booking-section--standalone { padding-top: 32px; }
  .booking-section--standalone .booking-layout { gap: 32px; }
  .booking-section--standalone .booking-copy .lead { margin-top: 24px; }
  .booking-section--standalone .booking-email { margin-top: 24px; padding-bottom: 8px; }
  .booking-section--standalone .booking-copy > .meta { margin-top: 16px; }
  .booking-copy :is(h1, h2) {
    font-size: var(--compact-xl);
    max-width: 12ch;
  }
  .booking-email {
    margin-top: 32px;
    font-size: var(--body-large);
  }
  .booking-copy .lead {
    margin-top: 32px;
  }
  .inquiry-form {
    grid-template-columns: 1fr;
  }
  .form-wide {
    grid-column: auto;
  }
  .booking-layout {
    gap: 48px;
  }
  .inquiry-form label {
    font-size: var(--text-ui);
  }
}
</style>
