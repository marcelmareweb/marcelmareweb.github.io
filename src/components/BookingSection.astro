---
import { getCollection } from 'astro:content';

interface Props {
  defaultEngagement?: string;
  eyebrow?: string;
}

const {
  defaultEngagement = '',
  eyebrow = '08 / START A CONVERSATION',
} = Astro.props;

const stages = (await getCollection('stages')).sort((first, second) => first.data.order - second.data.order);
const inquiryEndpoint = import.meta.env.PUBLIC_INQUIRY_ENDPOINT ?? '';

const engagements = [
  'Raykis Strategic Decision Workshop',
  'Behavioural Design & Research',
  'Human Judgement in AI Governance',
  'The !Kharos Masterclass Series',
  'Executive Advisory Conversation',
];
---

<section id="book" class="section-y scroll-mt-24 border-b border-[var(--border-subtle)] bg-[var(--bg-primary)]" aria-labelledby="booking-title">
  <div class="editorial-container">
    <div class="mb-14 grid gap-6 lg:grid-cols-[7fr_5fr] lg:items-end lg:gap-16">
      <div>
        <p class="technical-label mb-4 text-[11px] tracking-widest text-[var(--accent-signal)] sm:text-xs">{eyebrow}</p>
        <h2 id="booking-title" class="h2 max-w-[18ch] text-[var(--text-primary)]">
          Steady hands when it matters. <em>Then we get out of the way.</em>
        </h2>
      </div>
      <div>
        <p class="p-body max-w-[56ch]">
          Curiosity first. We do not arrive with a predetermined menu of programmes. We begin with a candid conversation about your circumstances, the decisions ahead, and where your team needs formation.
        </p>
      </div>
    </div>

    <div class="grid border-y border-[var(--border-subtle)] lg:grid-cols-[0.85fr_1.15fr]">
      <div class="py-8 sm:py-10 lg:border-r lg:border-[var(--border-subtle)] lg:pr-10">
        <p class="technical-label mb-4 text-[11px] tracking-widest text-[var(--accent-signal)]">DIRECT PRINCIPAL CONNECT</p>
        <a class="font-editorial text-2xl text-[var(--text-primary)] underline decoration-[var(--accent-ochre)] underline-offset-4 transition-colors hover:text-[var(--accent-signal)] sm:text-3xl" href="mailto:contact@spottedape.com">
          contact@spottedape.com
        </a>
        <p class="technical-label mt-6 inline-flex items-center gap-3 text-[11px] tracking-widest text-[var(--text-muted)]">
          <span class="h-2 w-2 rounded-full bg-[var(--accent-signal)]" aria-hidden="true"></span>
          MARCEL MARÉ • CAPE TOWN, SOUTH AFRICA
        </p>

        <div class="mt-10 border-t border-[var(--border-subtle)] pt-7">
          <h3 class="font-editorial mb-6 text-2xl leading-tight text-[var(--text-primary)] sm:text-3xl">What happens in an initial conversation</h3>
          <ul class="m-0 flex list-none flex-col gap-5 p-0">
            <li class="flex gap-4 text-sm leading-6 text-[var(--text-muted)] sm:text-base sm:leading-7">
              <span class="technical-label pt-1 text-[11px] text-[var(--accent-signal)]">01</span>
              A candid look at the competing priorities, strategic choices, or technological pressures your team is navigating.
            </li>
            <li class="flex gap-4 text-sm leading-6 text-[var(--text-muted)] sm:text-base sm:leading-7">
              <span class="technical-label pt-1 text-[11px] text-[var(--accent-signal)]">02</span>
              Clarity on where human judgement, behavioural insight, or a Raykis Strategic Decision Workshop will create the most leverage.
            </li>
            <li class="flex gap-4 text-sm leading-6 text-[var(--text-muted)] sm:text-base sm:leading-7">
              <span class="technical-label pt-1 text-[11px] text-[var(--accent-signal)]">03</span>
              A straightforward recommendation on how to proceed—and how we will step aside once your team has steady hands on the wheel.
            </li>
          </ul>
        </div>
      </div>

      <div class="border-t border-[var(--border-subtle)] py-8 sm:py-10 lg:border-l-0 lg:border-t-0 lg:pl-10">
        <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="technical-label mb-3 text-[11px] tracking-widest text-[var(--accent-signal)]">INITIATE BRIEFING</p>
            <h3 class="font-editorial text-3xl text-[var(--text-primary)]">Tell us what you are navigating.</h3>
          </div>
          <span class="technical-label text-[11px] tracking-widest text-[var(--text-muted)]">DIRECT INQUIRY</span>
        </div>

        <form
          class="grid gap-x-5 gap-y-5 sm:grid-cols-2"
          action="mailto:contact@spottedape.com?subject=Executive%20Workshop%20Inquiry"
          method="post"
          enctype="text/plain"
          data-inquiry-form
          data-endpoint={inquiryEndpoint}
        >
          <div>
            <label class="mb-2 block text-xs font-semibold text-[var(--text-primary)]" for="inquiry-name">Name <span aria-hidden="true">*</span></label>
            <input class="inquiry-field" id="inquiry-name" name="name" autocomplete="name" required />
          </div>
          <div>
            <label class="mb-2 block text-xs font-semibold text-[var(--text-primary)]" for="inquiry-role-organization">Role &amp; Organization <span aria-hidden="true">*</span></label>
            <input class="inquiry-field" id="inquiry-role-organization" name="roleOrganization" autocomplete="organization-title" required />
          </div>
          <div>
            <label class="mb-2 block text-xs font-semibold text-[var(--text-primary)]" for="inquiry-team-size">Team Size</label>
            <select class="inquiry-field" id="inquiry-team-size" name="teamSize">
              <option value="">Select team size</option>
              <option>1–10</option>
              <option>11–50</option>
              <option>50+</option>
            </select>
          </div>
          <div>
            <label class="mb-2 block text-xs font-semibold text-[var(--text-primary)]" for="inquiry-engagement">Target Focus</label>
            <select class="inquiry-field" id="inquiry-engagement" name="engagement" required>
              <option value="">Select an area of focus</option>
              {engagements.map((engagement) => (
                <option value={engagement} selected={engagement === defaultEngagement}>{engagement}</option>
              ))}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="mb-2 block text-xs font-semibold text-[var(--text-primary)]" for="booking-stage-select">Target Maturity Stage</label>
            <select class="inquiry-field" id="booking-stage-select" name="targetStage">
              <option value="">Not sure yet</option>
              {stages.map(({ data }) => (
                <option value={data.stageNumber}>{data.stageNumber} — {data.title} / {data.automationLevel}</option>
              ))}
            </select>
            <p class="mt-2 text-xs text-[var(--accent-signal)]" aria-live="polite" data-stage-selection-status></p>
          </div>
          <div class="sm:col-span-2">
            <label class="mb-2 block text-xs font-semibold text-[var(--text-primary)]" for="inquiry-context">Primary Constraint / Context <span aria-hidden="true">*</span></label>
            <textarea class="inquiry-field min-h-32 resize-y py-3" id="inquiry-context" name="context" rows="4" required></textarea>
          </div>
          <div class="sm:col-span-2">
            <button class="inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-3 bg-[var(--accent-signal)] px-7 text-sm font-semibold text-[var(--text-on-accent)] transition-colors hover:bg-[var(--accent-signal-hover)] sm:w-auto" type="submit" data-submit-button>
              Send Executive Inquiry <span aria-hidden="true">→</span>
            </button>
            <p class="mt-4 text-xs leading-5 text-[var(--text-muted)]" role="status" aria-live="polite" data-inquiry-status></p>
            <a class="hidden text-sm font-semibold text-[var(--accent-signal)] underline underline-offset-4" href="mailto:contact@spottedape.com" data-email-fallback>
              Email contact@spottedape.com
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const inquiryForm = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  const inquiryStatus = document.querySelector<HTMLElement>('[data-inquiry-status]');
  const emailFallback = document.querySelector<HTMLAnchorElement>('[data-email-fallback]');
  const submitButton = document.querySelector<HTMLButtonElement>('[data-submit-button]');
  const engagementSelect = document.querySelector<HTMLSelectElement>('#inquiry-engagement');
  const maturitySelect = document.querySelector<HTMLSelectElement>('#booking-stage-select');
  const stageSelectionStatus = document.querySelector<HTMLElement>('[data-stage-selection-status]');

  const applyStageSelection = (stageNumber: string, stageTitle?: string) => {
    if (!maturitySelect) return;
    const selectedOption = Array.from(maturitySelect.options).find((option) => option.value === stageNumber);
    if (!selectedOption) return;

    maturitySelect.value = stageNumber;
    maturitySelect.dispatchEvent(new Event('change', { bubbles: true }));
    if (stageSelectionStatus) {
      const label = stageTitle ?? selectedOption.textContent?.trim() ?? '';
      stageSelectionStatus.textContent = `Stage ${stageNumber} (${label}) pre-selected for your workshop inquiry.`;
    }
  };

  // Support URL query parameters (?stage=01&focus=raykis)
  const params = new URLSearchParams(window.location.search);
  const queryStage = params.get('stage');
  const queryFocus = params.get('focus');
  if (queryFocus === 'raykis' && engagementSelect) {
    engagementSelect.value = 'Raykis Strategic Decision Workshop';
  }
  if (queryStage) {
    applyStageSelection(queryStage);
  }

  window.addEventListener('select-stage', (event) => {
    if (!(event instanceof CustomEvent)) return;
    const stageNumber = String(event.detail?.stageNumber ?? '');
    const stageTitle = event.detail?.stageTitle ? String(event.detail.stageTitle) : undefined;
    if (engagementSelect && !engagementSelect.value) {
      engagementSelect.value = 'Raykis Strategic Decision Workshop';
    }
    applyStageSelection(stageNumber, stageTitle);
  });

  const openEmailDraft = (formData: FormData) => {
    const value = (name: string) => String(formData.get(name) ?? 'Not provided');
    const subject = `Executive inquiry: ${value('engagement')}`;
    const message = [
      'EXECUTIVE WORKSHOP INQUIRY',
      '',
      `Name: ${value('name')}`,
      `Role & Organization: ${value('roleOrganization')}`,
      `Team Size: ${value('teamSize')}`,
      `Target Engagement: ${value('engagement')}`,
      `Target Maturity Stage: ${value('targetStage')}`,
      '',
      'Primary Constraint / Context:',
      value('context'),
    ].join('\n');

    if (inquiryStatus) inquiryStatus.textContent = 'Opening a structured inquiry in your email application.';
    if (emailFallback) emailFallback.classList.remove('hidden');
    window.location.href = `mailto:contact@spottedape.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
  };

  inquiryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!inquiryForm.reportValidity()) return;

    const formData = new FormData(inquiryForm);
    const endpoint = inquiryForm.dataset.endpoint;
    if (!endpoint) {
      openEmailDraft(formData);
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending inquiry…';
    }
    if (inquiryStatus) inquiryStatus.textContent = 'Sending your inquiry securely.';

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(Object.fromEntries(formData.entries())),
      });

      if (!response.ok) throw new Error(`Inquiry endpoint returned ${response.status}.`);
      if (inquiryStatus) inquiryStatus.textContent = 'Thank you. Your inquiry has been received.';
      inquiryForm.reset();
      if (stageSelectionStatus) stageSelectionStatus.textContent = '';
    } catch {
      openEmailDraft(formData);
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.innerHTML = 'Send Executive Inquiry <span aria-hidden="true">→</span>';
      }
    }
  });
</script>

<style>
  .inquiry-field {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--border-subtle);
    border-radius: 0;
    background: var(--bg-primary);
    padding: 0.75rem;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.875rem;
  }

  .inquiry-field:focus-visible {
    outline: 2px solid var(--accent-kharos);
    outline-offset: 2px;
  }

  [data-submit-button]:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  [data-submit-button]:disabled {
    cursor: wait;
    opacity: 0.65;
  }
</style>
