---
interface Props {
  defaultEngagement?: string;
  eyebrow?: string;
}
const { defaultEngagement = '', eyebrow = 'Let’s talk' } = Astro.props;
const engagements = [
  'Strategic Decision Workshop',
  'Strategy Course (DLA)',
  'Behavioural Design & Research',
  'Human–AI Decision Design',
  'Executive Advisory Conversation',
];
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const inquiryEndpoint = import.meta.env.PUBLIC_INQUIRY_ENDPOINT ?? '';
---
<section id="book" class="booking-section section-y theme-grey" aria-labelledby="booking-title">
<div class="wrap">
<div class="section-top meta">
<p>{eyebrow}</p>
<p>Start with the decision</p>
</div>
<div class="booking-layout">
<div class="booking-copy">
<h2 id="booking-title">What does your team need to decide?</h2>
<a class="booking-email" href="mailto:hello@thespottedape.com">hello@thespottedape.com ↗</a>
<p class="meta">Marcel Maré / Cape Town, South Africa</p>
<p class="lead">Bring the alternatives, the assumptions and the difficult questions.</p>
</div>
<form class="inquiry-form" action="https://formsubmit.co/hello@thespottedape.com" method="POST" data-inquiry-form data-web3forms-key={web3FormsKey} data-endpoint={inquiryEndpoint}>
<div class="sr-only" aria-hidden="true">
<label for="inquiry-botcheck">Leave this blank</label>
<input id="inquiry-botcheck" type="text" name="botcheck" tabindex="-1" autocomplete="off" />
<input type="text" name="_honey" tabindex="-1" autocomplete="off" />
</div>
<input type="hidden" name="_captcha" value="false" />
<input type="hidden" name="_template" value="table" />
<input type="hidden" name="courseModule" data-course-module-value />
<div>
<label for="inquiry-name">Name</label>
<input class="inquiry-field" id="inquiry-name" name="name" autocomplete="name" required />
</div>
<div>
<label for="inquiry-email">Work email</label>
<input class="inquiry-field" id="inquiry-email" name="email" type="email" autocomplete="email" required />
</div>
<div class="form-wide">
<label for="inquiry-role-organization">Role &amp; organisation</label>
<input class="inquiry-field" id="inquiry-role-organization" name="roleOrganization" autocomplete="organization" required />
</div>
<div>
<label for="inquiry-engagement">Area of interest</label>
<select class="inquiry-field" id="inquiry-engagement" name="engagement" required>
<option value="">Choose an area</option>{engagements.map(item=>
<option value={item} selected={item===defaultEngagement}>{item}</option>)}</select>
</div>
<div>
<label for="inquiry-team-size">Team size <span>(optional)</span>
</label>
<select class="inquiry-field" id="inquiry-team-size" name="teamSize">
<option value="">Choose team size</option>
<option>1–10</option>
<option>11–50</option>
<option>50+</option>
</select>
</div>
<p class="form-wide module-context" data-module-status hidden>
</p>
<div class="form-wide">
<label for="inquiry-context">What needs deciding?</label>
<textarea class="inquiry-field" id="inquiry-context" name="context" rows="5" required>
</textarea>
</div>
<div class="form-wide">
<button class="button" type="submit" data-submit-button>Send enquiry <span aria-hidden="true">↗</span>
</button>
<p class="form-note">We’ll use these details to respond to your enquiry. <a href="/privacy">Privacy policy</a>.</p>
<p class="inquiry-status" role="status" aria-live="polite" data-inquiry-status>
</p>
<div class="inquiry-confirmation" data-inquiry-confirmation hidden>
<h3>Thank you.</h3>
<p>Your enquiry has been submitted. We’ll reply to the email address you provided.</p>
</div>
<a class="text-link" href="mailto:hello@thespottedape.com" data-email-fallback hidden>Send your enquiry by email ↗</a>
</div>
</form>
</div>
</div>
</section>
<script>
const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
if (form) {
  const status = form.querySelector<HTMLElement>('[data-inquiry-status]')!;
  const confirmation = form.querySelector<HTMLElement>('[data-inquiry-confirmation]')!;
  const fallback = form.querySelector<HTMLAnchorElement>('[data-email-fallback]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit-button]')!;
  const engagement = form.querySelector<HTMLSelectElement>('#inquiry-engagement')!;
  const moduleValue = form.querySelector<HTMLInputElement>('[data-course-module-value]')!;
  const moduleStatus = form.querySelector<HTMLElement>('[data-module-status]')!;
  const selectModule = (number: string, title = '') => {
    if (!/^0[1-6]$/.test(number)) return;
    moduleValue.value = number;
    engagement.value = 'Strategy Course (DLA)';
    moduleStatus.hidden = false;
    moduleStatus.textContent = `Course module ${number}${title ? ` — ${title}` : ''} selected for your cohort enquiry.`;
  };
  const params = new URLSearchParams(location.search);
  const moduleParam = params.get('module');
  if (moduleParam) selectModule(moduleParam.padStart(2, '0'));
  if (params.get('focus') === 'workshops') engagement.value = 'Strategic Decision Workshop';
  window.addEventListener('select-course-module', (event) => {
    if (event instanceof CustomEvent)
      selectModule(
        String(event.detail?.moduleNumber ?? ''),
        String(event.detail?.moduleTitle ?? ''),
      );
  });
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const clean = (key: string) => String(data.get(key) ?? '').trim();
    if (clean('botcheck') || clean('_honey')) {
      status.textContent = 'Thank you. Your enquiry has been received.';
      return;
    }
    const payload = {
      name: clean('name'),
      email: clean('email'),
      roleOrganization: clean('roleOrganization'),
      teamSize: clean('teamSize'),
      engagement: clean('engagement'),
      courseModule: clean('courseModule'),
      context: clean('context'),
      pageUrl: location.href,
    };
    const subject = `The Spotted Ape enquiry — ${payload.engagement}`;
    const emailBody = [
      `Name: ${payload.name}`,
      `Email: ${payload.email}`,
      `Role & organisation: ${payload.roleOrganization}`,
      `Team size: ${payload.teamSize || 'Not specified'}`,
      `Area: ${payload.engagement}`,
      payload.courseModule ? `Course module: ${payload.courseModule}` : '',
      '',
      payload.context,
    ]
      .filter(Boolean)
      .join('\n');
    fallback.href = `mailto:hello@thespottedape.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(emailBody)}`;
    const key = form.dataset.web3formsKey?.trim();
    const endpoint = key
      ? 'https://api.web3forms.com/submit'
      : form.dataset.endpoint?.trim() || 'https://formsubmit.co/ajax/hello@thespottedape.com';
    const body = {
      ...payload,
      subject,
      _subject: subject,
      replyto: payload.email,
      _replyto: payload.email,
      from_name: 'The Spotted Ape Website',
      ...(key
        ? { access_key: key, botcheck: '' }
        : { _captcha: 'false', _template: 'table', _honey: '' }),
    };
    submit.disabled = true;
    submit.textContent = 'Sending…';
    form.setAttribute('aria-busy', 'true');
    status.textContent = 'Sending your enquiry…';
    confirmation.hidden = true;
    fallback.hidden = true;
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await response.json().catch(() => null);
      if (
        !response.ok ||
        result?.success === false ||
        result?.success === 'false' ||
        /activate/i.test(String(result?.message ?? ''))
      )
        throw new Error('Delivery unavailable');
      form.reset();
      moduleValue.value = '';
      moduleStatus.hidden = true;
      confirmation.hidden = false;
      status.textContent = 'Enquiry submitted.';
    } catch {
      status.textContent =
        'We couldn’t send your enquiry. Please try again or use the email link below. Your details are still here.';
      fallback.hidden = false;
    } finally {
      submit.disabled = false;
      submit.innerHTML = 'Send enquiry <span aria-hidden="true">↗</span>';
      form.removeAttribute('aria-busy');
    }
  });
}
</script>
<style>
.booking-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
}
.booking-copy h2 {
  font-size: var(--heading-1);
  line-height: 0.95;
  max-width: 13ch;
}
.booking-email {
  font-size: clamp(18px, 2.2vw, 32px);
  letter-spacing: -0.035em;
  display: inline-block;
  margin-top: 48px;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 12px;
  overflow-wrap: anywhere;
}
.booking-copy > .meta {
  margin-top: 24px;
  color: #626262;
}
.booking-copy .lead {
  margin-top: 48px;
  max-width: 26ch;
}
.inquiry-form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.inquiry-form label {
  display: block;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 12px;
}
.inquiry-form label span {
  font-weight: 400;
  color: #626262;
}
.inquiry-field {
  width: 100%;
  min-width: 0;
  min-height: 56px;
  padding: 16px;
  background: #fff;
  color: var(--ink);
  border: 1px solid transparent;
  border-radius: 4px;
  font-size: 16px;
  line-height: 1.4;
}
.inquiry-field:focus-visible {
  outline: 2px solid var(--ink);
  outline-offset: 2px;
}
.inquiry-field:user-invalid {
  border-color: var(--ink);
}
textarea.inquiry-field {
  min-height: 160px;
  resize: vertical;
}
.form-wide {
  grid-column: 1/-1;
}
.form-note {
  font-size: 13px;
  color: #626262;
  line-height: 1.5;
  max-width: 52ch;
  margin-top: 24px;
}
.inquiry-status {
  font-size: 16px;
  margin-top: 24px;
  max-width: 50ch;
}
.inquiry-status:empty {
  display: none;
}
.inquiry-confirmation {
  border-top: 1px solid #bbb;
  margin-top: 32px;
  padding-top: 24px;
}
.inquiry-confirmation h3 {
  font-size: 40px;
}
.inquiry-confirmation p {
  font-size: 18px;
  line-height: 1.5;
  margin-top: 16px;
}
.module-context {
  font-size: 14px;
  border-left: 4px solid var(--signal);
  padding-left: 16px;
}
.inquiry-form [data-email-fallback] {
  margin-top: 24px;
}
@media (max-width: 1023px) {
  .booking-layout {
    grid-template-columns: 1fr;
    gap: 64px;
  }
  .booking-copy h2 {
    font-size: 80px;
    max-width: 18ch;
  }
  .booking-copy .lead {
    max-width: 40ch;
  }
  .inquiry-form {
    max-width: 100%;
  }
}
@media (max-width: 767px) {
  .booking-copy h2 {
    font-size: 56px;
    max-width: 12ch;
  }
  .booking-email {
    margin-top: 32px;
    font-size: 22px;
  }
  .booking-copy .lead {
    margin-top: 32px;
  }
  .inquiry-form {
    grid-template-columns: 1fr;
  }
  .form-wide {
    grid-column: auto;
  }
  .booking-layout {
    gap: 48px;
  }
  .inquiry-form label {
    font-size: 16px;
  }
}
</style>
