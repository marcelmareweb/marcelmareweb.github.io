---
const proposals = [
  {
    id: 'Proposal A',
    cost: 'R650,000',
    size: '60 kWp',
    generation: '92,000 kWh',
    selfConsumption: '90%',
    maintenance: 'R9,000 / yr',
    netSavingY1: 'R222,840',
    payback: '2.92 years',
    npv20: 'R2.152m',
    exposure: 'Fastest capital recovery; lowest 20-year value.',
  },
  {
    id: 'Proposal B',
    cost: 'R820,000',
    size: '80 kWp',
    generation: '121,000 kWh',
    selfConsumption: '85%',
    maintenance: 'R11,000 / yr',
    netSavingY1: 'R276,980',
    payback: '2.96 years',
    npv20: 'R2.662m',
    exposure: 'Balanced middle option; overtakes C below ~73.96% utilisation.',
  },
  {
    id: 'Proposal C',
    cost: 'R990,000',
    size: '100 kWp',
    generation: '147,000 kWh',
    selfConsumption: '78%',
    maintenance: 'R14,000 / yr',
    netSavingY1: 'R307,048',
    payback: '3.22 years',
    npv20: 'R2.871m',
    exposure: 'Highest base-case NPV; exposed to utilisation & unverified ESG claim.',
  },
];

const modules = [
  {
    number: '01',
    slug: 'understand',
    title: 'Understand',
    subtitle: 'Interpret the Inputs & Self-Consumption Bridge',
    competenceTier: 'FOUNDATIONAL COMPETENCE',
    senderCode: 'FD',
    timestamp: 'Monday 09:00 · Financial Director',
    promptHeadline: '“First, establish what we are buying—and what we can use.”',
    promptBody:
      'Check the proposal data before calculating. A larger system produces more electricity, but how much of that output will actually reduce our grid purchases?',
    summary:
      'Before entering a single formula, participants record an explicit initial prediction and examine why gross technical output (147,000 kWh for System C) does not automatically translate into economic value when unused electricity earns zero revenue.',
    analyticalMechanics:
      'Distinguishing installed capacity (60 / 80 / 100 kWp) from self-consumption (90% / 85% / 78%) as the bridge between engineering output and financial return; establishing Case Data!A3:F17 (including the R2.80/kWh tariff in B4) as the single source of truth.',
    behaviouralShift:
      'Overcoming anchoring bias on headline system size or lowest purchase price by surfacing prior intuition before touching the spreadsheet.',
    deliverable:
      'Recorded pre-model metric prediction + concept-check explanation of why neither gross generation nor self-consumption alone identifies the best investment.',
    liveUrl: 'https://marcelmare.com/dla-course-2/understand.html',
  },
  {
    number: '02',
    slug: 'spreadsheet-essentials',
    title: 'Spreadsheet Essentials',
    subtitle: 'Traceable Architecture & Reference Discipline',
    competenceTier: 'FOUNDATIONAL COMPETENCE',
    senderCode: 'FD',
    timestamp: 'Monday 09:20 · Financial Director',
    promptHeadline: '“Make the analysis traceable from the first formula.”',
    promptBody:
      'Keep the supplier inputs together and reference them in your calculations. I need to be able to follow each result back to its source.',
    summary:
      'Designed so zero prior Excel fluency is assumed while enforcing rigorous financial-modelling hygiene from the first keystroke: never retype a business input into a formula when you can reference the source cell.',
    analyticalMechanics:
      "Mastering the five core moves: cell coordinates, formula initiation (=), cross-sheet referencing ('Case Data'!B15*'Case Data'!B16), relative (B15) vs. absolute ($B$4) vs. mixed ($A8) references, and formula bar error inspection.",
    behaviouralShift:
      'Replacing fragile copy-pasted numbers with auditable, single-source-of-truth links that another analyst or auditor can verify in seconds.',
    deliverable:
      'Verified useful-generation calculation in Your Model!B4:D4 linked directly to Case Data inputs and copied cleanly across proposals.',
    liveUrl: 'https://marcelmare.com/dla-course-2/spreadsheet-essentials.html',
  },
  {
    number: '03',
    slug: 'build',
    title: 'Build',
    subtitle: 'Construct an Auditable Year-1 Comparison Model',
    competenceTier: 'PRACTICAL COMPETENCE',
    senderCode: 'FD',
    timestamp: 'Monday 09:40 · Financial Director',
    promptHeadline: '“Before we discuss long-term value, give me a clean Year-1 comparison.”',
    promptBody:
      'Show me how much generation we can use, what we save after maintenance and how quickly the initial capital is recovered. Keep the model traceable to the source data.',
    summary:
      'Participants convert operational solar data into four comparable Year-1 financial measures across Proposals A, B, and C, diagnose a colleague’s broken reference formula, and design an executive comparison chart.',
    analyticalMechanics:
      "Building the 4-step chain in Your Model!B4:D7: Useful Generation → Gross Saving (=B4*'Case Data'!$B$4: R231,840 / R287,980 / R321,048) → Net Saving after maintenance (R222,840 / R276,980 / R307,048) → Simple Payback (2.92 / 2.96 / 3.22 years), plus diagnosing why =C4*'Case Data'!C4 fails.",
    behaviouralShift:
      'Treating spreadsheet errors as structural diagnostic problems and pairing quantitative tables with purposeful visual communication.',
    deliverable:
      'Completed Your Model!B4:D7 comparison table, corrected reference-error diagnosis, 1 management chart, and a 1-sentence visual-design rationale.',
    liveUrl: 'https://marcelmare.com/dla-course-2/build.html',
  },
  {
    number: '04',
    slug: 'test',
    title: 'Test',
    subtitle: 'Sensitivity Analysis & Operational Crossover',
    competenceTier: 'PRACTICAL COMPETENCE',
    senderCode: 'TJ',
    timestamp: 'Monday 13:15 · Thandi Jacobs · Production Manager',
    promptHeadline: '“Will we really use 78% of System C’s output?”',
    promptBody:
      'Production varies during the week. If we cannot use as much solar power at the time it is generated as Supplier C assumes, does C still offer the highest net present value (NPV)?',
    summary:
      'Simple payback favours System A (2.92 years), while the 20-year DCF model favours System C (≈ R2.871m). When Operations challenges Supplier C’s 78% utilisation assumption, participants stress-test the model from 78% down to 60% to find where the ranking flips.',
    analyticalMechanics:
      'Using mixed references ($A8) in Test Assumptions!A8:E14 across 78%, 75%, 72%, 70%, 68%, 65%, and 60% scenarios; isolating the exact crossover at ≈ 73.96% (~74%) where System B (R2.662m) overtakes System C; specifying half-hourly factory load data aligned with midday solar generation.',
    behaviouralShift:
      'Interrogating the operational assumption behind the number rather than treating a 20-year DCF output as certainty.',
    deliverable:
      'Completed Test Assumptions!A7:E14 sensitivity table, exact ~73.96% crossover identification, and half-hourly load-profile verification requirement.',
    liveUrl: 'https://marcelmare.com/dla-course-2/test.html',
  },
  {
    number: '05',
    slug: 'decide',
    title: 'Decide',
    subtitle: 'Executive Briefing & Professional Scepticism',
    competenceTier: 'PRACTICAL & REFLEXIVE COMPETENCE',
    senderCode: 'FD',
    timestamp: 'Monday 15:30 · Financial Director',
    promptHeadline: '“Now turn the evidence into a recommendation.”',
    promptBody:
      'Which system should we take forward, why, and what do we still need to verify before signing? Keep your recommendation to 100 words. Separately, record the evidence you would need to assess Supplier C’s environmental claim.',
    summary:
      'The spreadsheet gives evidence; it does not choose the decision rule. Participants synthesise conflicting criteria (Payback vs. 20-year NPV vs. Utilisation risk) into a crisp executive recommendation while separating unverified ESG claims from financial fact.',
    analyticalMechanics:
      'Drafting a ≤100-word brief citing ≥2 quantified Excel metrics, 1 explicit commercial trade-off, and 1 operational condition prior to contract signature; specifying lifecycle assessment (LCA) boundaries, manufacturing impacts, service life, and independent certification for Supplier C.',
    behaviouralShift:
      'Accepting accountability for a qualified managerial judgement where no single metric offers a risk-free answer.',
    deliverable:
      '≤100-word Executive Recommendation in Recommendation!A7 + Professional Scepticism Evidence Request in Recommendation!A22.',
    liveUrl: 'https://marcelmare.com/dla-course-2/decide.html',
  },
  {
    number: '06',
    slug: 'reflect',
    title: 'Reflect',
    subtitle: 'Revisit, Explain & Transfer the Pattern',
    competenceTier: 'REFLEXIVE COMPETENCE',
    senderCode: 'FD',
    timestamp: 'Monday 16:00 · Financial Director',
    promptHeadline: '“What changed your judgement—and what remains uncertain?”',
    promptBody:
      'Explain how the model and sensitivity test changed your initial view. What would you check next, and what would you carry into our next investment decision?',
    summary:
      'Participants compare their Stage 01 intuition against their post-sensitivity recommendation, audit their formulas against the completed V8 reference workbook, and transfer the decision architecture to a new organisational challenge.',
    analyticalMechanics:
      'Applying the University of Edinburgh “What? So what? Now what?” reflective structure; auditing formula integrity against SU_DLA_Solar_Completed_Reference_Workbook_V8.xlsx; mapping Inputs → Model → Test assumptions → Interpret → Recommend to future capital choices.',
    behaviouralShift:
      'Moving permanently from spreadsheet operator to analytical adviser who knows how evidence reshapes initial intuition.',
    deliverable:
      'Completed reflective transfer synthesis + full model self-audit against the Completed Reference Workbook V8.',
    liveUrl: 'https://marcelmare.com/dla-course-2/reflect.html',
  },
];

const initialModule = modules[0];
---
<section id="syllabus" class="section-y theme-dark" aria-labelledby="syllabus-title">
<div class="wrap">
<div class="section-top meta">
<p>02 / The curriculum</p>
<p>A fictional investment case</p>
</div>
<h2 class="section-title" id="syllabus-title" data-reveal>One case.<br />One decision.</h2>
<div class="syllabus-intro">
<p class="lead">Take the seat of a commercial analyst advising the Financial Director. Compare three rooftop solar proposals costing R650,000 to R990,000.</p>
<p class="meta">65–80 minutes<br />Six modules<br />A working spreadsheet model</p>
</div>
<div class="course-table" role="region" tabindex="0" aria-label="Comparison of the three solar proposals. Scroll horizontally on small screens.">
<table>
<caption class="sr-only">Cape Manufacturing fictional case. Base-case proposal data; tariff R2.80 per kWh.</caption>
<thead>
<tr>
<th scope="col">Case data</th>{proposals.map(prop=>
<th scope="col">{prop.id}</th>)}</tr>
</thead>
<tbody>
<tr>
<th scope="row">Investment</th>{proposals.map(prop=>
<td>{prop.cost}</td>)}</tr>
<tr>
<th scope="row">System size</th>{proposals.map(prop=>
<td>{prop.size}</td>)}</tr>
<tr>
<th scope="row">Self-consumption</th>{proposals.map(prop=>
<td>{prop.selfConsumption}</td>)}</tr>
<tr>
<th scope="row">Simple payback</th>{proposals.map(prop=>
<td>{prop.payback}</td>)}</tr>
<tr>
<th scope="row">20-year NPV</th>{proposals.map(prop=>
<td>{prop.npv20}</td>)}</tr>
</tbody>
</table>
</div>
<p class="syllabus-source meta">Illustrative case data / Case Data!A3:F17 / Figures are not an investment recommendation.</p>
<div class="course-interactive" data-course-interactive hidden>
<nav class="course-tabs" role="tablist" aria-label="Course Curriculum Modules" aria-orientation="vertical">{modules.map((mod,index)=>
<button class="course-tab" type="button" role="tab" id={`course-tab-${mod.number}`} aria-controls="course-inspector" aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-course-tab data-module-number={mod.number} data-module-title={mod.title} data-module-subtitle={mod.subtitle} data-competence-tier={mod.competenceTier} data-sender-code={mod.senderCode} data-timestamp={mod.timestamp} data-prompt-headline={mod.promptHeadline} data-prompt-body={mod.promptBody} data-summary={mod.summary} data-analytical-mechanics={mod.analyticalMechanics} data-behavioural-shift={mod.behaviouralShift} data-deliverable={mod.deliverable} data-live-url={mod.liveUrl}>
<span class="meta">{mod.number}</span>
<span>{mod.title}.</span>
<span aria-hidden="true">↗</span>
</button>)}</nav>
<div id="course-inspector" class="course-panel" role="tabpanel" aria-labelledby={`course-tab-${initialModule.number}`} tabindex="0" data-course-inspector>
<p class="meta" data-course-number-label>MODULE {initialModule.number} / 06 — {initialModule.subtitle}</p>
<h3 data-course-title>{initialModule.title}</h3>
<p class="meta course-tier" data-course-tier>{initialModule.competenceTier}</p>
<div class="course-dispatch">
<div class="meta">
<span data-course-sender>{initialModule.senderCode}</span> / <span data-course-timestamp>{initialModule.timestamp}</span>
</div>
<p class="dispatch-title" data-course-prompt-headline>{initialModule.promptHeadline}</p>
<p data-course-prompt-body>{initialModule.promptBody}</p>
</div>
<p class="module-summary" data-course-value="summary">{initialModule.summary}</p>
<details class="module-detail">
<summary>Analytical &amp; spreadsheet mechanics</summary>
<p data-course-value="analyticalMechanics">{initialModule.analyticalMechanics}</p>
</details>
<details class="module-detail">
<summary>Behavioural &amp; judgement shift</summary>
<p data-course-value="behaviouralShift">{initialModule.behaviouralShift}</p>
</details>
<div class="module-output">
<p class="meta">Observable workbook evidence</p>
<p data-course-value="deliverable">{initialModule.deliverable}</p>
</div>
<div class="actions">
<a class="text-link" href={initialModule.liveUrl} target="_blank" rel="noreferrer" data-course-live-link>Open module in live course ↗</a>
<button class="button button--yellow" type="button" data-course-inquiry>
<span data-course-inquiry-label>Commission Module {initialModule.number} Cohort</span>
<span aria-hidden="true">↗</span>
</button>
</div>
</div>
</div>
<div class="course-fallback" data-course-fallback>{modules.map(mod=>
<details>
<summary>{mod.number} / {mod.title}</summary>
<p>{mod.summary}</p>
<p>{mod.deliverable}</p>
<a href={mod.liveUrl}>Open module in live course ↗</a>
</details>)}</div>
</div>
</section>
<script>
const courseTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-course-tab]'));
const courseInspector = document.querySelector<HTMLElement>('[data-course-inspector]');

const selectCourseModule = (moduleNumber: string, shouldScrollMobile = false) => {
  const selectedTab = courseTabs.find((tab) => tab.dataset.moduleNumber === moduleNumber);
  if (!selectedTab || !courseInspector) return;

  courseTabs.forEach((tab) => {
    const isSelected = tab === selectedTab;
    tab.setAttribute('aria-selected', String(isSelected));
    tab.tabIndex = isSelected ? 0 : -1;
  });

  courseInspector.setAttribute('aria-labelledby', selectedTab.id);
  const mod = selectedTab.dataset;

  const title = courseInspector.querySelector<HTMLElement>('[data-course-title]');
  const numberLabel = courseInspector.querySelector<HTMLElement>('[data-course-number-label]');
  const tier = courseInspector.querySelector<HTMLElement>('[data-course-tier]');
  const sender = courseInspector.querySelector<HTMLElement>('[data-course-sender]');
  const timestamp = courseInspector.querySelector<HTMLElement>('[data-course-timestamp]');
  const promptHeadline = courseInspector.querySelector<HTMLElement>(
    '[data-course-prompt-headline]',
  );
  const promptBody = courseInspector.querySelector<HTMLElement>('[data-course-prompt-body]');
  const liveLink = courseInspector.querySelector<HTMLAnchorElement>('[data-course-live-link]');
  const inquiryLabel = courseInspector.querySelector<HTMLElement>('[data-course-inquiry-label]');

  if (title) title.textContent = mod.moduleTitle ?? '';
  if (numberLabel)
    numberLabel.textContent = `MODULE ${mod.moduleNumber} / 06 — ${mod.moduleSubtitle ?? ''}`;
  if (tier) tier.textContent = mod.competenceTier ?? '';
  if (sender) sender.textContent = mod.senderCode ?? '';
  if (timestamp) timestamp.textContent = mod.timestamp ?? '';
  if (promptHeadline) promptHeadline.textContent = mod.promptHeadline ?? '';
  if (promptBody) promptBody.textContent = mod.promptBody ?? '';
  if (liveLink && mod.liveUrl) liveLink.href = mod.liveUrl;
  if (inquiryLabel) inquiryLabel.textContent = `Commission Module ${mod.moduleNumber} Cohort`;

  for (const field of ['summary', 'analyticalMechanics', 'behaviouralShift', 'deliverable']) {
    const target = courseInspector.querySelector<HTMLElement>(`[data-course-value="${field}"]`);
    const value = mod[field];
    if (target && value) target.textContent = value;
  }

  if (shouldScrollMobile && window.innerWidth < 1024) {
    const rect = courseInspector.getBoundingClientRect();
    if (rect.top > window.innerHeight * 0.7 || rect.bottom < 0) {
      courseInspector.scrollIntoView({
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
        block: 'nearest',
      });
    }
  }
};

courseTabs.forEach((tab, index) => {
  tab.addEventListener('click', () => selectCourseModule(tab.dataset.moduleNumber ?? '', true));
  tab.addEventListener('keydown', (event) => {
    const key = event.key;
    let nextIndex = index;

    if (key === 'ArrowDown') nextIndex = (index + 1) % courseTabs.length;
    else if (key === 'ArrowUp') nextIndex = (index - 1 + courseTabs.length) % courseTabs.length;
    else if (key === 'Home') nextIndex = 0;
    else if (key === 'End') nextIndex = courseTabs.length - 1;
    else return;

    event.preventDefault();
    const nextTab = courseTabs[nextIndex];
    selectCourseModule(nextTab.dataset.moduleNumber ?? '');
    nextTab.focus();
  });
});

const courseInquiryButton = document.querySelector<HTMLButtonElement>('[data-course-inquiry]');
courseInquiryButton?.addEventListener('click', () => {
  const selectedTab = courseTabs.find((tab) => tab.getAttribute('aria-selected') === 'true');
  if (!selectedTab) return;

  window.dispatchEvent(
    new CustomEvent('select-course-module', {
      detail: {
        moduleNumber: selectedTab.dataset.moduleNumber,
        moduleTitle: selectedTab.dataset.moduleTitle,
      },
    }),
  );
  document
    .querySelector('#book')
    ?.scrollIntoView({
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      block: 'start',
    });
});

const initialModuleParam = new URLSearchParams(window.location.search).get('module');
if (initialModuleParam) {
  selectCourseModule(initialModuleParam.padStart(2, '0'));
}

document.querySelector<HTMLElement>('[data-course-interactive]')!.hidden = false;
document.querySelector<HTMLElement>('[data-course-fallback]')!.hidden = true;
</script>
<style>
.syllabus-intro {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin-block: 48px;
}
