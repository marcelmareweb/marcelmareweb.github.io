  width: 100%;
  display: grid;
  grid-template-columns: 32px 1fr 24px;
  gap: 20px;
  align-items: start;
  text-align: left;
  padding: 28px 0;
  border: 0;
  border-bottom: 1px solid #555;
  background: transparent;
  color: #fff;
}
.course-tab > span:nth-child(2) {
  font-size: 32px;
  line-height: 1;
  letter-spacing: -0.045em;
  font-weight: 600;
}
.course-tab > .meta {
  color: #aaa;
}
.course-tab > span:last-child {
  font-size: 24px;
}
.course-tab[aria-selected='true'] {
  color: var(--signal);
}
.course-tab[aria-selected='true'] > .meta {
  color: var(--signal);
}
.course-tab:hover {
  background: #ffffff0a;
}
.course-panel {
  background: #fff;
  color: var(--ink);
  border-radius: 8px;
  padding: 40px;
  --text-primary: #0d0b0a;
  --text-muted: #626262;
  --border-subtle: #ddd;
}
