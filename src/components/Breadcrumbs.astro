---
import { breadcrumbsFor } from '../data/navigation';
const breadcrumbs = breadcrumbsFor(Astro.url.pathname);
---
{breadcrumbs.length > 0 && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>{breadcrumbs.map((item, index) => (
      <li>
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}</ol>
  </nav>
)}
<style>
  .breadcrumbs { margin-bottom: 28px; font-size: var(--text-label); line-height: var(--leading-copy); color: var(--muted); }
  ol { display: flex; flex-wrap: wrap; gap: 6px 12px; list-style: none; padding: 0; margin: 0; }
  li { display: inline-flex; align-items: baseline; gap: 12px; }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  [aria-current] { color: var(--ink); }
</style>
