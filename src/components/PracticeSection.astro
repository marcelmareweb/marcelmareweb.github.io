---
const capabilities = [
  {
    number: '01',
    href: '/services/#strategic-decision-design',
    action: 'Explore strategic decision support',
    lead: 'Strategic',
    lines: ['Decision', 'Design.'],
    image: 'decision',
    title: 'Strategic Decision Design.',
    summary: ['Resolve competing priorities.', 'Make the trade-offs explicit.'],
    question:
      'Which alternatives deserve comparison? What would have to be true, and what are we choosing to leave out?',
    output: 'A clearly framed decision, examined assumptions and explicit commitments.',
  },
  {
    number: '02',
    href: '/services/#behavioural-design',
    action: 'Explore behavioural design support',
    lead: 'Behavioural',
    lines: ['Design.'],
    image: 'behaviour',
    title: 'Behavioural Design.',
    summary: ['Begin with what people actually do.'],
    question:
      'Which incentives, barriers and working conditions prevent people from acting on an agreed decision?',
    output: 'Research and interventions grounded in the conditions of real work.',
  },
  {
    number: '03',
    href: '/services/#human-ai-decision-design',
    action: 'Explore Human–AI decision support',
    lead: 'Human–AI',
    lines: ['Decision', 'Design.'],
    image: 'human-ai',
    title: 'Human–AI Decision Design.',
    summary: ['Define where people decide,', 'review and remain accountable.'],
    question:
      'What may AI recommend or decide? Where can someone meaningfully challenge, authorise or stop an action?',
    output: 'Decision authority, review points and clear responsibility for consequences.',
  },
];
---

<section class="section-y practice-section" id="practice" data-practice-cards>
  <span id="work" aria-hidden="true"></span>
  <div class="wrap">
    <div class="section-top meta">
      <p>03 / The practice</p>
      <p>Choices. People. Consequences.</p>
    </div>
    <h2 class="section-title" data-reveal>Decide.<br />Make it happen.</h2>
  </div>

  <div class="practice-scene" data-practice-scene>
    <div class="practice-stage">
      <div class="wrap practice-frame">
        <p class="sr-only" id="practice-instructions">Scroll or swipe sideways through three areas of practice. Open Questions and outcomes for more detail.</p>
        <div class="practice-viewport" data-practice-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label="Areas of practice" aria-describedby="practice-instructions">
          <div class="practice-track" data-practice-track>
            {capabilities.map(item => (
              <article class="practice-card" data-practice-card aria-labelledby={`practice-title-${item.number}`}>
                <div class="practice-card-copy">
                  <p class="practice-index">{item.number} / The practice</p>
                  <h3 id={`practice-title-${item.number}`} aria-label={item.title}>
                    <span class="practice-title-lead">{item.lead}</span>
                    <span class="practice-title-rest">{item.lines.map(line => <span>{line}</span>)}</span>
                  </h3>
                  <p class="practice-summary">{item.summary.map(line => <span>{line}</span>)}</p>
                  <a class="practice-card-link" href={item.href}>{item.action} <span aria-hidden="true">↗</span></a>
                </div>
                <div class="practice-art" aria-hidden="true">
                  <img src={`/images/practice/${item.image}.svg`} alt="" width="600" height="600" loading="lazy" decoding="async" />
                </div>
                <details class="practice-notes">
                  <summary>Questions &amp; outcomes <span aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" focusable="false"><path d="M12 4v16M4 12h16" fill="none" stroke="currentColor" stroke-width="2.5" /></svg></span></summary>
                  <div class="practice-note-panel" tabindex="0" role="region" aria-label={`${item.title} Questions and outcomes`}>
                    <div>
                      <p class="practice-note-label">Questions worth asking</p>
                      <p>{item.question}</p>
                    </div>
                    <div>
                      <p class="practice-note-label">The work</p>
                      <p>{item.output}</p>
                    </div>
                  </div>
                </details>
              </article>
            ))}
          </div>
        </div>
        <div class="practice-controls" data-practice-controls hidden>
          <div class="practice-position">
            <p class="practice-count"><span data-practice-index>01</span> / 03</p>
            <p class="practice-scroll-hint" data-practice-hint>Scroll to explore</p>
          </div>
          <div class="practice-steps" aria-label="Choose an area of practice">
            {capabilities.map((item, index) => (
              <button type="button" data-practice-step={index} aria-label={`Show ${item.title}`} aria-current={index === 0 ? 'step' : undefined}>{item.number}</button>
            ))}
          </div>
          <div class="practice-arrows">
            <button type="button" data-practice-previous aria-label="Previous practice card"><span aria-hidden="true">←</span></button>
            <button type="button" data-practice-next aria-label="Next practice card"><span aria-hidden="true">→</span></button>
          </div>
          <p class="sr-only" data-practice-status role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="evidence-foot">
      <p class="lead">Strategic decisions, behavioural science<br />and human judgement. Working together.</p>
      <a class="text-link" href="/services/">Explore how we help <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  import '../scripts/practice-cards';
</script>

<style>
  .practice-card-link { display: inline-flex; gap: 12px; align-items: center; width: fit-content; min-height: 44px; flex-shrink: 0; margin-top: 12px; color: white; border-bottom: 1px solid #777; text-decoration: none; font-size: 16px; line-height: 1.3; }
  .practice-card-link:hover { border-color: var(--signal); }
  .practice-card-link > span { color: var(--signal); }
  @media (max-width: 1023px) { .practice-card-link { margin-top: 20px; } }

  .practice-section {
    --practice-card-height: clamp(520px, 39vw, 680px);
    --practice-stage-height: calc(100svh - var(--header-height) - 48px);
  }
  .practice-scene {
    margin-top: var(--space-lg);
  }
  .practice-viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--ink) #d9d9d9;
    border-radius: 20px;
  }
  .practice-viewport:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 8px;
  }
  .practice-track {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 24px;
  }
  .practice-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 0 0 100%;
    min-width: 0;
    min-height: var(--practice-card-height);
    padding: var(--space-sm);
    overflow: hidden;
    border-radius: 20px;
    background: #0d0b0a;
    color: white;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .practice-card-copy {
    display: flex;
    flex-direction: column;
    width: 54%;
    min-width: 0;
  }
  .practice-index {
    color: var(--signal);
    font: 11px/1.4 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .practice-card h3 {
    margin-top: 24px;
    font-size: var(--heading-2);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }
  .practice-title-lead,
  .practice-title-rest,
  .practice-title-rest > span {
    display: block;
  }
  .practice-title-rest {
    color: #b3b3b3;
    margin-top: 12px;
  }
  .practice-summary {
    max-width: 36ch;
    margin-top: auto;
    padding-top: 40px;
    font-size: var(--body-large);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .practice-summary > span {
    display: block;
  }
  .practice-art {
    position: absolute;
    top: 28px;
    right: 32px;
    bottom: 76px;
    width: 41%;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity 0.3s var(--out);
  }
  .practice-art img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    transition: transform 0.6s var(--out);
  }
  .practice-card:hover .practice-art img {
    transform: translateY(-6px) rotate(2deg);
  }
  .practice-card:has(.practice-notes[open]) .practice-art {
    opacity: 0;
  }
  .practice-notes > summary {
    position: absolute;
    z-index: 2;
    right: var(--space-sm);
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 44px;
    padding: 6px 0 6px 12px;
    list-style: none;
    color: white;
    font-size: 14px;
    line-height: 1.2;
  }
  .practice-notes > summary::-webkit-details-marker {
    display: none;
  }
  .practice-notes > summary > span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border: 1px solid #777;
    border-radius: 50%;
    transition:
      transform 0.3s var(--out),
      background-color 0.3s var(--out),
      color 0.3s var(--out);
  }
  .practice-notes > summary > span > svg {
    display: block;
    width: 18px;
    height: 18px;
  }
  .practice-notes > summary:hover > span,
  .practice-notes > summary:focus-visible > span {
    background: var(--signal);
    color: var(--ink);
    border-color: var(--signal);
  }
  .practice-notes[open] > summary > span {
    transform: rotate(45deg);
    background: var(--signal);
    color: var(--ink);
    border-color: var(--signal);
  }
  .practice-note-panel {
    position: absolute;
    z-index: 1;
    inset: var(--space-sm) var(--space-sm) 112px auto;
    width: 36%;
    overflow-y: auto;
    padding: 4px 10px 12px 0;
    scrollbar-width: thin;
    scrollbar-color: #777 #0d0b0a;
  }
  .practice-note-panel > div + div {
    margin-top: 32px;
  }
  .practice-note-label {
    margin-bottom: 14px;
    color: var(--signal);
    font: 11px/1.5 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .practice-note-panel p:not(.practice-note-label) {
    margin: 0;
    font-size: var(--body);
    line-height: 1.45;
    letter-spacing: -0.015em;
  }
  .practice-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 24px;
  }
  .practice-position {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .practice-count {
    font: 12px/1.4 var(--mono);
  }
  .practice-count > span {
    font-weight: 600;
  }
  .practice-scroll-hint {
    margin: 0;
    font-size: 14px;
    color: #626262;
  }
  .practice-steps {
    display: flex;
    gap: 12px;
  }
  .practice-steps button {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-bottom: 2px solid #d9d9d9;
    font: 12px/1 var(--mono);
  }
  .practice-steps button[aria-current='step'] {
    border-color: var(--ink);
    background: var(--signal);
  }
  .practice-arrows {
    display: flex;
    gap: 12px;
  }
  .practice-arrows button {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid #aaa;
    border-radius: 50%;
    font-size: 24px;
    line-height: 1;
    transition: background-color 0.3s var(--out);
  }
  .practice-arrows button:hover:not(:disabled) {
    background: var(--signal);
    border-color: var(--signal);
  }
  .practice-arrows button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  [data-mode='pinned'] .practice-scene {
    height: calc(var(--practice-stage-height) + var(--practice-travel));
  }
  [data-mode='pinned'] .practice-stage {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    height: var(--practice-stage-height);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  [data-mode='pinned'] .practice-viewport {
    overflow: hidden;
    scroll-snap-type: none;
  }
  [data-mode='pinned'] .practice-track {
    will-change: transform;
  }
  [data-mode='pinned'] .practice-card {
    height: var(--practice-card-height);
  }
  [data-mode='native'] .practice-viewport {
    scrollbar-width: none;
  }
  @media (max-width: 1199px) and (min-width: 1024px) {
    .practice-card {
      padding: 40px;
    }
    .practice-card h3 {
      font-size: 62px;
    }
    .practice-summary {
      font-size: 23px;
    }
    .practice-note-panel {
      inset: 40px 40px 108px auto;
      width: 35%;
    }
    .practice-note-panel p:not(.practice-note-label) {
      font-size: 17px;
    }
    .practice-notes > summary {
      right: 40px;
    }
  }
  @media (max-width: 1023px) {
    .practice-scene {
      margin-top: 48px;
    }
    .practice-card {
      padding: 32px;
      min-height: 640px;
      flex-direction: column;
    }
    .practice-card-copy {
      display: contents;
    }
    .practice-index {
      margin-top: 16px;
    }
    .practice-card h3 {
      margin-top: 16px;
      font-size: 52px;
    }
    .practice-summary {
      max-width: 34ch;
      margin-top: 24px;
      padding-top: 0;
      font-size: 24px;
    }
    .practice-art {
      position: relative;
      inset: auto;
      order: -1;
      flex-shrink: 0;
      width: 100%;
      height: 240px;
      margin-bottom: 16px;
    }
    .practice-card:hover .practice-art img {
      transform: none;
    }
    .practice-card:has(.practice-notes[open]) .practice-art {
      opacity: 1;
    }
    .practice-notes {
      margin-top: auto;
      padding-top: 24px;
    }
    .practice-notes > summary {
      position: static;
      justify-content: space-between;
      padding-left: 0;
    }
    .practice-note-panel {
      position: static;
      width: auto;
      max-height: none;
      overflow: visible;
      margin-top: 24px;
      padding: 24px 0 0;
      border-top: 1px solid #555;
    }
    .practice-note-panel p:not(.practice-note-label) {
      font-size: 18px;
    }
    .practice-position {
      gap: 16px;
    }
    .practice-scroll-hint {
      display: none;
    }
    .practice-controls {
      gap: 16px;
    }
  }
  @media (max-width: 767px) {
    .practice-card {
      min-height: 0;
      padding: 28px 24px 24px;
    }
    .practice-track {
      gap: 16px;
    }
    .practice-card h3 {
      font-size: clamp(34px, 10.25vw, 48px);
      line-height: 0.96;
      letter-spacing: -0.045em;
    }
    .practice-title-rest {
      margin-top: 8px;
    }
    .practice-art {
      height: clamp(190px, 60vw, 240px);
      margin-bottom: 12px;
    }
    .practice-index {
      margin-top: 0;
    }
    .practice-summary {
      font-size: 21px;
      line-height: 1.18;
    }
    .practice-notes > summary {
      font-size: 13px;
    }
    .practice-note-panel p:not(.practice-note-label) {
      font-size: 16px;
    }
    .practice-note-panel > div + div {
      margin-top: 24px;
    }
    .practice-steps {
      gap: 4px;
    }
    .practice-steps button {
      width: 44px;
    }
    .practice-position {
      display: none;
    }
    .practice-arrows {
      gap: 8px;
    }
    .practice-arrows button {
      width: 44px;
      height: 44px;
    }
    .practice-controls {
      gap: 8px;
      margin-top: 20px;
    }
    .practice-position {
      gap: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .practice-viewport {
      overflow: visible;
      scroll-snap-type: none;
    }
    .practice-track {
      display: grid;
      gap: 24px;
      transform: none !important;
    }
    .practice-card {
      min-width: 0;
    }
    .practice-art img {
      transform: none !important;
    }
  }
</style>
