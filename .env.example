# The Spotted Ape — Static Inquiry Form Configuration
# By default, the form submits directly via AJAX POST to https://formsubmit.co/ajax/hello@thespottedape.com (zero API key required).
# Optional overrides if you prefer Web3Forms or Formspree:

# Option 1 (Optional): Web3Forms Access Key (https://web3forms.com — tied to hello@thespottedape.com)
PUBLIC_WEB3FORMS_KEY=

# Option 2 (Optional): Custom JSON POST Endpoint (e.g. Formspree https://formspree.io/f/your_form_id)
PUBLIC_INQUIRY_ENDPOINT=
