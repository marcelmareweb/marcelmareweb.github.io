# The Spotted Ape — Static Inquiry Form Configuration
# Copy this file to `.env` for local development.
# In production (GitHub Pages), set either variable under Repository Settings -> Secrets and variables -> Actions.

# Option 1 (Recommended): Web3Forms Access Key (https://web3forms.com — tied to hello@thespottedape.com)
PUBLIC_WEB3FORMS_KEY=

# Option 2 (Alternative): Custom JSON POST Endpoint (e.g. Formspree https://formspree.io/f/your_form_id)
PUBLIC_INQUIRY_ENDPOINT=

# Option 1 (Recommended): Web3Forms Access Key (https://web3forms.com — tied to contact@spottedape.com)
PUBLIC_WEB3FORMS_KEY=

# Option 2 (Alternative): Custom JSON POST Endpoint (e.g. Formspree https://formspree.io/f/your_form_id)
PUBLIC_INQUIRY_ENDPOINT=

